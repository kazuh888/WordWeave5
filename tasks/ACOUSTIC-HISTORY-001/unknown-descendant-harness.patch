+    ExitSetting, CompletedWrite, TreeDelegated,
+}
+
+fn encode_target_failure(pid: u32, stage: TargetFailureStage, error: &io::Error) -> Vec<u8> {
+    let message = error.to_string();
+    let allowlisted = [
+        "invalid fixture integer", "invalid fixture environment", "fixture integer out of range",
+        "ET3_FAKE_ROOT required", "fixture root outside ignored boundary", "fixture owner marker mismatch",
+        "invalid fixture release name", "release must be one plain file name", "fixture release timeout",
+        "short argv fixture", "too many fixture args", "fixture arg too long", "argv length overflow",
+        "short UTF16 fixture", "NUL cannot be a Windows argv unit", "trailing argv fixture bytes",
+        "missing exact name", "runner missing", "unexpected runner path",
+        "fixture Cargo deadline; supervisor must audit descendants", "runner exit unavailable",
+        "fixture tree deadline", "fixture child wait incomplete", "unknown fixture mode",
+    ].contains(&message.as_str()) || error.raw_os_error()
+        .is_some_and(|code| io::Error::from_raw_os_error(code).to_string() == message);
+    let message_units: Vec<u16> = message.encode_utf16().collect();
+    let (message_utf16, message_status) = if !allowlisted {
+        ("null".to_owned(), "NotAllowlisted")
+    } else if message_units.len() > 2048 {
+        ("null".to_owned(), "TooLong")
+    } else {
+        (format!("[{}]", message_units.iter().map(|unit| unit.to_string()).collect::<Vec<_>>().join(",")), "Captured")
+    };
+    let raw_os_error = error.raw_os_error().map(|code| code.to_string()).unwrap_or_else(|| "null".into());
+    let serialize = |message_utf16: &str, message_status: &str| {
+        format!("{{\"schemaVersion\":1,\"pid\":{pid},\"stage\":\"{stage:?}\",\"errorKind\":\"{:?}\",\"rawOsError\":{raw_os_error},\"messageUtf16\":{message_utf16},\"messageStatus\":\"{message_status}\"}}", error.kind()).into_bytes()
+    };
+    let mut bytes = serialize(&message_utf16, message_status);
+    if bytes.len() > 8192 {
+        bytes = serialize("null", "TooLong");
+    }
+    bytes
+}
+
+fn try_write_target_failure(root: &Path, pid: u32, stage: TargetFailureStage, error: &io::Error,
+    write_once: impl FnOnce(&Path, &[u8]) -> io::Result<()>) -> io::Result<()> {
+    let bytes = encode_target_failure(pid, stage, error);
+    write_once(&root.join(format!("target-{pid}.failure.json")), &bytes)
+}
