+        & $record 'frozen-inputs.json' 'FrozenInputs' $frozen
+        $null = & $hash $Inputs.fakePath $result.fakeSha256 $workDeadline 'Generated.Drift'
+    }
+    catch {
+        if ($null -eq $result.primaryError) { & $remember $_ }
+        elseif (-not [object]::ReferenceEquals($result.primaryError, $_) -and
+            -not [object]::ReferenceEquals($result.primaryError.Exception, $_.Exception)) { & $remember $_ }
+    }
+    $control.inWork = $false
+    if ($null -ne $control.handle -and -not $control.released) {
+        try {
+            $recoveryDeadline = [Math]::Min((& $now) + 3 * $Inputs.frequency, $totalDeadline - 2 * $Inputs.frequency)
+            if (-not $control.exited) {
+                $null = & $invoke 'Stop' @($control.handle) $recoveryDeadline
+            }
+            while (-not $control.released) {
+                $null = & $poll $recoveryDeadline
+                if (-not $control.released) { & $pause $recoveryDeadline }
+            }
+            $control.recovered = $true
+            $result.directRecovery = 'Recovered'
+        }
+        catch {
+            & $remember $_
+            $control.unknown = $true
+            $result.directRecovery = 'Unknown'
+        }
+    }
+    if ($control.unknown) { $result.state = 'RecoveryUnknown' }
+    elseif ($control.evidenceFailed) { $result.state = 'EvidenceFailed' }
+    elseif ($null -eq $result.primaryError) { $result.state = 'AwaitingApproval' }
+    if ($control.saveAllowed) {
+        try {
+            $projectError = {
+                param($failure)
+                if ($null -eq $failure) { return $null }
+                return @{ type = $failure.Exception.GetType().FullName
+                    fullyQualifiedErrorId = $failure.FullyQualifiedErrorId; hResult = $failure.Exception.HResult }
+            }
+            $snapshot = $result.Clone()
+            $snapshot.primaryError = & $projectError $result.primaryError
+            $snapshot.secondaryErrors = @(foreach ($failure in $result.secondaryErrors) { & $projectError $failure })
+            $payload = @{ schemaVersion = 1; manifestSha256 = $Inputs.manifestSha256
+                startedTick = $Inputs.startedTick; frequency = $Inputs.frequency
+                limitsMs = @{ total = 40000; work = 35000; version = 2000; compile = 25000; recovery = 3000; save = 2000 }
+                phases = $control.phases; result = $snapshot }
+            & $record 'preparation.json' 'Preparation' $payload
+        }
+        catch {
+            & $remember $_
+            $control.evidenceFailed = $true
+        }
+    }
+    if ($control.unknown) { $result.state = 'RecoveryUnknown' }
+    elseif ($control.evidenceFailed) { $result.state = 'EvidenceFailed' }
+    elseif ($null -ne $result.primaryError) { $result.state = 'Failed' }
+    return $result
+}
