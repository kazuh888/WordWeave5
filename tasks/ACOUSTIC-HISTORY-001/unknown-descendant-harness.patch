+        & $runPhase 'Compile' 25 @('--edition=2021', $Inputs.sourcePath, '-o', $Inputs.fakePath) 'fake-build'
+        & $checkDependencies
+        $null = & $pathState $Inputs.fakePath 'File' $workDeadline
+        $result.fakeSha256 = & $hash $Inputs.fakePath $null $workDeadline
+        $frozen = $Inputs.fixed.Clone()
+        $frozen.Add($Inputs.fakePath, $result.fakeSha256)
+        $toolchain = @{ rustc = $manifest.tools.rustc; version = $control.version
+            rustcSha256 = $dependencyHashes[$manifest.tools.rustc]; pwsh = $manifest.tools.pwsh
