+        $created = & $invoke 'Save' @('CreateTemp', @{ path = $temp }) $workDeadline
+        & $shape $created @('path', 'status', 'sha256', 'length')
+        $result.evidence += ,(@{ kind = 'Temp'; path = $created.path; status = $created.status
+            sha256 = $created.sha256; length = $created.length })
+        if ($created.path -cne $temp -or $created.status -cne 'Created' -or
