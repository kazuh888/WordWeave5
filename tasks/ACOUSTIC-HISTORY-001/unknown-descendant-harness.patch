+++ b/target/early-trial-build/et3/cargo-gate/verification/argv-path01/05685244-e82d-4a76-8be8-4366a8872b6d/pssa-capture/Invoke-PssaCapture.ps1
@@ -0,0 +1,747 @@
+﻿<#
+.SYNOPSIS
+    Capture bounded PSScriptAnalyzer observations without losing an emitted prefix.
+.DESCRIPTION
+    Private CAP collector. Stop and the analyzer's default rules and severities are preserved.
+    A saved candidate does not prove final acceptance; the final clock and actual exit also apply.
+.PARAMETER BindingPath
+    Absolute path of the independently frozen capture binding.
+.PARAMETER TargetRole
+    Bound static input role: Collector or Assertions.
+.PARAMETER CollectionStartTick
+    Shared monotonic start tick for both analyzer inputs, never reset between roles.
+.PARAMETER OutputRoot
+    Bound, previously absent output leaf. Existing artifacts are never overwritten.
+.EXAMPLE
+    ./Invoke-PssaCapture.ps1 -BindingPath /bound/capture.json -TargetRole Collector -CollectionStartTick 1 -OutputRoot /bound/new
+.NOTES
+    Target: PowerShell 7.6.7 (ps7), PSScriptAnalyzer 1.25.0. Exit 0 accepted, otherwise 2.
+#>
+#Requires -Version 7.6
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$BindingPath,
+    [Parameter(Mandatory)][ValidateSet('Collector', 'Assertions')][string]$TargetRole,
+    [Parameter(Mandatory)][long]$CollectionStartTick,
+    [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$OutputRoot
+)
+
+Set-StrictMode -Version 3.0
+$ErrorActionPreference = 'Stop'
+
+function Add-PssaCaptureRecord {
+    <#
+    .SYNOPSIS
+        Retain one typed observation and reference-only links, without pipeline output.
+    .DESCRIPTION
+        Projection and limits fail closed while retaining the existing prefix and original references.
+    .PARAMETER State
+        Private mutable capture state.
+    .PARAMETER Origin
+        Observation route, not a claim of engine occurrence order.
+    .PARAMETER Record
+        Original observed object, including null.
+    .EXAMPLE
+        Add-PssaCaptureRecord -State $state -Origin Pipeline -Record $record
+    .NOTES
+        Target: ps7. No filesystem or analyzer calls.
+    #>
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][hashtable]$State,
+        [Parameter(Mandatory)][ValidateSet('Pipeline', 'ErrorVariable', 'Catch', 'Import', 'Capture', 'Save')]
+        [string]$Origin,
+        [Parameter(Mandatory)][AllowNull()][object]$Record
+    )
+
+    if ($State.captureBroken -or $State.overflow -or $State.truncation) { return }
+    $typeName = if ($null -eq $Record) { 'null' } else { $Record.GetType().FullName }
+    if ($Record -is [Management.Automation.ErrorRecord]) {
+        if ($null -eq $State.primaryError) { $State.primaryError = $Record }
+        elseif (-not [object]::ReferenceEquals($State.primaryError, $Record)) {
+            $alreadyHeld = $false
+            foreach ($held in $State.secondaryErrors) {
+                if ([object]::ReferenceEquals($held, $Record)) { $alreadyHeld = $true }
+            }
+            if (-not $alreadyHeld) { $State.secondaryErrors.Add($Record) }
+        }
+    }
+    if ($State.records.Count -ge 256) {
+        $State.overflow = $true
+        $State.captureBroken = $true
+        $State.missing.Add("Occurrence limit: next type=$typeName; remaining observations unavailable")
+        throw [InvalidOperationException]::new('CAP occurrence limit reached')
+    }
+
+    # Failed projection references remain available even though there is no invented raw snapshot.
+    $State.recordRefs.Add($Record)
+    try {
+        $tick = [long](& $State.now)
+        if ($State.frequency -le 0 -or $tick -lt $State.inputStartTick -or
+            $tick -lt $State.collectionStartTick -or
+            (($tick - $State.inputStartTick) / [double]$State.frequency) -ge 9 -or
+            (($tick - $State.collectionStartTick) / [double]$State.frequency) -ge 30) {
+            throw [TimeoutException]::new('CAP work or collection deadline reached while receiving a record')
+        }
+        $fields = @{}
+        $kind = 'Unknown'
+        $read = {
+            param([object]$Value, [string]$Name)
+            if ($null -eq $Value) { return $null }
+            $property = $Value.PSObject.Properties[$Name]
+            if ($null -eq $property) { return $null }
+            return $property.Value
+        }
+        if ($Record -is [Management.Automation.ErrorRecord]) {
+            $kind = 'Engine'
+            $exception = $Record.Exception
+            $inner = $exception.InnerException
+            $fields = @{
+                exceptionType = $exception.GetType().FullName
+                hResult = $exception.HResult
+                fullyQualifiedErrorId = $Record.FullyQualifiedErrorId
+                category = $Record.CategoryInfo.ToString()
+                message = $exception.Message
+                exceptionStack = $exception.StackTrace
+                scriptStack = $Record.ScriptStackTrace
+                position = $(if ($null -eq $Record.InvocationInfo) { $null } else { $Record.InvocationInfo.PositionMessage })
+                innerType = $(if ($null -eq $inner) { $null } else { $inner.GetType().FullName })
+                innerHResult = $(if ($null -eq $inner) { $null } else { $inner.HResult })
+            }
+        }
+        else {
+            $diagnosticType = 'Microsoft.Windows.PowerShell.ScriptAnalyzer.Generic.DiagnosticRecord' -as [type]
+            if ($null -eq $diagnosticType) { throw [TypeLoadException]::new('CAP PSSA DiagnosticRecord type unavailable') }
+            if ($null -ne $Record -and $diagnosticType.IsInstanceOfType($Record)) {
+                $kind = 'Diagnostic'
+                foreach ($name in @('RuleName', 'Severity', 'Message', 'ScriptPath')) {
+                    $value = & $read $Record $name
+                    $fields[$name] = if ($null -eq $value) { $null } else { [string]$value }
+                }
+                $extent = & $read $Record 'Extent'
+                foreach ($pair in @(@('StartLine', 'StartLineNumber'), @('StartColumn', 'StartColumnNumber'),
+                    @('EndLine', 'EndLineNumber'), @('EndColumn', 'EndColumnNumber'))) {
+                    $fields[$pair[0]] = & $read $extent $pair[1]
+                }
+            }
+            else {
+                if ($Record -is [Management.Automation.VerboseRecord] -or
+                    $Record -is [Management.Automation.DebugRecord] -or
+                    $Record -is [Management.Automation.InformationRecord]) { $kind = 'Auxiliary' }
+                elseif ($Record -is [Management.Automation.WarningRecord]) { $kind = 'Signal' }
+                $fields.text = if ($null -eq $Record) { $null } else { $Record.ToString() }
+            }
+        }
+        foreach ($value in $fields.Values) {
+            if ($value -is [string] -and $value.Length -gt 8192) {
+                $State.truncation = $true
+                throw [InvalidOperationException]::new('CAP scalar string exceeds 8192 UTF-16 units')
+            }
+        }
+
+        $seq = [int]($State.records.Count + 1)
+        $newLinks = [Collections.Generic.List[hashtable]]::new()
+        if ($kind -ceq 'Engine') {
+            foreach ($previous in $State.records) {
+                if ($previous.kind -cne 'Engine') { continue }
+                $old = $State.recordRefs[$previous.seq - 1]
+                $relation = $null
+                if ([object]::ReferenceEquals($old, $Record)) { $relation = 'SameRecord' }
+                elseif ([object]::ReferenceEquals($old.Exception, $Record.Exception)) { $relation = 'SameException' }
+                elseif (($Record.Exception -is [Management.Automation.ActionPreferenceStopException] -and
+                        [object]::ReferenceEquals($Record.Exception.ErrorRecord, $old)) -or
+                    ($old.Exception -is [Management.Automation.ActionPreferenceStopException] -and
+                        [object]::ReferenceEquals($old.Exception.ErrorRecord, $Record))) { $relation = 'StopWrapperRecord' }
+                if ($null -ne $relation) {
+                    $newLinks.Add(@{ fromSeq = $seq; toSeq = [int]$previous.seq; relation = $relation })
+                }
+            }
+        }
+        $snapshot = @{ seq = $seq; origin = $Origin; type = $typeName; kind = $kind; fields = $fields }
+        $proposed = @{
+            schemaVersion = 1; targetPath = $State.targetPath
+            records = @($State.records.ToArray()) + @($snapshot)
+            links = @($State.links.ToArray()) + @($newLinks.ToArray())
+            overflow = $false; truncation = $false; missing = @()
+        }
+        $size = [Text.Encoding]::UTF8.GetByteCount(($proposed | ConvertTo-Json -Depth 12 -Compress))
+        if ($size -gt 2MB) {
+            $State.overflow = $true
+            throw [InvalidOperationException]::new('CAP raw snapshot exceeds 2 MiB')
+        }
+        $State.records.Add($snapshot)
+        foreach ($link in $newLinks) { $State.links.Add($link) }
+        $State.rawBytes = [long]$size
+        switch -CaseSensitive ($kind) {
+            'Diagnostic' { $State.counts.ordinary++ }
+            'Engine' { $State.counts.engineOccurrences++ }
+            'Unknown' { $State.counts.unknown++ }
+            'Signal' { $State.counts.signal++ }
+            'Auxiliary' { $State.counts.auxiliary++ }
+        }
+        # Count connected reference groups; transitive links may join previously separate groups.
+        $parents = @{}
+        foreach ($entry in $State.records) {
+            if ($entry.kind -ceq 'Engine') { $parents[$entry.seq] = $entry.seq }
+        }
+        foreach ($link in $State.links) {
+            $left = $link.fromSeq
+            $right = $link.toSeq
+            while ($parents[$left] -ne $left) { $left = $parents[$left] }
+            while ($parents[$right] -ne $right) { $right = $parents[$right] }
+            if ($left -ne $right) { $parents[$left] = $right }
+        }
+        $groups = 0
+        foreach ($key in $parents.Keys) { if ($parents[$key] -eq $key) { $groups++ } }
+        $State.counts.engineGroups = [int]$groups
+    }
+    catch {
+        $State.captureBroken = $true
+        $State.flags.captureComplete = $false
+        $State.missing.Add("Projection/limit/deadline failure at next seq=$($State.records.Count + 1), type=$typeName")
+        if ($null -eq $State.primaryError) { $State.primaryError = $_ }
+        else { $State.secondaryErrors.Add($_) }
+        throw
+    }
+}
+
+function Invoke-PssaCapturePipeline {
+    <#
+    .SYNOPSIS
+        Stream the producer before collecting ErrorVariable and caught observations.
+    .DESCRIPTION
+        Keep ErrorVariable in this caller scope and preserve Stop on the actual producer boundary.
+    .PARAMETER State
+        Private mutable capture state.
+    .PARAMETER Producer
+        Advanced scriptblock with exactly one Context argument.
+    .PARAMETER Context
+        Producer's bound context.
+    .EXAMPLE
+        Invoke-PssaCapturePipeline -State $state -Producer $producer -Context $context
+    .NOTES
+        Target: ps7. No closure or separate execution scope wraps the pipeline.
+    #>
+    [CmdletBinding()]
+    param([Parameter(Mandatory)][hashtable]$State,
+        [Parameter(Mandatory)][scriptblock]$Producer,
+        [Parameter(Mandatory)][hashtable]$Context)
+
+    $engineRaw = @()
+    $caught = $null
+    try {
+        $State.flags.invokeStarted = $true
+        & $producer -Context $context -ErrorAction Stop -ErrorVariable +engineRaw *>&1 |
+            ForEach-Object { $null = Add-PssaCaptureRecord -State $State -Origin Pipeline -Record $_ }
+        $State.flags.invokeReturned = $true
+    }
+    catch { $caught = $_ }
+    finally {
+        try {
+            foreach ($entry in $engineRaw) {
+                $null = Add-PssaCaptureRecord -State $State -Origin ErrorVariable -Record $entry
+            }
+            if ($null -ne $caught) { $null = Add-PssaCaptureRecord -State $State -Origin Catch -Record $caught }
+        }
+        catch {
+            $State.captureBroken = $true
+            $State.missing.Add('ErrorVariable/catch recovery incomplete')
+            if ($null -eq $State.primaryError) { $State.primaryError = $_ }
+            else { $State.secondaryErrors.Add($_) }
+        }
+        if (-not $State.captureBroken -and -not $State.overflow -and -not $State.truncation) {
+            $State.flags.captureComplete = $true
+        }
+    }
+}
+
+function Complete-PssaCapture {
+    <#
+    .SYNOPSIS
+        Seal bounded snapshots once and decide after the final save clock observation.
+    .DESCRIPTION
+        Save raw then result through the supplied CreateNew sink, preserving partial files on failure.
+    .PARAMETER State
+        Private mutable capture state, finalized once.
+    .PARAMETER Flags
+        The exact state.flags reference.
+    .PARAMETER Now
+        The exact state.now monotonic clock reference.
+    .PARAMETER Save
+        CreateNew sink taking absolute path and bytes and returning path, hash and length.
+    .EXAMPLE
+        Complete-PssaCapture -State $state -Flags $state.flags -Now $state.now -Save $save
+    .NOTES
+        Target: ps7. The saved gateCandidate alone never proves acceptance.
+    #>
+    [CmdletBinding()]
+    param([Parameter(Mandatory)][hashtable]$State,
+        [Parameter(Mandatory)][hashtable]$Flags,
+        [Parameter(Mandatory)][scriptblock]$Now,
+        [Parameter(Mandatory)][scriptblock]$Save)
+
+    if ($State.finalized) { throw [InvalidOperationException]::new('CAP already finalized') }
+    $State.finalized = $true
+    if (-not [object]::ReferenceEquals($Flags, $State.flags) -or
+        -not [object]::ReferenceEquals($Now, $State.now)) {
+        throw [InvalidOperationException]::new('CAP flags/clock binding mismatch')
+    }
+    $Flags.savedWithinDeadline = $false
+    $within = {
+        param([long]$Tick)
+        return $State.frequency -gt 0 -and $Tick -ge $State.inputStartTick -and
+            $Tick -ge $State.collectionStartTick -and
+            (($Tick - $State.inputStartTick) / [double]$State.frequency) -lt 10 -and
+            (($Tick - $State.collectionStartTick) / [double]$State.frequency) -lt 30
+    }
+    $projectError = {
+        param([Management.Automation.ErrorRecord]$ErrorRecord)
+        if ($null -eq $ErrorRecord) { return $null }
+        $exception = $ErrorRecord.Exception
+        $inner = $exception.InnerException
+        $projection = @{
+            exceptionType = $exception.GetType().FullName; hResult = $exception.HResult
+            fullyQualifiedErrorId = $ErrorRecord.FullyQualifiedErrorId; category = $ErrorRecord.CategoryInfo.ToString()
+            message = $exception.Message; exceptionStack = $exception.StackTrace; scriptStack = $ErrorRecord.ScriptStackTrace
+            position = $(if ($null -eq $ErrorRecord.InvocationInfo) { $null } else { $ErrorRecord.InvocationInfo.PositionMessage })
+            innerType = $(if ($null -eq $inner) { $null } else { $inner.GetType().FullName })
+            innerHResult = $(if ($null -eq $inner) { $null } else { $inner.HResult })
+        }
+        foreach ($key in @($projection.Keys)) {
+            if ($projection[$key] -is [string] -and $projection[$key].Length -gt 8192) {
+                $State.truncation = $true
+                $State.missing.Add('Error summary scalar truncated to 8192 UTF-16 units')
+                $projection[$key] = $projection[$key].Substring(0, 8192)
+            }
+        }
+        return $projection
+    }
+    $saved = $false
+    try {
+        $tick = [long](& $Now)
+        if (-not (& $within $tick)) {
+            $State.missing.Add('Input/collection deadline reached before saving; no new save')
+        }
+        else {
+            if ((($tick - $State.inputStartTick) / [double]$State.frequency) -ge 9) {
+                $State.missing.Add('Work reserve boundary reached before saving')
+            }
+            $raw = @{
+                schemaVersion = 1; targetPath = $State.targetPath; records = $State.records.ToArray()
+                links = $State.links.ToArray(); overflow = $State.overflow; truncation = $State.truncation
+                missing = $State.missing.ToArray()
+            }
+            $rawBytes = [Text.Encoding]::UTF8.GetBytes(($raw | ConvertTo-Json -Depth 12 -Compress))
+            if ($rawBytes.LongLength -gt (2MB + 64KB)) {
+                throw [InvalidOperationException]::new('CAP raw plus failure reserve exceeded')
+            }
+            $rawFile = $null
+            foreach ($kind in @('Raw', 'Result')) {
+                if (-not (& $within ([long](& $Now)))) {
+                    $State.missing.Add("Deadline reached before $kind save; remaining save unavailable")
+                    break
+                }
+                $path = [IO.Path]::Combine($State.outputRoot, $kind.ToLowerInvariant() + '.json')
+                if ($kind -ceq 'Raw') { $bytes = $rawBytes }
+                else {
+                    $primary = & $projectError $State.primaryError
+                    $secondary = [Collections.Generic.List[object]]::new()
+                    foreach ($errorRecord in $State.secondaryErrors) { $secondary.Add((& $projectError $errorRecord)) }
+                    $candidate = $Flags.moduleReady -and $Flags.invokeStarted -and $Flags.invokeReturned -and
+                        $Flags.captureComplete -and $Flags.postBindingsMatched -and -not $State.captureBroken -and
+                        -not $State.overflow -and -not $State.truncation -and $State.missing.Count -eq 0 -and
+                        $State.counts.ordinary -eq 0 -and $State.counts.engineOccurrences -eq 0 -and
+                        $State.counts.unknown -eq 0 -and $State.counts.signal -eq 0
+                    $document = @{
+                        schemaVersion = 1; targetPath = $State.targetPath; gateCandidate = $candidate
+                        flags = $Flags.Clone(); counts = $State.counts.Clone(); rawFile = $rawFile
+                        links = $State.links.ToArray(); primaryError = $primary
+                        secondaryErrors = $secondary.ToArray(); missing = $State.missing.ToArray()
+                    }
+                    $bytes = [Text.Encoding]::UTF8.GetBytes(($document | ConvertTo-Json -Depth 12 -Compress))
+                    if ($bytes.LongLength -gt (2MB + 64KB)) {
+                        throw [InvalidOperationException]::new('CAP result plus failure reserve exceeded')
+                    }
+                }
+                $artifact = @{ kind = $kind; path = $path; sha256 = $null; length = $null; status = 'Incomplete' }
+                $State.artifacts.Add($artifact)
+                $receipt = & $Save $path $bytes
+                $hash = [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData([byte[]]$bytes))
+                if ($receipt -isnot [hashtable] -or $receipt.path -cne $path -or
+                    $receipt.sha256 -cne $hash -or $receipt.length -isnot [long] -or
+                    $receipt.length -ne $bytes.LongLength) {
+                    throw [InvalidOperationException]::new('CAP save receipt mismatch')
+                }
+                $artifact.sha256 = $receipt.sha256
+                $artifact.length = $receipt.length
+                $artifact.status = 'Saved'
+                if ($kind -ceq 'Raw') {
+                    $rawFile = @{ path = $receipt.path; sha256 = $receipt.sha256; length = $receipt.length }
+                }
+                if (-not (& $within ([long](& $Now)))) {
+                    $State.missing.Add("Deadline reached after $kind save")
+                    break
+                }
+                if ($kind -ceq 'Result') { $saved = $true }
+            }
+        }
+        $Flags.savedWithinDeadline = $saved -and (& $within ([long](& $Now)))
+    }
+    catch {
+        # The first observed engine error stays primary even when a partial CreateNew write fails.
+        if ($null -eq $State.primaryError) { $State.primaryError = $_ }
+        else { $State.secondaryErrors.Add($_) }
+        $State.missing.Add('Capture finalization/save failed; partial files preserved and no retry')
+        $Flags.savedWithinDeadline = $false
+    }
+    $complete = $Flags.moduleReady -and $Flags.invokeStarted -and $Flags.invokeReturned -and $Flags.captureComplete
+    $pass = $complete -and $Flags.postBindingsMatched -and $Flags.savedWithinDeadline -and
+        -not $State.captureBroken -and -not $State.overflow -and -not $State.truncation -and
+        $State.missing.Count -eq 0 -and $State.counts.ordinary -eq 0 -and $State.counts.engineOccurrences -eq 0 -and
+        $State.counts.unknown -eq 0 -and $State.counts.signal -eq 0 -and $null -eq $State.primaryError
+    return @{
+        captureStatus = $(if ($complete) { 'Complete' } else { 'Incomplete' })
+        gateStatus = $(if ($pass) { 'PASS' } else { 'FAIL' })
+        flags = $Flags.Clone(); counts = $State.counts.Clone(); rawRecords = [object[]]$State.records.ToArray()
+        links = [object[]]$State.links.ToArray(); primaryError = $State.primaryError
+        secondaryErrors = [Management.Automation.ErrorRecord[]]$State.secondaryErrors.ToArray()
+        overflow = [bool]$State.overflow; truncation = [bool]$State.truncation
+        missing = [string[]]$State.missing.ToArray(); artifacts = [object[]]$State.artifacts.ToArray()
+    }
+}
+
+# The unique seed is extracted verbatim for independent memory fixtures.
+$inputStartTick = [Diagnostics.Stopwatch]::GetTimestamp()
+$frequency = [long][Diagnostics.Stopwatch]::Frequency
+$targetPath = ''
+$now = { return [long][Diagnostics.Stopwatch]::GetTimestamp() }
+$state = @{
+    targetPath = [string]$targetPath; outputRoot = [string]$OutputRoot
+    frequency = [long]$frequency; inputStartTick = [long]$inputStartTick
+    collectionStartTick = [long]$CollectionStartTick; rawBytes = [long]0; now = $now
+    records = [Collections.Generic.List[hashtable]]::new()
+    recordRefs = [Collections.Generic.List[object]]::new()
+    links = [Collections.Generic.List[hashtable]]::new()
+    secondaryErrors = [Collections.Generic.List[Management.Automation.ErrorRecord]]::new()
+    missing = [Collections.Generic.List[string]]::new()
+    artifacts = [Collections.Generic.List[hashtable]]::new()
+    flags = @{ moduleReady = $false; invokeStarted = $false; invokeReturned = $false
+        captureComplete = $false; postBindingsMatched = $false; savedWithinDeadline = $false }
+    counts = @{ ordinary = [int]0; engineOccurrences = [int]0; engineGroups = [int]0
+        unknown = [int]0; signal = [int]0; auxiliary = [int]0 }
+    primaryError = $null; overflow = $false; truncation = $false; captureBroken = $false; finalized = $false
+}
+
+# Driver-local schema checks are not part of the synthetic producer seam.
+$checkKeys = {
+    param([object]$Value, [string[]]$Keys)
+    if ($Value -isnot [Collections.IDictionary] -or $Value.Count -ne $Keys.Count) {
+        throw [IO.InvalidDataException]::new('CAP object/key shape mismatch')
+    }
+    foreach ($key in $Value.Keys) {
+        if ($key -isnot [string] -or $key -cnotin $Keys) {
+            throw [IO.InvalidDataException]::new('CAP unexpected object key')
+        }
+    }
+}
+$absolute = {
+    param([object]$Value)
+    if ($Value -isnot [string] -or [string]::IsNullOrWhiteSpace($Value) -or
+        -not [IO.Path]::IsPathFullyQualified($Value) -or $Value.Length -gt 8192) {
+        throw [IO.InvalidDataException]::new('CAP absolute path required')
+    }
+    return [IO.Path]::GetFullPath($Value)
+}
+$checkWork = {
+    $tick = [long](& $now)
+    if ($CollectionStartTick -lt 0 -or $CollectionStartTick -gt $tick -or $tick -lt $inputStartTick -or
+        (($tick - $inputStartTick) / [double]$frequency) -ge 9 -or
+        (($tick - $CollectionStartTick) / [double]$frequency) -ge 30) {
+        throw [TimeoutException]::new('CAP preparation/capture work deadline reached')
+    }
+}
+$saveContext = @{ allowed = $false; created = $false }
+$save = {
+    param([string]$AbsolutePath, [byte[]]$Bytes)
+    if (-not $saveContext.allowed -or
+        [IO.Path]::GetDirectoryName($AbsolutePath) -ine $state.outputRoot -or
+        [IO.Path]::GetFileName($AbsolutePath) -cnotin @('raw.json', 'result.json')) {
+        throw [InvalidOperationException]::new('CAP output was not validated')
+    }
+    if (-not $saveContext.created) {
+        $null = New-Item -Path $state.outputRoot -ItemType Directory -ErrorAction Stop
+        $saveContext.created = $true
+    }
+    $stream = $null
+    $writeFailure = $null
+    try {
+        $stream = [IO.FileStream]::new($AbsolutePath, [IO.FileMode]::CreateNew,
+            [IO.FileAccess]::Write, [IO.FileShare]::None)
+        $stream.Write($Bytes, 0, $Bytes.Length)
+        $stream.Flush($true)
+    }
+    catch { $writeFailure = $_ }
+    finally {
+        if ($null -ne $stream) {
+            try { $stream.Dispose() }
+            catch {
+                if ($null -eq $writeFailure) { $writeFailure = $_ }
+                else { $state.secondaryErrors.Add($_) }
+            }
+        }
+    }
+    if ($null -ne $writeFailure) { throw $writeFailure }
+    return @{
+        path = $AbsolutePath
+        sha256 = [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($Bytes))
+        length = [long]$Bytes.LongLength
+    }
+}
+$binding = $null
+$stage = 'Capture'
+try {
+    & $checkWork
+    $normalizedBindingPath = & $absolute $BindingPath
+    $normalizedOutputRoot = & $absolute $OutputRoot
+    $captureRoot = [IO.Path]::GetDirectoryName([IO.Path]::GetFullPath($PSCommandPath))
+    if ($normalizedBindingPath -ine [IO.Path]::Combine($captureRoot, 'capture-binding.json') -or
+        $TargetRole -cnotin @('Collector', 'Assertions') -or $args.Count -ne 0) {
+        throw [IO.InvalidDataException]::new('CAP binding path, role or argument mismatch')
+    }
+    $bindingBytes = [IO.File]::ReadAllBytes($normalizedBindingPath)
+    $bindingHash = [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($bindingBytes))
