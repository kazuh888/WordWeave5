+        [Array]::Sort($dependencyPaths, [StringComparer]::Ordinal)
+        $null = & $pathState $Inputs.suiteRoot 'Directory' $workDeadline
+        $null = & $pathState $temp 'Missing' $workDeadline
+        foreach ($name in @('fake.exe', 'rustc-version.stdout', 'rustc-version.stderr', 'fake-build.stdout',
