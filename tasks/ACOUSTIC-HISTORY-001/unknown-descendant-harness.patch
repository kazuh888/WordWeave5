+﻿<#
+.SYNOPSIS
+    Runs the unchanged synthetic ENV01 once for first-failure observation
+.DESCRIPTION
+    Loads the original source-bound fixture context and read-only preflight.
+    Runs one original ENV01 with its original oracle and cleanup. All broader
+    suite credits remain zero. Evidence is retained without overwrite or retry.
+.PARAMETER NativeSourceSha256
+    Approved fixed native source digest.
+.PARAMETER NativeExeSha256
+    Approved fixed native executable digest.
+.PARAMETER OutputRoot
+    Fresh absolute UUID directory directly beneath cargo-gate/verification.
+.PARAMETER ValidateOnly
+    Checks source bindings and original preflight without writes, builds or case dispatch.
+.EXAMPLE
+    ./Invoke-FirstFailureEnv01.ps1 -NativeSourceSha256 $sourceHash -NativeExeSha256 $exeHash -OutputRoot $freshSuite -ValidateOnly
+.NOTES
+    Author: Codex FIRST-FAILURE01 implementer
+    Created: 2026-10-16
+    Requires: PowerShell 7.6.7 (ps7), ordinary Windows user, existing Rust and Pester 5.7.1.
+    Exit 0: preflight or the single unchanged case passed; 1: rejected or failed.
+    Fixed paths and private source extraction follow the approved packet design.
+    The parent must bind this probe's final digest before invocation; self hashing
+    detects subsequent changes and is not approval.
+#>
+#Requires -Version 7.6
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][ValidatePattern('^[A-F0-9]{64}$')][string]$NativeSourceSha256,
+    [Parameter(Mandatory)][ValidatePattern('^[A-F0-9]{64}$')][string]$NativeExeSha256,
+    [Parameter(Mandatory)][string]$OutputRoot,
+    [switch]$ValidateOnly
+)
+Set-StrictMode -Version 3.0
+$ErrorActionPreference = 'Stop'
+$env01PreparationStartedTick = [Diagnostics.Stopwatch]::GetTimestamp()
+
+function Invoke-FirstFailureEnv01Case {
+    param([Collections.IDictionary]$Case, [hashtable]$Context, [hashtable]$FixedInputs)
+    $result = @{ id = 'ENV01'; status = 'NotRun'; expectedCount = 1; dispatchCount = 0
+        otherCaseDispatchCount = 0; retryCount = 0; focused10Credit = 0; full80Credit = 0; productFullCredit = 0
+        sourceMatched = $false; existingResult = $null; errorCode = 'InvalidInput' }
+    try {
+        $expectedCase = [ordered]@{ id = 'ENV01'; group = 'ENV_PATH'; name = 'cargo_only_runner'
+            stimulus = 'Start one RunOwner with fixed child EnvMap'
+            expected = 'Cargo sees exact one-word absolute native runner; parent runner variable unchanged'
+            synchronization = 'Cargo environment marker'; mandatory = $true; executionStatus = 'NotRun' }
+        if ($null -eq $Case -or $Case.Count -ne $expectedCase.Count -or $Case.Contains('variant') -or
+            $null -eq $Context -or $null -eq $FixedInputs -or $FixedInputs.Count -ne 12) { return $result }
+        foreach ($key in $expectedCase.Keys) {
+            if (-not $Case.Contains($key) -or $null -eq $Case[$key] -or
+                $Case[$key].GetType() -ne $expectedCase[$key].GetType() -or $Case[$key] -cne $expectedCase[$key]) {
+                return $result
+            }
+        }
+        $seen = [Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
+        foreach ($key in $FixedInputs.Keys) {
+            if ($key -isnot [string] -or -not [IO.Path]::IsPathFullyQualified($key) -or
+                -not [string]::Equals($key, [IO.Path]::GetFullPath($key), [StringComparison]::Ordinal) -or
+                -not $seen.Add($key) -or $FixedInputs[$key] -isnot [string] -or
+                $FixedInputs[$key] -cnotmatch '^[A-F0-9]{64}$') { return $result }
+        }
+        $paths = [string[]]@($FixedInputs.Keys)
+        [Array]::Sort($paths, [StringComparer]::Ordinal)
+    }
+    catch { return $result }
+    # Two bounded hash passes share the original seam, with no direct file reader.
+    $checkInputs = {
+        foreach ($path in $paths) {
+            $observed = @(Get-PathHash -Path $path)
+            if ($observed.Count -ne 1 -or $observed[0] -isnot [hashtable] -or
+                $observed[0].path -isnot [string] -or $observed[0].sha256 -isnot [string] -or
+                -not [string]::Equals($observed[0].path, $path, [StringComparison]::OrdinalIgnoreCase) -or
+                -not [string]::Equals($observed[0].sha256, $FixedInputs[$path], [StringComparison]::Ordinal)) {
+                throw 'Fixed input mismatch'
+            }
+        }
+    }
+    try { & $checkInputs }
+    catch { $result.errorCode = 'FrozenInputsBefore'; return $result }
+    $caseFailed = $false
+    $afterFailed = $false
+    $actual = @()
+    $result.dispatchCount = 1
+    $result.status = 'Failed'
+    try { $actual = @(Invoke-GateCase -Case $Case -Context $Context) }
+    catch { $caseFailed = $true }
+    try { & $checkInputs }
+    catch { $afterFailed = $true }
+    $result.sourceMatched = -not $afterFailed
+    if ($caseFailed) { $result.errorCode = 'CaseInvocationFailed' }
+    elseif ($afterFailed) { $result.errorCode = 'FrozenInputsAfter' }
+    elseif ($actual.Count -ne 1 -or $actual[0] -isnot [Collections.IDictionary] -or
+        $actual[0]['id'] -isnot [string] -or $actual[0]['id'] -cne 'ENV01' -or
+        $actual[0]['status'] -isnot [string] -or $actual[0]['status'] -cne 'Passed') {
+        $result.errorCode = 'UnexpectedCaseResult'
+    }
+    else {
+        $result.status = 'Passed'
+        $result.errorCode = $null
+        $result.existingResult = $actual[0]
+    }
+    return $result
+}
+
+function Invoke-Env01Preparation {
+    <#
+    .SYNOPSIS
+        Prepares fixed synthetic inputs and stops for approval
+    .DESCRIPTION
+        Uses only eight supplied boundaries; retains the first error and direct handle.
+    .PARAMETER Inputs
+        Fixed clock, paths, dependencies and manifest digest.
+    .PARAMETER Ports
+        Now, ReadState, Hash, Start, Poll, Stop, Wait and Save scriptblocks.
+    .EXAMPLE
+        Invoke-Env01Preparation -Inputs $preparationInputs -Ports $preparationPorts
+    .NOTES
+        Private preparation boundary; PowerShell 7.6.7 (ps7). No dispatch or retry.
+    #>
+    [CmdletBinding()]
+    [OutputType([hashtable])]
+    param([hashtable]$Inputs, [hashtable]$Ports)
+    $result = @{ state = 'Failed'; dispatchCount = 0; retryCount = 0; fakeSha256 = $null
+        primaryError = $null; secondaryErrors = @(); directRecovery = 'NotStarted'
+        unknownDescendants = 'NotObserved'; evidence = @() }
+    $control = @{ lastTick = $null; handle = $null; released = $false; exited = $false
+        recovered = $false; unknown = $false; evidenceFailed = $false; saveAllowed = $false
+        saveDeadline = $null; version = $null; phases = @(); manifestPath = $null
+        syntheticErrors = [Collections.Generic.List[object]]::new(); inWork = $true; currentPhase = $null }
+    $shape = {
+        param($value, [string[]]$keys)
+        if ($value -isnot [hashtable] -or $value.Count -ne $keys.Count) { throw 'AdapterFailure: shape' }
+        foreach ($key in $keys) {
+            if (@($value.Keys | Where-Object { $_ -ceq $key }).Count -ne 1) { throw 'AdapterFailure: shape key' }
+        }
+    }
+    $remember = {
+        param($failure)
+        if ($null -ne $failure) {
+            foreach ($canonical in $control.syntheticErrors) {
+                if ([object]::ReferenceEquals($failure, $canonical) -or
+                    [object]::ReferenceEquals($failure.Exception, $canonical.Exception)) {
+                    if ([object]::ReferenceEquals($result.primaryError, $canonical)) { return }
+                    foreach ($secondary in $result.secondaryErrors) {
+                        if ([object]::ReferenceEquals($secondary, $canonical)) { return }
+                    }
+                    $failure = $canonical
+                    break
+                }
+            }
+            if ($null -eq $result.primaryError) { $result.primaryError = $failure }
+            else { $result.secondaryErrors += ,$failure }
+        }
+    }
+    $fail = {
+        param([string]$suffix, [string]$message)
+        $category = [Management.Automation.ErrorCategory]::InvalidData
+        if ($suffix.StartsWith('Deadline.', [StringComparison]::Ordinal)) {
+            $exception = [TimeoutException]::new($message)
+            $category = [Management.Automation.ErrorCategory]::OperationTimeout
+        }
+        else {
+            $exception = [InvalidOperationException]::new($message)
+            if ($suffix.StartsWith('NonzeroExit.', [StringComparison]::Ordinal)) {
+                $category = [Management.Automation.ErrorCategory]::InvalidResult
+            }
+            elseif ($suffix -ceq 'Dependency.Missing') {
+                $category = [Management.Automation.ErrorCategory]::ResourceUnavailable
+            }
+        }
+        $failure = [Management.Automation.ErrorRecord]::new(
+            $exception, ('WW5.ENV01.Preparation.' + $suffix), $category, $null)
+        $control.syntheticErrors.Add($failure)
+        & $remember $failure
+        throw $failure
+    }
+    $deadlineFailure = {
+        param([long]$deadline)
+        if ($control.inWork -and $deadline -eq $workDeadline) {
+            & $fail 'Deadline.Work' 'Preparation work deadline'
+        }
+        if ($control.inWork -and $null -ne $control.currentPhase) {
+            & $fail ('Deadline.' + $control.currentPhase) 'Preparation phase deadline'
+        }
+        throw 'Preparation deadline'
+    }
+    $manifestShape = {
+        param($value, [string[]]$keys)
+        try { & $shape $value $keys }
+        catch { & $fail 'Manifest.Shape' 'Preparation manifest shape' }
+    }
+    $now = {
+        $tick = & $Ports.Now
+        if ($tick -isnot [long] -or ($null -ne $control.lastTick -and $tick -lt $control.lastTick)) {
+            throw 'AdapterFailure: monotonic clock'
+        }
+        $control.lastTick = $tick
+        return $tick
+    }
+    $invoke = {
+        param([string]$name, [object[]]$arguments, [long]$deadline)
+        if ((& $now) -ge $deadline) { & $deadlineFailure $deadline }
+        try { $response = & $Ports[$name] @arguments }
+        catch { & $remember $_; throw }
+        & $shape $response @('value', 'error')
+        $returnedTick = & $now
+        if ($null -ne $response.error) {
+            & $remember $response.error
+            throw $response.error
+        }
+        if ($returnedTick -ge $deadline) { & $deadlineFailure $deadline }
+        return ,$response.value
+    }
+    $canonical = {
+        param($path)
+        if ($path -isnot [string] -or -not [IO.Path]::IsPathFullyQualified($path) -or
+            -not [string]::Equals($path, [IO.Path]::GetFullPath($path), [StringComparison]::Ordinal)) {
+            & $fail 'Boundary.Path' 'Preparation canonical path boundary'
+        }
+    }
+    $pathState = {
+        param([string]$path, [string]$kind, [long]$deadline)
+        & $canonical $path
+        $value = & $invoke 'ReadState' @('Path', @{ path = $path }) $deadline
+        & $shape $value @('fullPath', 'exists', 'kind', 'length', 'ancestorReparse')
+        if ($value.fullPath -isnot [string] -or $value.exists -isnot [bool] -or
+            $value.ancestorReparse -isnot [bool] -or $value.kind -isnot [string] -or
+            ($value.kind -ceq 'File' -and ($value.length -isnot [long] -or $value.length -lt 0))) {
+            throw 'AdapterFailure: path state shape'
+        }
+        if ($value.ancestorReparse) { & $fail 'Boundary.Reparse' 'Preparation reparse boundary' }
+        if ($value.fullPath -cne $path) { & $fail 'Boundary.Path' 'Preparation observed path boundary' }
+        if ($kind -ceq 'File' -and -not $value.exists) {
+            & $fail 'Dependency.Missing' 'Preparation required file missing'
+        }
+        if ($value.kind -cne $kind -or ($kind -ceq 'Missing' -and $value.exists) -or
+            ($kind -cne 'Missing' -and -not $value.exists)) {
+            & $fail 'Boundary.Path' 'Preparation file kind boundary'
+        }
+        return $value
+    }
+    $hash = {
+        param([string]$path, [object]$expected, [long]$deadline, [string]$driftSuffix = 'Dependency.Drift')
+        if ($null -ne $expected -and ($expected -isnot [string] -or $expected -cnotmatch '^[A-F0-9]{64}$')) {
+            throw 'AdapterFailure: expected hash shape'
+        }
+        $value = & $invoke 'Hash' @($path) $deadline
+        & $shape $value @('path', 'sha256')
+        if ($value.path -isnot [string] -or $value.sha256 -isnot [string] -or
+            $value.sha256 -cnotmatch '^[A-F0-9]{64}$') { throw 'AdapterFailure: hash shape' }
+        if ($value.path -cne $path) { & $fail 'Boundary.Path' 'Preparation hash path boundary' }
+        if ($null -ne $expected -and $value.sha256 -cne $expected) {
+            & $fail $driftSuffix 'Preparation observed hash differs'
+        }
+        return $value.sha256
+    }
+    $save = {
+        param([string]$action, [hashtable]$arg, [string]$kind)
+        $snapshot = @{ kind = $kind; path = $arg.path; status = 'Missing'; sha256 = $null; length = $null }
+        try {
+            $tick = & $now
+            if ($null -eq $control.saveDeadline) {
+                $control.saveDeadline = [Math]::Min($tick + 2 * $Inputs.frequency, $totalDeadline)
+            }
+            if ($tick -ge $control.saveDeadline) { throw 'Evidence save deadline' }
+            try { $response = & $Ports.Save $action $arg }
+            catch { & $remember $_; throw }
+            & $shape $response @('value', 'error')
+            if ($null -ne $response.value) {
+                & $shape $response.value @('path', 'status', 'sha256', 'length')
+                $value = $response.value
+                $snapshot = @{ kind = $kind; path = $value.path; status = $value.status
+                    sha256 = $value.sha256; length = $value.length }
+            }
+            $returnedTick = & $now
+            if ($null -ne $response.error) {
+                & $remember $response.error
+                throw $response.error
+            }
