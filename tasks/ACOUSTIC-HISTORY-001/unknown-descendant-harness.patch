+    }
+    $pause = {
+        param([long]$deadline)
+        $remaining = $deadline - (& $now)
+        $milliseconds = [int][Math]::Min(50, [Math]::Floor($remaining * 1000.0 / $Inputs.frequency))
+        if ($milliseconds -lt 1) { & $deadlineFailure $deadline }
+        $null = & $invoke 'Wait' @($milliseconds) $deadline
+    }
+    $runPhase = {
+        param([string]$phase, [int]$seconds, [string[]]$argv, [string]$log)
+        $begin = & $now
+        $deadline = [Math]::Min($begin + $seconds * $Inputs.frequency, $workDeadline)
+        $control.currentPhase = $phase
+        if ($begin -ge $deadline) { & $deadlineFailure $deadline }
+        $spec = @{ phase = $phase; exe = $Inputs.dependencies.tools.rustc; argv = $argv
+            cwd = $Inputs.suiteRoot; environment = $Inputs.dependencies.environment.Clone()
+            stdoutPath = [IO.Path]::Combine($Inputs.suiteRoot, "$log.stdout")
+            stderrPath = [IO.Path]::Combine($Inputs.suiteRoot, "$log.stderr") }
+        $control.handle = $null
+        $control.released = $false
+        $control.exited = $false
+        try { $started = & $Ports.Start $spec }
+        catch { & $remember $_; throw }
+        # Capture partial-start ownership and the original error before any validation or clock failure.
+        if ($started -is [hashtable] -and $started.ContainsKey('handle') -and $null -ne $started.handle) {
+            $control.handle = $started.handle
+        }
+        if ($started -is [hashtable] -and $started.ContainsKey('startError')) { & $remember $started.startError }
+        & $shape $started @('started', 'handle', 'startedTick', 'outTask', 'errTask', 'startError')
+        if ($started.started -isnot [bool] -or
+            ($started.started -and ($null -eq $started.handle -or $started.startedTick -isnot [long])) -or
+            (-not $started.started -and ($null -ne $started.handle -or $null -ne $started.startedTick))) {
+            throw 'AdapterFailure: start state'
+        }
+        if ((& $now) -ge $deadline) { & $deadlineFailure $deadline }
+        if ($null -ne $started.startError) { throw $started.startError }
+        if (-not $started.started) { throw "$phase start failed" }
+        while ($true) {
+            $observation = & $poll $deadline
+            if ($observation.exited -and $observation.outClosed -and $observation.errClosed) {
+                if (-not $observation.released) { throw 'AdapterFailure: unreleased completion' }
+                $control.phases += ,(@{ phase = $phase; startedTick = $started.startedTick
+                    exitCode = $observation.exitCode; outClosed = $true; errClosed = $true })
+                $result.directRecovery = 'Exited'
+                if ($observation.exitCode -ne 0) {
+                    $exitText = $observation.exitCode.ToString([Globalization.CultureInfo]::InvariantCulture)
+                    & $fail ('NonzeroExit.' + $phase + '.' + $exitText) 'Preparation phase returned nonzero exit'
+                }
+                if ($phase -ceq 'Version') {
+                    if ($observation.stdoutText -isnot [string]) { throw 'AdapterFailure: version text' }
+                    $control.version = $observation.stdoutText
+                }
+                $control.currentPhase = $null
+                return
+            }
+            & $pause $deadline
+        }
+    }
+    $checkDependencies = {
+        foreach ($path in $dependencyPaths) {
+            $null = & $pathState $path 'File' $workDeadline
+            $null = & $hash $path $dependencyHashes[$path] $workDeadline
+        }
+        $null = & $hash $control.manifestPath $Inputs.manifestSha256 $workDeadline
+    }
+    try {
+        & $shape $Inputs @('startedTick', 'frequency', 'suiteRoot', 'sourcePath', 'fakePath',
+            'fixed', 'dependencies', 'manifestSha256')
+        & $shape $Ports @('Now', 'ReadState', 'Hash', 'Start', 'Poll', 'Stop', 'Wait', 'Save')
+        foreach ($value in $Ports.Values) {
+            if ($value -isnot [scriptblock]) { throw 'AdapterFailure: port type' }
+        }
+        if ($Inputs.startedTick -isnot [long] -or $Inputs.frequency -isnot [long] -or $Inputs.frequency -le 0 -or
+            $Inputs.startedTick -lt 0 -or $Inputs.frequency -gt ([long]::MaxValue - $Inputs.startedTick) / 40 -or
+            $Inputs.manifestSha256 -cnotmatch '^[A-F0-9]{64}$') { throw 'AdapterFailure: inputs' }
+        $totalDeadline = $Inputs.startedTick + 40 * $Inputs.frequency
+        $workDeadline = $Inputs.startedTick + 35 * $Inputs.frequency
+        $control.lastTick = $Inputs.startedTick
+        foreach ($key in @('suiteRoot', 'sourcePath', 'fakePath')) { & $canonical $Inputs[$key] }
+        $suiteGuid = [guid]::Empty
+        if (-not [guid]::TryParseExact([IO.Path]::GetFileName($Inputs.suiteRoot), 'D', [ref]$suiteGuid) -or
+            $Inputs.fakePath -cne [IO.Path]::Combine($Inputs.suiteRoot, 'fake.exe') -or
+            $Inputs.sourcePath -cne [IO.Path]::Combine([IO.Path]::GetDirectoryName(
+                [IO.Path]::GetDirectoryName($Inputs.suiteRoot)), 'fake.rs')) {
+            & $fail 'Boundary.Path' 'Preparation fixed path boundary'
+        }
+        $control.manifestPath = [IO.Path]::Combine([IO.Path]::GetDirectoryName($Inputs.suiteRoot),
+            'argv-path01', [IO.Path]::GetFileName($Inputs.suiteRoot), 'prepare-inputs.json')
+        $manifestState = & $pathState $control.manifestPath 'File' $workDeadline
+        if ($manifestState.length -gt 65536) { & $fail 'Manifest.Shape' 'Preparation manifest length' }
+        $raw = & $invoke 'ReadState' @('Manifest', @{ path = $control.manifestPath }) $workDeadline
+        if ($raw -isnot [byte[]]) { throw 'AdapterFailure: manifest response type' }
+        if ($raw.Length -gt 65536) { & $fail 'Manifest.Shape' 'Preparation manifest length' }
+        if ([Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($raw)) -cne $Inputs.manifestSha256) {
+            & $fail 'Dependency.Drift' 'Preparation manifest digest differs'
+        }
+        try {
+            $manifest = [Text.UTF8Encoding]::new($false, $true).GetString($raw) |
+                ConvertFrom-Json -AsHashtable -DateKind String
+        }
+        catch { & $fail 'Manifest.Shape' 'Preparation manifest parse' }
+        & $manifestShape $manifest @('schemaVersion', 'scope', 'suiteRoot', 'files', 'tools', 'environment')
+        if (($manifest | ConvertTo-Json -Depth 20 -Compress) -cne
+            ($Inputs.dependencies | ConvertTo-Json -Depth 20 -Compress)) {
+            & $fail 'Dependency.Drift' 'Preparation manifest input differs'
+        }
+        if ($manifest.schemaVersion -isnot [long] -or $manifest.schemaVersion -ne 1 -or
+            $manifest.scope -isnot [string] -or $manifest.suiteRoot -isnot [string] -or
+            $manifest.scope -cne 'PrepareOnly' -or $manifest.suiteRoot -cne $Inputs.suiteRoot -or
+            $manifest.files -isnot [array] -or $manifest.files.Count -eq 0) {
+            & $fail 'Manifest.Shape' 'Preparation manifest field type/value'
+        }
+        & $manifestShape $manifest.tools @('rustc', 'pwsh', 'v2')
+        & $manifestShape $manifest.environment @('TEMP', 'TMP', 'PATH', 'RUSTUP_HOME', 'RUSTUP_TOOLCHAIN', 'CARGO_HOME')
+        foreach ($value in $manifest.environment.Values) {
+            if ($null -ne $value -and $value -isnot [string]) {
+                & $fail 'Manifest.Shape' 'Preparation manifest environment type'
+            }
+        }
+        $temp = [IO.Path]::Combine($Inputs.suiteRoot, 'temp')
+        if ($manifest.environment.TEMP -cne $temp -or $manifest.environment.TMP -cne $temp) {
+            & $fail 'Boundary.ChildTemp' 'Preparation child TEMP/TMP boundary'
+        }
+        $context = & $invoke 'ReadState' @('Context', @{}) $workDeadline
+        & $shape $context @('tools', 'environment')
+        & $shape $context.tools @('rustc', 'pwsh', 'v2')
+        & $shape $context.environment @('PATH', 'RUSTUP_HOME', 'RUSTUP_TOOLCHAIN', 'CARGO_HOME')
+        foreach ($key in $manifest.tools.Keys) {
+            if ($manifest.tools[$key] -isnot [string]) {
+                & $fail 'Manifest.Shape' 'Preparation manifest tool path type'
+            }
+            & $canonical $manifest.tools[$key]
+            if ($manifest.tools[$key] -cne $context.tools[$key]) { throw 'Tool resolution drift' }
+        }
+        foreach ($key in $context.environment.Keys) {
+            if (($null -eq $manifest.environment[$key]) -ne ($null -eq $context.environment[$key]) -or
+                $manifest.environment[$key] -cne $context.environment[$key]) { throw 'Environment drift' }
+        }
+        if ($Inputs.fixed -isnot [hashtable]) { throw 'Fixed inputs shape' }
+        $dependencyHashes = [Collections.Generic.Dictionary[string,string]]::new([StringComparer]::Ordinal)
+        $seen = [Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
+        foreach ($file in $manifest.files) {
+            & $manifestShape $file @('path', 'sha256')
+            if ($file.path -isnot [string]) { & $fail 'Manifest.Shape' 'Preparation manifest file path type' }
+            & $canonical $file.path
+            if ($file.sha256 -isnot [string] -or $file.sha256 -cnotmatch '^[A-F0-9]{64}$' -or
+                -not $seen.Add($file.path)) { & $fail 'Manifest.Shape' 'Preparation manifest file shape/duplicate' }
+            $dependencyHashes.Add($file.path, $file.sha256)
+        }
+        foreach ($path in $Inputs.fixed.Keys) {
+            & $canonical $path
+            if ($Inputs.fixed[$path] -isnot [string] -or $Inputs.fixed[$path] -cnotmatch '^[A-F0-9]{64}$' -or
+                ($dependencyHashes.ContainsKey($path) -and $dependencyHashes[$path] -cne $Inputs.fixed[$path])) {
