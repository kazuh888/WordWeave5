+fn encode_environment(keys: &[&str], mut lookup: impl FnMut(&str) -> Option<OsString>) -> String {
+    let records = keys.iter().map(|key| {
+        let value = lookup(key).map(|v| units(&v)).unwrap_or_else(|| "null".into());
+        format!("\"{key}\":{value}")
+    }).collect::<Vec<_>>().join(",");
