+    let (message_utf16, message_status) = if !allowlisted {
+        ("null".to_owned(), "NotAllowlisted")
+    } else if message_units.len() > 2048 {
+        ("null".to_owned(), "TooLong")
+    } else {
+        (format!("[{}]", message_units.iter().map(|unit| unit.to_string()).collect::<Vec<_>>().join(",")), "Captured")
+    };
+    let raw_os_error = error.raw_os_error().map(|code| code.to_string()).unwrap_or_else(|| "null".into());
+    let serialize = |message_utf16: &str, message_status: &str| {
+        format!("{{\"schemaVersion\":1,\"pid\":{pid},\"stage\":\"{stage:?}\",\"errorKind\":\"{:?}\",\"rawOsError\":{raw_os_error},\"messageUtf16\":{message_utf16},\"messageStatus\":\"{message_status}\"}}", error.kind()).into_bytes()
+    };
+    let mut bytes = serialize(&message_utf16, message_status);
+    if bytes.len() > 8192 {
+        bytes = serialize("null", "TooLong");
+    }
+    bytes
+}
