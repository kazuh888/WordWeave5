+        "CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_RUNNER", "WW5_CARGO_GATE_RUN_PATH", "WW5_CARGO_GATE_RUN_ID",
+        "WW5_ET2_CHILD", "WW5_ET2_BASE", "ET3_FAKE_ROOT", "ET3_FAKE_MODE", "ET3_FAKE_EXIT_U32",
+        "ET3_FAKE_RELEASE", "ET3_FAKE_WAIT_MS", "ET3_FAKE_BUILD_RELEASE", "ET3_FAKE_INVOCATIONS"];
