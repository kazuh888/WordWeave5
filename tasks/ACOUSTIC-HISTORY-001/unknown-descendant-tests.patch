+﻿<#
+.SYNOPSIS
+    Runs six fixed CAP-BF reference cases before one separately counted OldRed.
+.DESCRIPTION
+    Extracts the exact predicate and foreach source spans. No duplicate predicate,
+    analyzer invocation, OS process fixture or Unit20 is executed.
+.PARAMETER BindingPath
+    Absolute independently frozen BF execution binding.
+.PARAMETER OutputRoot
+    New fixed focused-report leaf.
+.PARAMETER CollectionStartTick
+    Original same-shell Stopwatch start; never reset between focused cases and OldRed.
+.EXAMPLE
+    ./Test-PssaReferenceFocus.ps1 -BindingPath ./execution-binding.json -OutputRoot ./out/focus-UUID -CollectionStartTick 1
+.NOTES
+    Requires: PowerShell 7.6.7 (ps7). Fixed direct packet assertions, no framework/module.
+    Exit 1: six contracts passed and original specific RED accepted within clocks.
+    Exit 2: any fixture/adapter/behavior/pin/save/deadline failure; no retry.
+#>
+#Requires -Version 7.6
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$BindingPath,
+    [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$OutputRoot,
+    [Parameter(Mandatory)][ValidateRange(1, [long]::MaxValue)][long]$CollectionStartTick
+)
+Set-StrictMode -Version 3.0
+$ErrorActionPreference = 'Stop'
+
+function Assert-Bf {
+    param([bool]$Condition, [string]$Message, [string]$Category = 'BehaviorMismatch')
+    if (-not $Condition) { throw ($Category + ': ' + $Message) }
+}
+function Test-BfPins {
+    param([object[]]$Pins)
+    foreach ($pin in $Pins) {
+        $actual = (Get-FileHash -LiteralPath $pin.path -Algorithm SHA256).Hash
+        Assert-Bf ($actual -ceq $pin.sha256) ('pin drift ' + $pin.path) 'AdapterFailure'
+        @{ path = $pin.path; sha256 = $actual }
+    }
+}
+function Assert-BfClock {
+    param([long]$InputStart = 0)
+    $now = [Diagnostics.Stopwatch]::GetTimestamp()
+    $frequency = [double][Diagnostics.Stopwatch]::Frequency
+    Assert-Bf (($now - $CollectionStartTick) / $frequency -lt 30) 'common collection deadline' 'Deadline'
+    if ($InputStart -gt 0) {
+        Assert-Bf (($now - $InputStart) / $frequency -lt 5) 'input deadline' 'Deadline'
+    }
+}
+function New-BfError {
+    return [Management.Automation.ErrorRecord]::new([InvalidOperationException]::new('CAP-BF same message'),
+        'CAP-BF.SameId', [Management.Automation.ErrorCategory]::InvalidOperation, $null)
+}
+$rows = [Collections.Generic.List[hashtable]]::new()
+$report = @{ schemaVersion = 1; candidateOnly = $true; cases = @(); oldRed = @{ status = 'NotRun' }
+    retry = 0; actualPssaInvocations = 0; collectionStartTick = $CollectionStartTick
+    actualArgv = [Environment]::GetCommandLineArgs(); actualPS = $PSVersionTable.PSVersion.ToString() }
+$requestedExit = 2
+$outputCreated = $false
+$lastInputStart = [long]0
+$saved = $null
+try {
+    Assert-BfClock
+    $bindingBefore = (Get-FileHash -LiteralPath $BindingPath -Algorithm SHA256).Hash
+    $binding = Get-Content -LiteralPath $BindingPath -Raw -Encoding utf8 | ConvertFrom-Json -AsHashtable
+    Assert-Bf ($binding.phase -ceq 'CAP-BF-Focus6ThenOldRed') 'fixed phase' 'AdapterFailure'
+    Assert-Bf ($PSVersionTable.PSVersion.ToString() -ceq '7.6.7' -and
+        [IO.Path]::GetFullPath([Environment]::ProcessPath) -ieq
+        [IO.Path]::GetFullPath($binding.hostExecutable)) 'fixed host/runtime' 'AdapterFailure'
+    Assert-Bf ([IO.Path]::GetFullPath((Get-Location).Path) -ieq
+        [IO.Path]::GetFullPath($binding.cwd)) 'cwd' 'AdapterFailure'
+    $expectedParent = [IO.Path]::GetFullPath([IO.Path]::Combine($PSScriptRoot, 'out'))
+    Assert-Bf ([IO.Path]::IsPathFullyQualified($OutputRoot) -and
+        [IO.Path]::GetFullPath($OutputRoot) -ieq [IO.Path]::GetFullPath($binding.outputRoot) -and
+        [IO.Path]::GetDirectoryName([IO.Path]::GetFullPath($OutputRoot)) -ieq $expectedParent -and
+        -not [IO.Directory]::Exists($OutputRoot) -and -not [IO.File]::Exists($OutputRoot) -and
+        -not [IO.Directory]::Exists($binding.oldRedOutputRoot) -and
+        -not [IO.File]::Exists($binding.oldRedOutputRoot)) 'new fixed output leaves' 'AdapterFailure'
+    $ancestor = $expectedParent
+    while (-not [string]::IsNullOrEmpty($ancestor)) {
+        if ([IO.Directory]::Exists($ancestor)) {
+            Assert-Bf (([IO.File]::GetAttributes($ancestor) -band [IO.FileAttributes]::ReparsePoint) -eq 0) `
+                'output ancestor reparse point' 'AdapterFailure'
+        }
+        $ancestor = [IO.Path]::GetDirectoryName($ancestor)
