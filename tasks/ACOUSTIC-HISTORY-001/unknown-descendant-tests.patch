+        $Context.runDirectory -isnot [string] -or -not [IO.Path]::IsPathFullyQualified($Context.runDirectory) -or
+        $Context.runSha256 -isnot [string] -or $Context.runSha256 -cnotmatch '^[A-F0-9]{64}$' -or
+        $Context.gateSourceSha256 -isnot [string] -or $Context.gateSourceSha256 -cnotmatch '^[A-F0-9]{64}$' -or
+        $Context.role -isnot [string] -or $Context.role -cnotin @('RunOwner', 'Supervisor', 'Runner', 'SafetyWorker') -or
+        -not (& $integer $Context.actorPid 1 ([int]::MaxValue)) -or $Context.actorPid -ne $PID -or
+        -not (& $utc $Context.actorStartTimeUtc) -or
+        -not (& $integer $Context.actorStartTicks 0 ([long]::MaxValue)) -or
+        $Context.actorStartTicks -ne (Get-Utc -Value $Context.actorStartTimeUtc).UtcTicks -or
