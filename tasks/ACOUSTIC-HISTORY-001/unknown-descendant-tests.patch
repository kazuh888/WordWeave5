+  match id {
+   "O4-writeok"|"O4-syncfail"=>check(memory.files.get(&failure_path())==Some(&bytes),"O4 complete bytes retained")?,
+   "O4-collision"=>check(memory.files.get(&failure_path())==Some(&vec![17,34,51]),"O4 collision retained")?,
+   "O4-openfail"=>check(!memory.files.contains_key(&failure_path()),"O4 no file on failed create")?,
+   "O4-writefail"=>check(memory.files.get(&failure_path())==Some(&Vec::new()),"O4 empty partial preserved")?,
