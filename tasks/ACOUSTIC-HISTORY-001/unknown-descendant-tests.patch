+﻿<#
+.SYNOPSIS
+    Captures preparation baseline AST boundaries without running the probe
+.DESCRIPTION
+    Reads only fixed baseline bytes and author artifacts. Saves fresh metadata in this packet.
+    No target script import, toolchain query, compilation, OS ownership or process operation occurs.
+.EXAMPLE
+    ./New-PreparationStaticEvidence.ps1
+.NOTES
+    Author: Codex U-M test author. Created: 2026-10-24.
+    Requires: PowerShell 7.6.7 (ps7), ordinary sandbox; no module installation.
+    Exit 0: static evidence saved; 2: adapter/static failure. Not a behavior execution.
+#>
+#Requires -Version 7.6
+[CmdletBinding()]
+param()
+Set-StrictMode -Version 3.0
+$ErrorActionPreference = 'Stop'
+
+function Write-PacketJson {
+    <# .SYNOPSIS
+        Saves fresh static metadata with CreateNew
+    .PARAMETER Name
+        Fixed filename directly in this author packet.
+    .PARAMETER Value
+        Metadata to serialize.
+    .EXAMPLE
+        Write-PacketJson -Name 'static-evidence.json' -Value $record
+    .NOTES
+        Private test helper; PowerShell 7.6.7.
+    #>
+    [CmdletBinding()]
+    param([string]$Name, [object]$Value)
+    $bytes = [Text.UTF8Encoding]::new($false, $true).GetBytes(($Value | ConvertTo-Json -Depth 30))
+    $stream = [IO.File]::Open((Join-Path $PSScriptRoot $Name), 'CreateNew', 'Write', 'None')
+    try {
+        $stream.Write($bytes, 0, $bytes.Length)
+        $stream.Flush($true)
+    }
+    finally { $stream.Dispose() }
+}
+
+function Get-ByteDigest {
+    <# .SYNOPSIS
+        Hashes isolated bytes without filesystem access
+    .PARAMETER Bytes
+        Exact bytes whose SHA256 is required.
+    .EXAMPLE
+        Get-ByteDigest -Bytes $raw
+    .NOTES
+        Private static helper; PowerShell 7.6.7.
+    #>
+    [CmdletBinding()]
+    [OutputType([string])]
+    param([byte[]]$Bytes)
+    [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($Bytes))
+}
+
+function Get-UniqueText {
+    <# .SYNOPSIS
+        Requires one exact ordinal occurrence
+    .PARAMETER Text
+        Parent source text.
+    .PARAMETER Needle
+        Fixed original fragment.
+    .EXAMPLE
+        Get-UniqueText -Text $text -Needle '$packetRoot = $PSScriptRoot'
+    .NOTES
+        Private static helper; PowerShell 7.6.7.
+    #>
+    [CmdletBinding()]
+    param([string]$Text, [string]$Needle)
+    $position = $Text.IndexOf($Needle, [StringComparison]::Ordinal)
+    if ($position -lt 0 -or $Text.IndexOf($Needle, $position + 1, [StringComparison]::Ordinal) -ge 0) {
+        throw 'AdapterFailure: original fragment is not unique'
+    }
+    return $position
+}
+
+try {
+    $beforePath = Join-Path $PSScriptRoot 'before/Invoke-FirstFailureEnv01.ps1'
+    $sourcePath = Join-Path $PSScriptRoot '../Invoke-FirstFailureEnv01.ps1'
+    $bytes = [IO.File]::ReadAllBytes($beforePath)
+    $expectedHash = '0B6C78196FD5DB0CB5AE99364BC26720C99E2214467A71FC32156E2A12E91951'
+    if ((Get-ByteDigest -Bytes $bytes) -cne $expectedHash -or $bytes.Length -ne 19920 -or
+        [Convert]::ToHexString($bytes[0..2]) -cne 'EFBBBF' -or
+        (Get-FileHash -LiteralPath $sourcePath).Hash -cne $expectedHash) { throw 'Baseline drift' }
+    $utf8 = [Text.UTF8Encoding]::new($false, $true)
+    $text = $utf8.GetString($bytes, 3, $bytes.Length - 3)
+    $tokens = $null
+    $parseErrors = $null
+    $ast = [Management.Automation.Language.Parser]::ParseInput($text, [ref]$tokens, [ref]$parseErrors)
+    if ($parseErrors.Count -ne 0) { throw 'AdapterFailure: baseline parser errors' }
+    $bodyAssignment = @($ast.FindAll({
+        param($node)
+        $node -is [Management.Automation.Language.AssignmentStatementAst] -and
+        $node.Left.Extent.Text -ceq '$env01Body'
+    }, $true))
+    if ($bodyAssignment.Count -ne 1) { throw 'AdapterFailure: env01Body parent not unique' }
+    $body = @($bodyAssignment[0].FindAll({
+        param($node)
+        $node -is [Management.Automation.Language.ScriptBlockExpressionAst]
+    }, $false))
+    if ($body.Count -ne 1) { throw 'AdapterFailure: source-bound body not unique' }
+    $statements = @($body[0].ScriptBlock.EndBlock.Statements)
+    $spans = [Collections.Generic.List[object]]::new()
+    $descriptors = @(
+        @{ id = 'L1-Invoke'; exact = "'898C60B1133DB6956090035AF677B4CF7FDE0FE6FDFD5D47E5CD776B00500B71'" },
+        @{ id = 'L1-Fake'; exact = "'3482075BF7479E61942978830AE91FDDF5301133E1A2F43EDB9B65DDAA0FA016'" },
+        @{ id = 'L2-StartClockAnchor'; exact = "`$ErrorActionPreference = 'Stop'" },
+        @{ id = 'L2-FunctionAnchor'; exact = '$packetRoot = $PSScriptRoot' }
+    )
+    foreach ($descriptor in $descriptors) {
+        $offset = Get-UniqueText -Text $text -Needle $descriptor.exact
+        $spans.Add(@{ id = $descriptor.id; start = $offset; end = $offset + $descriptor.exact.Length
+            parent = 'ScriptBlockAst; literal/statement anchor'; original = $descriptor.exact })
+    }
+    $boundaries = @(
+        @{ id = 'L3'; first = '$rustc = (Get-Command rustc.exe -CommandType Application).Source'
+            lastPrefix = 'foreach ($path in @($rustc, $pwsh, $v2))' },
+        @{ id = 'L4'; first = 'Import-Module Pester -RequiredVersion 5.7.1'
+            lastPrefix = "Write-NewEvidence -Path (Join-Path `$OutputRoot 'toolchain.json')" },
+        @{ id = 'BaselineVersion'; first = '$version = & $rustc --version'
+            lastPrefix = "if (`$LASTEXITCODE -ne 0) { throw 'Rust toolchain query failed' }" }
+    )
+    foreach ($boundary in $boundaries) {
+        $first = @($statements | Where-Object { $_.Extent.Text -ceq $boundary.first })
+        $last = @($statements | Where-Object { $_.Extent.Text.StartsWith($boundary.lastPrefix, [StringComparison]::Ordinal) })
+        if ($first.Count -ne 1 -or $last.Count -ne 1 -or $first[0].Extent.StartOffset -ge $last[0].Extent.StartOffset) {
+            throw ('AdapterFailure: statement pair ' + $boundary.id)
+        }
+        $start = $first[0].Extent.StartOffset
+        $end = $last[0].Extent.EndOffset
+        $original = $text.Substring($start, $end - $start)
+        $null = Get-UniqueText -Text $text -Needle $original
+        $spans.Add(@{ id = $boundary.id; start = $start; end = $end
+            parent = 'Assignment $env01Body / ScriptBlockExpressionAst / EndBlock.Statements'
+            firstAst = $first[0].GetType().Name; lastAst = $last[0].GetType().Name; original = $original })
+    }
+    foreach ($span in $spans) {
+        $span.byteOffset = 3 + $utf8.GetByteCount($text.Substring(0, $span.start))
+        $originalBytes = $utf8.GetBytes($span.original)
+        $span.byteLength = $originalBytes.Length
+        $span.sha256 = Get-ByteDigest -Bytes $originalBytes
+        $span.allowedSubstitutions = @()
+        $rawSpan = $bytes[$span.byteOffset..($span.byteOffset + $span.byteLength - 1)]
+        if ((Get-ByteDigest -Bytes $rawSpan) -cne $span.sha256) { throw 'AdapterFailure: raw byte span differs' }
+        $restored = $text.Remove($span.start, $span.end - $span.start).Insert($span.start, $span.original)
+        $restoredBytes = [byte[]](@(0xEF, 0xBB, 0xBF) + $utf8.GetBytes($restored))
+        if ((Get-ByteDigest -Bytes $restoredBytes) -cne $expectedHash) { throw 'AdapterFailure: inverse bytes differ' }
+        $span.inverseFullBytes = $true
+    }
+    $oldPatchPath = Join-Path $PSScriptRoot 'before/unknown-descendant-tests.patch'
+    $oldPatchBytes = [IO.File]::ReadAllBytes($oldPatchPath)
+    $oldPatchText = [IO.File]::ReadAllText($oldPatchPath)
+    $patchPaths = @([regex]::Matches($oldPatchText, '(?m)^\+\+\+ b/(.+)\r?$') | ForEach-Object {
+        $_.Groups[1].Value.TrimEnd("`r")
+    })
+    if ($patchPaths.Count -ne 26) { throw 'Old patch restored file count differs' }
+    $oldFilePins = @(foreach ($path in $patchPaths) {
+        $fileBytes = [IO.File]::ReadAllBytes([IO.Path]::GetFullPath($path))
+        @{ path = [IO.Path]::GetFullPath($path); length = $fileBytes.Length
+            sha256 = Get-ByteDigest -Bytes $fileBytes
+            bom = [Convert]::ToHexString($fileBytes[0..([Math]::Min(2, $fileBytes.Length - 1))]) }
