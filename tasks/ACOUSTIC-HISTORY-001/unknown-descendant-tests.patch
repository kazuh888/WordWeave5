+﻿<#
+.SYNOPSIS
+    Tests the approved PSSA capture contract with fixed memory inputs
+.DESCRIPTION
+    OldRed extracts the saved assignment and catch without running PSSA.
+    Unit20 extracts only the collector's three private functions and state seed.
+    Candidate top-level code, real analyzer invocation and real learning data are never used.
+    Each phase requires an independently reviewed binding and parent freeze before execution.
+.PARAMETER BindingPath
+    Absolute path of the frozen phase-specific binding.
+.PARAMETER OutputRoot
+    New, isolated leaf below this packet's pssa-capture/out directory.
+.EXAMPLE
+    ./Test-PssaCapture.ps1 -BindingPath ./old-red-binding.json -OutputRoot ./out/old-red-UUID
+.NOTES
+    Author: CAP-T independent test author; Created: 2026-10-24
+    Requires: PowerShell 7.6.7 (ps7), PSScriptAnalyzer 1.25.0 types only
+    Exit: 0 = Unit20 accepted; 1 = specific OldRed accepted; 2 = any unexpected result
+    Fixed direct assertions follow the approved packet CLI; no Pester discovery or TestDrive is used.+#>
+#Requires -Version 7.6
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$BindingPath,
+    [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$OutputRoot
+)
+
+Set-StrictMode -Version 3.0
+$ErrorActionPreference = 'Stop'
+
+function Assert-CapCondition {
+    param([bool]$Condition, [string]$Message, [string]$Category = 'BehaviorMismatch')
+    if (-not $Condition) { throw ($Category + ': ' + $Message) }
+}
+
+function Get-CapHash {
+    param([byte[]]$Bytes)
+    return [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($Bytes))
+}
+
+function Test-CapKeys {
+    param([object]$Value, [object[]]$Keys, [string]$Label)
+    Assert-CapCondition ($Value -is [Collections.IDictionary]) ($Label + ' dictionary')
+    Assert-CapCondition ((@($Value.Keys | Sort-Object) -join ',') -ceq
+        (@($Keys | Sort-Object) -join ',')) ($Label + ' exact keys')
+}
+
+function Test-CapPins {
+    param([hashtable]$Binding)
+    foreach ($pin in $Binding.pins) {
+        $actual = (Get-FileHash -LiteralPath $pin.path -Algorithm SHA256).Hash
+        Assert-CapCondition ($actual -ceq $pin.sha256) ('pin drift: ' + $pin.path) 'AdapterFailure'
+        @{ path = $pin.path; sha256 = $actual }
+    }
+}
+
+function Get-CapAst {
+    param([string]$Text)
+    $tokens = $null
+    $parseErrors = $null
+    $ast = [Management.Automation.Language.Parser]::ParseInput($Text, [ref]$tokens, [ref]$parseErrors)
+    Assert-CapCondition (@($parseErrors).Count -eq 0) 'extract parser errors' 'AdapterFailure'
+    return $ast
+}
+
+function Get-CapOldAdapter {
+    param([hashtable]$Binding)
+    $saved = Get-Content -LiteralPath $Binding.oldSource.path -Raw -Encoding utf8 | ConvertFrom-Json -AsHashtable
+    $command = $saved.staticRequests.pssa.cmd
+    $utf8 = [Text.UTF8Encoding]::new($false)
+    Assert-CapCondition ((Get-CapHash $utf8.GetBytes($command)) -ceq $Binding.oldSource.commandSha256) `
+        'saved request command hash' 'AdapterFailure'
+    $ast = Get-CapAst $command
+    $tries = @($ast.FindAll({ param($node) $node -is [Management.Automation.Language.TryStatementAst] }, $true))
+    Assert-CapCondition ($tries.Count -eq 1) 'unique saved try/catch' 'AdapterFailure'
+    $tryText = $tries[0].Extent.Text
+    Assert-CapCondition ($tryText -ceq $Binding.oldSource.tryText) 'old try exact raw text' 'AdapterFailure'
+    $commands = @($tries[0].FindAll({
+        param($node)
+        $node -is [Management.Automation.Language.CommandAst] -and $node.GetCommandName() -ceq 'Invoke-ScriptAnalyzer'
+    }, $true))
+    Assert-CapCondition ($commands.Count -eq 1) 'one old analyzer producer' 'AdapterFailure'
+    $start = $commands[0].Extent.StartOffset - $tries[0].Extent.StartOffset
+    $length = $commands[0].Extent.EndOffset - $commands[0].Extent.StartOffset
+    $replacement = '& $producer -Context $context -ErrorAction Stop -ErrorVariable +engineErrors'
+    Assert-CapCondition ($replacement -ceq $Binding.oldSource.replacement) 'fixed sole replacement' 'AdapterFailure'
+    $adapted = $tryText.Substring(0, $start) + $replacement + $tryText.Substring($start + $length)
+    $reversed = $adapted.Substring(0, $start) + $commands[0].Extent.Text +
+        $adapted.Substring($start + $replacement.Length)
+    Assert-CapCondition ([Convert]::ToBase64String($utf8.GetBytes($reversed)) -ceq
+        [Convert]::ToBase64String($utf8.GetBytes($tryText))) 'old adapter reverse bytes' 'AdapterFailure'
+    Assert-CapCondition ((Get-CapHash $utf8.GetBytes($adapted)) -ceq $Binding.oldSource.adaptedSha256) `
+        'adapted statement hash' 'AdapterFailure'
+    $null = Get-CapAst $adapted
+    return [scriptblock]::Create($adapted)
+}
+
+function Get-CapCandidateSlices {
+    param([hashtable]$Binding)
+    $bytes = [IO.File]::ReadAllBytes($Binding.collector.path)
+    Assert-CapCondition ((Get-CapHash $bytes) -ceq $Binding.collector.sha256) 'collector full bytes' 'AdapterFailure'
+    $utf8 = [Text.UTF8Encoding]::new($false, $true)
+    $bomLength = if ($bytes.Length -ge 3 -and $bytes[0] -eq 239 -and $bytes[1] -eq 187 -and $bytes[2] -eq 191) { 3 } else { 0 }
+    $text = $utf8.GetString($bytes, $bomLength, $bytes.Length - $bomLength)
+    $ast = Get-CapAst $text
+    Assert-CapCondition ((@($Binding.collector.slices | Where-Object kind -CEQ Function |
+        ForEach-Object name | Sort-Object) -join ',') -ceq
+        'Add-PssaCaptureRecord,Complete-PssaCapture,Invoke-PssaCapturePipeline') 'fixed private function set' 'AdapterFailure'
+    $functionTexts = [Collections.Generic.List[string]]::new()
+    $seed = $null
+    foreach ($slice in $Binding.collector.slices) {
+        if ($slice.kind -ceq 'Function') {
+            $matches = @($ast.FindAll({
+                param($node)
+                $node -is [Management.Automation.Language.FunctionDefinitionAst] -and $node.Name -ceq $slice.name
+            }, $true))
+        }
+        elseif ($slice.kind -ceq 'State') {
+            $matches = @($ast.FindAll({
+                param($node)
+                $node -is [Management.Automation.Language.AssignmentStatementAst] -and
+                $node.Left -is [Management.Automation.Language.VariableExpressionAst] -and
+                $node.Left.VariablePath.UserPath -ceq 'state'
+            }, $true))
+        }
+        else { throw 'AdapterFailure: unknown slice kind' }
+        Assert-CapCondition ($matches.Count -eq 1) ('unique original slice ' + $slice.name) 'AdapterFailure'
+        $extent = $matches[0].Extent
+        Assert-CapCondition ($extent.StartOffset -eq $slice.startOffset -and $extent.EndOffset -eq $slice.endOffset) `
+            ('raw span ' + $slice.name) 'AdapterFailure'
+        $raw = $utf8.GetBytes($extent.Text)
+        Assert-CapCondition ((Get-CapHash $raw) -ceq $slice.sha256) ('raw hash ' + $slice.name) 'AdapterFailure'
+        Assert-CapCondition ([Convert]::ToBase64String($raw) -ceq $slice.rawBase64) `
+            ('raw bytes ' + $slice.name) 'AdapterFailure'
+        $reverseText = $text.Substring(0, $extent.StartOffset) + $utf8.GetString($raw) + $text.Substring($extent.EndOffset)
+        $reverseBytes = [byte[]](@($bytes | Select-Object -First $bomLength) + $utf8.GetBytes($reverseText))
+        Assert-CapCondition ([Convert]::ToBase64String($reverseBytes) -ceq [Convert]::ToBase64String($bytes)) `
+            ('full reverse bytes ' + $slice.name) 'AdapterFailure'
+        $forbidden = @($matches[0].FindAll({
+            param($node)
+            $node -is [Management.Automation.Language.CommandAst] -and $node.GetCommandName() -in @(
+                'Invoke-ScriptAnalyzer', 'Import-Module', 'Start-Process', 'Get-Process', 'Stop-Process',
+                'Get-CimInstance', 'Add-Type', 'Invoke-Expression', 'Invoke-WebRequest', 'Invoke-RestMethod',
+                'Set-Content', 'Add-Content', 'Out-File', 'Remove-Item', 'New-Item', 'Invoke-Command'
+            )
+        }, $true))
+        Assert-CapCondition ($forbidden.Count -eq 0) ('unsafe command in slice ' + $slice.name) 'AdapterFailure'
+        if ($slice.kind -ceq 'State') { $seed = $extent.Text }
+        else { $functionTexts.Add($extent.Text) }
+    }
+    Assert-CapCondition ($functionTexts.Count -eq 3 -and $null -ne $seed) 'three functions and state seed' 'AdapterFailure'
+    return @{ functions = ($functionTexts -join "`n"); seed = [scriptblock]::Create($seed) }
+}
+
+function New-CapError {
+    param([string]$Message = 'memory engine error', [string]$Id = 'CAP.Memory.Engine')
+    return [Management.Automation.ErrorRecord]::new([InvalidOperationException]::new($Message), $Id,
+        [Management.Automation.ErrorCategory]::InvalidOperation, $null)
+}
+
+function New-CapDiagnostic {
+    param([string]$Severity = 'Warning')
+    $tokens = $null
+    $errors = $null
+    $ast = [Management.Automation.Language.Parser]::ParseInput('1', [ref]$tokens, [ref]$errors)
+    $severityType = 'Microsoft.Windows.PowerShell.ScriptAnalyzer.Generic.DiagnosticSeverity' -as [type]
+    $recordType = 'Microsoft.Windows.PowerShell.ScriptAnalyzer.Generic.DiagnosticRecord' -as [type]
+    Assert-CapCondition ($null -ne $recordType -and $null -ne $severityType) 'real PSSA types loaded' 'AdapterFailure'
+    $level = [Enum]::Parse($severityType, $Severity, $false)
+    $diagnostic = [Activator]::CreateInstance($recordType,
+        [object[]]@('memory diagnostic', $ast.Extent, 'CAP.Memory.Rule', $level, 'memory-fixture.ps1', $null, $null))
+    Assert-CapCondition ($recordType.IsInstanceOfType($diagnostic)) 'actual DiagnosticRecord fixture' 'AdapterFailure'
+    return $diagnostic
+}
+
+function Invoke-CapOldRed {
+    param([hashtable]$Binding, [hashtable]$Expectations)
+    $adapter = Get-CapOldAdapter $Binding
+    $diagnostic = New-CapDiagnostic 'Warning'
+    $originalError = New-CapError
+    $context = @{ diagnostic = $diagnostic; error = $originalError; events = [Collections.Generic.List[string]]::new() }
+    $producer = {
+        [CmdletBinding()]
+        param([hashtable]$Context)
+        $Context.events.Add('Diagnostic')
+        Write-Output -NoEnumerate $Context.diagnostic
+        $Context.events.Add('Throw')
+        $PSCmdlet.ThrowTerminatingError($Context.error)
+    }
+    $diagnostics = @()
+    $engineErrors = @()
+    . $adapter
+    Assert-CapCondition (($context.events -join ',') -ceq 'Diagnostic,Throw') 'producer really emitted then threw' 'AdapterFailure'
+    Assert-CapCondition ($engineErrors.Count -ge 1) 'old catch/error path observed' 'AdapterFailure'
+    $related = @($engineErrors | Where-Object {
+        [object]::ReferenceEquals($_, $originalError) -or
+        [object]::ReferenceEquals($_.Exception, $originalError.Exception) -or
+        ($_.Exception -is [Management.Automation.ActionPreferenceStopException] -and
+         [object]::ReferenceEquals($_.Exception.ErrorRecord, $originalError))
+    })
+    Assert-CapCondition ($related.Count -ge 1) 'thrown original error reference observed' 'AdapterFailure'
+    Assert-CapCondition ($diagnostics.Count -eq $Expectations.oldRed.knownOldPrefixCount) `
+        'unexpected old outcome, not the specified RED' 'AdapterFailure'
+    try {
+        Assert-CapCondition ($diagnostics.Count -eq $Expectations.oldRed.expectedPrefixCount) `
+            'CAP-OLD-RED-01: retain diagnostic emitted before terminating error'
+    }
+    catch {
+        if ($_.Exception.Message -cne
+            'BehaviorMismatch: CAP-OLD-RED-01: retain diagnostic emitted before terminating error') { throw }
+        return @{
+            id = 'CAP-OLD-RED-01'; accepted = $true; classification = 'BehaviorRed-AssignmentLosesPrefix'
+            expectedPrefix = 1; actualPrefix = $diagnostics.Count; engineOccurrences = $engineErrors.Count
+            producerEvents = $context.events.ToArray(); originalErrorObserved = $true
+            assertionFailure = $_.Exception.Message; requestedExit = 1
+            originalNullReferenceReproduced = $false; actualPssaInvocations = 0; retry = 0
+        }
+    }
+    throw 'UnexpectedPass: old assignment retained the prefix; stop for independent assessment'
+}
+
+function New-CapFixture {
+    param([hashtable]$Row, [scriptblock]$Seed)
+    $memory = @{
+        tick = [long]0; calls = [Collections.Generic.List[hashtable]]::new()
+        files = @{}; partial = $null; error = (New-CapError); secondError = (New-CapError)
+        saveError = (New-CapError 'memory partial save error' 'CAP.Memory.Save')
+        events = [Collections.Generic.List[string]]::new(); followup = 'NotRun'
+    }
+    $now = { return [long]$memory.tick }.GetNewClosure()
+    $frequency = [long]1000
+    $inputStartTick = [long]0
+    $CollectionStartTick = [long]0
+    $targetPath = 'memory-fixture.ps1'
+    $OutputRoot = [IO.Path]::Combine($PSScriptRoot, 'out', 'memory-' + $Row.id)
+    $state = $null
+    . $Seed
+    Assert-CapCondition ($state -is [hashtable]) 'original state seed returned state' 'AdapterFailure'
+    Assert-CapCondition ([object]::ReferenceEquals($state.now, $now)) 'original seed bound memory clock' 'AdapterFailure'
+    foreach ($key in @('moduleReady', 'invokeStarted', 'invokeReturned', 'captureComplete',
+        'postBindingsMatched', 'savedWithinDeadline')) {
+        Assert-CapCondition ($state.flags[$key] -is [bool] -and -not $state.flags[$key]) `
+            ('initial false flag ' + $key) 'AdapterFailure'
+    }
+    foreach ($key in @('ordinary', 'engineOccurrences', 'engineGroups', 'unknown', 'signal', 'auxiliary')) {
+        Assert-CapCondition ($state.counts[$key] -is [int] -and $state.counts[$key] -eq 0) `
+            ('initial zero count ' + $key) 'AdapterFailure'
+    }
+    $diagnostic = New-CapDiagnostic $(if ($Row.ContainsKey('severity')) { $Row.severity } else { 'Warning' })
+    $context = @{ targetPath = $targetPath; diagnostic = $diagnostic; error = $memory.error
+        secondError = $memory.secondError; events = $memory.events; fixture = $Row.fixture }
+    $producer = {
+        [CmdletBinding()]
+        param([hashtable]$Context)
+        switch -CaseSensitive ($Context.fixture) {
+            'Diagnostic' { Write-Output -NoEnumerate $Context.diagnostic }
+            'DiagnosticThenThrow' {
+                $Context.events.Add('Diagnostic')
+                Write-Output -NoEnumerate $Context.diagnostic
+                $Context.events.Add('Throw')
+                $PSCmdlet.ThrowTerminatingError($Context.error)
+            }
+            'Nonterminating' { Write-Error -ErrorRecord $Context.error -ErrorAction Continue }
+            'DistinctErrorsSameText' {
+                Write-Output -NoEnumerate $Context.error
+                Write-Output -NoEnumerate $Context.secondError
+            }
+            'Unknown' { Write-Output -NoEnumerate ([pscustomobject]@{ marker = 'unknown' }) }
+            'ProjectionFailure' {
+                Write-Output -NoEnumerate $Context.diagnostic
+                Write-Output -NoEnumerate $Context.brokenRecord
+            }
+            'EngineThenPartialSave' { Write-Output -NoEnumerate $Context.error }
+            'RecordCountOverflow' {
+                foreach ($number in 1..257) { Write-Output -NoEnumerate $Context.diagnostic }
+            }
+            'VerboseThenWarning' {
+                Write-Output -NoEnumerate ([Management.Automation.VerboseRecord]::new('memory verbose'))
+                Write-Output -NoEnumerate ([Management.Automation.WarningRecord]::new('memory warning'))
+            }
+        }
+    }
+    if ($Row.fixture -ceq 'ProjectionFailure') {
+        $brokenRecord = [pscustomobject]@{ marker = 'throwing ToString' }
+        $brokenRecord | Add-Member -MemberType ScriptProperty -Name Value -Value { throw 'CAP.Memory.Getter' }
+        $brokenRecord | Add-Member -MemberType ScriptMethod -Name ToString -Force -Value { return [string]$this.Value }
+        $context.brokenRecord = $brokenRecord
+    }
+    $save = {
+        param([string]$AbsolutePath, [byte[]]$Bytes)
+        if (-not [IO.Path]::IsPathFullyQualified($AbsolutePath) -or
+            [IO.Path]::GetDirectoryName($AbsolutePath) -cne $OutputRoot -or
+            [IO.Path]::GetFileName($AbsolutePath) -cnotin @('raw.json', 'result.json') -or
+            $memory.files.ContainsKey($AbsolutePath)) { throw 'AdapterFailure: memory save boundary/CreateNew' }
+        $copy = [byte[]]$Bytes.Clone()
+        $memory.calls.Add(@{ path = $AbsolutePath; bytes = $copy; tick = $memory.tick })
+        if ($Row.fixture -ceq 'EngineThenPartialSave') {
+            $memory.partial = [byte[]]$copy[0..([Math]::Min(15, $copy.Length - 1))]
+            $memory.files[$AbsolutePath] = $memory.partial
+            throw $memory.saveError
+        }
+        $memory.files[$AbsolutePath] = $copy
+        if ($Row.fixture -ceq 'SaveReturnsAtDeadline' -and [IO.Path]::GetFileName($AbsolutePath) -ceq 'result.json') {
+            $memory.tick = [long]10000
+        }
+        return @{ path = $AbsolutePath; sha256 = (Get-CapHash $copy); length = [long]$copy.Length }
+    }.GetNewClosure()
+    return @{ state = $state; memory = $memory; context = $context; producer = $producer
+        save = $save; diagnostic = $diagnostic; row = $Row }
+}
+
+function Invoke-CapFixture {
+    param([hashtable]$Fixture)
+    $state = $Fixture.state
+    $row = $Fixture.row
+    # Only the driver-owned import/binding flags are set here. Pipeline flags remain exclusively original code.
+    if ($row.fixture -ceq 'ImportFailure') {
+        $null = Add-PssaCaptureRecord -State $state -Origin Import -Record $Fixture.memory.error
+    }
+    elseif ($row.fixture -ceq 'PreBindingMismatch') {
+        $state.missing.Add('PS/module/path/hash binding mismatch (memory)')
+    }
+    else {
+        $state.flags.moduleReady = $true
+        if ($row.fixture -cne 'NoNormalReturn') {
+            $pipelineOutput = @(Invoke-PssaCapturePipeline -State $state -Producer $Fixture.producer -Context $Fixture.context)
+            Assert-CapCondition ($pipelineOutput.Count -eq 0) 'pipeline output0'
+        }
+        $state.flags.postBindingsMatched = $row.fixture -cne 'PostBindingDrift'
+    }
+    if ($row.fixture -ceq 'InputDeadlineEqual') { $Fixture.memory.tick = [long]10000 }
+    if ($row.fixture -ceq 'CollectionDeadlineEqual') {
+        $state.inputStartTick = [long]29000
+        $Fixture.memory.tick = [long]30000
+    }
+    if ($row.fixture -ceq 'SaveReturnsAtDeadline') { $Fixture.memory.tick = [long]8000 }
+    return @(Complete-PssaCapture -State $state -Flags $state.flags -Now $state.now -Save $Fixture.save)
+}
+
+function Test-CapResult {
+    param([hashtable]$Fixture, [object[]]$Results, [hashtable]$Expectations)
+    $row = $Fixture.row
+    $expect = $row.expect
+    $state = $Fixture.state
+    $memory = $Fixture.memory
+    Assert-CapCondition ($Results.Count -eq 1) ($row.id + ': single unfiltered result')
+    $result = $Results[0]
+    Test-CapKeys $result $Expectations.resultKeys 'result'
+    Test-CapKeys $result.flags $Expectations.flagKeys 'flags'
+    Test-CapKeys $result.counts $Expectations.countKeys 'counts'
+    Assert-CapCondition (-not [object]::ReferenceEquals($result.flags, $state.flags) -and
+        -not [object]::ReferenceEquals($result.counts, $state.counts)) 'result flags/counts snapshots'
+    foreach ($flag in $Expectations.flagKeys) {
+        Assert-CapCondition ($result.flags[$flag] -is [bool]) ('bool flag ' + $flag)
+    }
+    foreach ($count in $Expectations.countKeys) {
+        Assert-CapCondition ($result.counts[$count] -is [int] -and $result.counts[$count] -ge 0) ('int32 count ' + $count)
+    }
+    $checked = [Collections.Generic.List[string]]::new()
+    foreach ($key in $expect.Keys) {
+        $value = $expect[$key]
+        $ok = switch -CaseSensitive ($key) {
+            'captureStatus' { $result.captureStatus -ceq $value }
+            'gateStatus' { $result.gateStatus -ceq $value }
+            'allFlags' { @($result.flags.Values | Where-Object { $_ -ne $true }).Count -eq 0 }
+            { $_ -cin $Expectations.countKeys } { $result.counts[$key] -eq $value }
+            { $_ -cin $Expectations.flagKeys } { $result.flags[$key] -eq $value }
+            'engineOccurrencesMin' { $result.counts.engineOccurrences -ge $value }
+            'rawCount' { $result.rawRecords.Count -eq $value }
+            'rawCountMin' { $result.rawRecords.Count -ge $value }
+            'origins' { ($result.rawRecords.origin -join ',') -ceq ($value -join ',') }
+            'kinds' { ($result.rawRecords.kind -join ',') -ceq ($value -join ',') }
+            'errorVariableMin' { @($result.rawRecords | Where-Object origin -CEQ ErrorVariable).Count -ge $value }
+            'catchCount' { @($result.rawRecords | Where-Object origin -CEQ Catch).Count -eq $value }
+            'originRequired' { @($result.rawRecords | Where-Object origin -CEQ $value).Count -ge 1 }
+            'linksCount' { $result.links.Count -eq $value }
+            'sameErrorReference' {
+                $state.recordRefs.Count -eq 2 -and [object]::ReferenceEquals($state.recordRefs[0], $state.recordRefs[1])
+            }
+            'distinctErrorReferences' {
+                $state.recordRefs.Count -eq 2 -and -not [object]::ReferenceEquals($state.recordRefs[0], $state.recordRefs[1])
+            }
+            'primaryIdentity' { [object]::ReferenceEquals($result.primaryError, $memory.error) }
+            'secondaryIdentity' {
+                @($result.secondaryErrors | Where-Object { [object]::ReferenceEquals($_, $memory.secondError) }).Count -ge 1
+            }
+            'saveErrorSecondary' {
+                @($result.secondaryErrors | Where-Object { [object]::ReferenceEquals($_, $memory.saveError) }).Count -ge 1
+            }
+            'diagnosticPreserved' {
+                $records = @($result.rawRecords | Where-Object kind -CEQ Diagnostic)
+                $records.Count -eq 1 -and $records[0].fields.Message -ceq 'memory diagnostic' -and
+                $records[0].fields.Severity -ceq $Fixture.diagnostic.Severity.ToString() -and
+                $records[0].fields.RuleName -ceq 'CAP.Memory.Rule' -and
+                $records[0].fields.ScriptPath -ceq 'memory-fixture.ps1' -and
+                $records[0].fields.StartLine -eq 1 -and $records[0].fields.StartColumn -eq 1 -and
+                $records[0].fields.EndLine -eq 1 -and $records[0].fields.EndColumn -eq 2 -and
+                [object]::ReferenceEquals($state.recordRefs[$records[0].seq - 1], $Fixture.diagnostic)
+            }
+            'engineReferenceLinked' { $result.links.Count -ge 1 -and $result.counts.engineGroups -eq 1 }
+            'missingMin' { $result.missing.Count -ge $value }
+            'prefixPreserved' {
+                $result.rawRecords.Count -ge 1 -and $result.rawRecords[0].kind -ceq 'Diagnostic' -and
+                [object]::ReferenceEquals($state.recordRefs[0], $Fixture.diagnostic)
+            }
+            'failedRecordReference' {
+                @($state.recordRefs | Where-Object { [object]::ReferenceEquals($_, $Fixture.context.brokenRecord) }).Count -ge 1
+            }
+            'partialPreserved' {
+                $null -ne $memory.partial -and $memory.partial.Length -gt 0 -and $memory.files.Count -eq 1 -and
+                [Convert]::ToBase64String($memory.files[$memory.calls[0].path]) -ceq [Convert]::ToBase64String($memory.partial)
+            }
+            'saveCalls' { $memory.calls.Count -eq $value }
+            'clockTick' { $memory.tick -eq $value }
+            'followup' { $memory.followup -ceq $value }
+            'overflow' { $result.overflow -eq $value }
+            'diskCandidateNotAcceptance' {
+                $diskResults = @($memory.calls | Where-Object { [IO.Path]::GetFileName($_.path) -ceq 'result.json' })
+                $diskResults.Count -eq 1 -and
+                ([Text.Encoding]::UTF8.GetString($diskResults[0].bytes) | ConvertFrom-Json -AsHashtable).gateCandidate -eq $true -and
+                $result.gateStatus -ceq 'FAIL' -and -not $result.flags.savedWithinDeadline
+            }
+            default { throw ('AdapterFailure: unconnected expectation key ' + $key) }
+        }
+        Assert-CapCondition ($ok -is [bool] -and $ok) ($row.id + ': expected ' + $key)
+        $checked.Add($key)
+    }
+    Assert-CapCondition ($checked.Count -eq $expect.Count) ($row.id + ': every expectation connected')
+    $sequence = 0
+    foreach ($record in $result.rawRecords) {
+        Test-CapKeys $record $Expectations.recordKeys 'raw record'
+        $sequence++
+        Assert-CapCondition ($record.seq -is [int] -and $record.seq -eq $sequence) 'raw consecutive sequence'
+        Assert-CapCondition ($record.origin -cin @('Pipeline', 'ErrorVariable', 'Catch', 'Import', 'Capture', 'Save')) 'raw origin'
+        Assert-CapCondition (-not [string]::IsNullOrEmpty($record.type)) 'real raw type name'
+        $fields = switch -CaseSensitive ($record.kind) {
+            'Diagnostic' { $Expectations.diagnosticFieldKeys }
+            'Engine' { $Expectations.errorFieldKeys }
+            'Auxiliary' { @('text') }
+            'Signal' { @('text') }
+            'Unknown' { @('text') }
+            default { throw 'BehaviorMismatch: unknown raw kind' }
+        }
+        Test-CapKeys $record.fields $fields 'typed scalar fields'
+    }
+    foreach ($link in $result.links) {
+        Test-CapKeys $link @('fromSeq', 'toSeq', 'relation') 'reference link'
+        Assert-CapCondition ($link.relation -cin @('SameRecord', 'SameException', 'StopWrapperRecord')) 'reference relation'
+        Assert-CapCondition ($link.fromSeq -ge 1 -and $link.toSeq -ge 1 -and
+            $link.fromSeq -le $state.recordRefs.Count -and $link.toSeq -le $state.recordRefs.Count -and
+            $link.fromSeq -ne $link.toSeq) 'link endpoints'
+        $a = $state.recordRefs[$link.fromSeq - 1]
+        $b = $state.recordRefs[$link.toSeq - 1]
+        $valid = switch -CaseSensitive ($link.relation) {
+            'SameRecord' { [object]::ReferenceEquals($a, $b) }
+            'SameException' { [object]::ReferenceEquals($a.Exception, $b.Exception) }
+            'StopWrapperRecord' {
+                ($a.Exception -is [Management.Automation.ActionPreferenceStopException] -and
+                    [object]::ReferenceEquals($a.Exception.ErrorRecord, $b)) -or
+                ($b.Exception -is [Management.Automation.ActionPreferenceStopException] -and
+                    [object]::ReferenceEquals($b.Exception.ErrorRecord, $a))
+            }
+        }
+        Assert-CapCondition $valid 'link backed by actual references'
+    }
+    foreach ($artifact in $result.artifacts) {
+        Test-CapKeys $artifact $Expectations.artifactKeys 'artifact'
+        Assert-CapCondition ($artifact.kind -cin @('Raw', 'Result') -and
+            $artifact.status -cin @('Saved', 'Incomplete')) 'artifact enums'
+        if ($artifact.status -ceq 'Saved') {
+            Assert-CapCondition ($memory.files.ContainsKey($artifact.path)) 'saved artifact exists in memory'
+            $bytes = $memory.files[$artifact.path]
+            Assert-CapCondition ($artifact.sha256 -ceq (Get-CapHash $bytes) -and $artifact.length -eq $bytes.Length) 'artifact bytes/hash'
+            $document = [Text.Encoding]::UTF8.GetString($bytes) | ConvertFrom-Json -AsHashtable
+            $keys = if ($artifact.kind -ceq 'Raw') { $Expectations.rawFileKeys } else { $Expectations.resultFileKeys }
+            Test-CapKeys $document $keys 'saved document'
+            Assert-CapCondition ($document.schemaVersion -eq 1 -and $document.targetPath -ceq $state.targetPath) 'saved schema/target'
+            if ($artifact.kind -ceq 'Raw') {
+                Assert-CapCondition ($bytes.Length -le 2MB) 'raw finite bytes'
+            }
+        }
+    }
+    if ($row.id -ceq 'C07') {
+        Assert-CapCondition (($memory.events -join ',') -ceq 'Diagnostic,Throw') 'C07 actual producer ordering'
+    }
+    Assert-CapCondition $state.finalized 'Complete finalized once'
+    return @{ id = $row.id; status = 'PASS'; checkedKeys = $checked.ToArray(); gateStatus = $result.gateStatus
+        captureStatus = $result.captureStatus; counts = $result.counts; flags = $result.flags }
+}
+
+function Invoke-CapUnit20 {
+    param([hashtable]$Binding, [hashtable]$Expectations)
+    $slices = Get-CapCandidateSlices $Binding
+    . ([scriptblock]::Create($slices.functions))
+    $rows = [Collections.Generic.List[hashtable]]::new()
+    $startTick = [Diagnostics.Stopwatch]::GetTimestamp()
+    $failed = $false
+    foreach ($row in $Expectations.cases) {
+        if ($failed) { $rows.Add(@{ id = $row.id; status = 'NotRun' }); continue }
+        $caseStart = [Diagnostics.Stopwatch]::GetTimestamp()
+        try {
+            Assert-CapCondition (([Diagnostics.Stopwatch]::GetTimestamp() - $startTick) /
+                [double][Diagnostics.Stopwatch]::Frequency -lt 30) 'unit collection deadline' 'Deadline'
+            $fixture = New-CapFixture $row $slices.seed
+            $actual = @(Invoke-CapFixture $fixture)
+            $result = Test-CapResult $fixture $actual $Expectations
+            Assert-CapCondition (([Diagnostics.Stopwatch]::GetTimestamp() - $caseStart) /
+                [double][Diagnostics.Stopwatch]::Frequency -lt 5) ($row.id + ': case deadline') 'Deadline'
+            Assert-CapCondition (([Diagnostics.Stopwatch]::GetTimestamp() - $startTick) /
+                [double][Diagnostics.Stopwatch]::Frequency -lt 30) 'unit collection deadline' 'Deadline'
+            $rows.Add($result)
+        }
+        catch {
+            $failed = $true
+            $rows.Add(@{ id = $row.id; status = 'Unexpected'; error = $_.Exception.Message })
+        }
+    }
+    return @{ accepted = (-not $failed); cases = $rows.ToArray(); retry = 0; actualPssaInvocations = 0
+        originalNullReferenceReproduced = $false; requestedExit = $(if ($failed) { 2 } else { 0 }) }
+}
+
+$requestedExit = 2
+$report = $null
+$outputCreated = $false
+try {
+    $binding = Get-Content -LiteralPath $BindingPath -Raw -Encoding utf8 | ConvertFrom-Json -AsHashtable
+    $bindingBeforeSha256 = (Get-FileHash -LiteralPath $BindingPath -Algorithm SHA256).Hash
+    Assert-CapCondition ($binding.phase -cin @('OldRed', 'Unit20')) 'phase binding' 'AdapterFailure'
+    Assert-CapCondition ($PSVersionTable.PSVersion.ToString() -ceq '7.6.7') 'PS7.6.7 required' 'AdapterFailure'
+    Assert-CapCondition ([IO.Path]::GetFullPath([Environment]::ProcessPath) -ieq
+        [IO.Path]::GetFullPath($binding.hostExecutable) -and
+        [IO.Path]::GetFullPath([Management.Automation.PSObject].Assembly.Location) -ieq
+        [IO.Path]::GetFullPath($binding.smaAssemblyPath)) 'loaded host and SMA paths' 'AdapterFailure'
+    Assert-CapCondition ([IO.Path]::GetFullPath((Get-Location).Path) -ieq [IO.Path]::GetFullPath($binding.cwd)) `
+        'frozen cwd' 'AdapterFailure'
+    $expectedParent = [IO.Path]::GetFullPath([IO.Path]::Combine($PSScriptRoot, 'out'))
+    Assert-CapCondition ([IO.Path]::IsPathFullyQualified($OutputRoot) -and
+        [IO.Path]::GetDirectoryName([IO.Path]::GetFullPath($OutputRoot)) -ieq $expectedParent -and
+        -not [IO.Directory]::Exists($OutputRoot) -and -not [IO.File]::Exists($OutputRoot) -and
+        [IO.Path]::GetFullPath($OutputRoot) -ieq [IO.Path]::GetFullPath($binding.outputRoot)) `
+        'new fixed isolated output leaf' 'AdapterFailure'
+    $ancestor = $expectedParent
+    while (-not [string]::IsNullOrEmpty($ancestor)) {
+        if ([IO.Directory]::Exists($ancestor)) {
+            Assert-CapCondition (([IO.File]::GetAttributes($ancestor) -band [IO.FileAttributes]::ReparsePoint) -eq 0) `
+                'output ancestor reparse point' 'AdapterFailure'
+        }
+        $ancestor = [IO.Path]::GetDirectoryName($ancestor)
+    }
+    $beforePins = @(Test-CapPins $binding)
+    $expectations = Get-Content -LiteralPath $binding.expectationsPath -Raw -Encoding utf8 | ConvertFrom-Json -AsHashtable
+    Assert-CapCondition ($expectations.cases.Count -eq 20 -and
+        (($expectations.cases.id -join ',') -ceq ((1..20 | ForEach-Object { 'C{0:D2}' -f $_ }) -join ','))) `
+        'fixed C01..C20 inventory' 'AdapterFailure'
+    $null = [IO.Directory]::CreateDirectory($OutputRoot)
+    $outputCreated = $true
+    Import-Module -Name $binding.moduleManifest -RequiredVersion 1.25.0 -ErrorAction Stop
+    $module = Get-Module -Name PSScriptAnalyzer
+    Assert-CapCondition ($module.Version.ToString() -ceq '1.25.0' -and
+        [IO.Path]::GetFullPath($module.ModuleBase) -ieq [IO.Path]::GetDirectoryName($binding.moduleManifest)) `
+        'loaded PSSA path/version' 'AdapterFailure'
+    $recordType = 'Microsoft.Windows.PowerShell.ScriptAnalyzer.Generic.DiagnosticRecord' -as [type]
+    Assert-CapCondition ($null -ne $recordType -and [IO.Path]::GetFullPath($recordType.Assembly.Location) -ieq
+        [IO.Path]::GetFullPath($binding.pssaAssemblyPath)) 'loaded PSSA type assembly path' 'AdapterFailure'
+    $phaseStart = [Diagnostics.Stopwatch]::GetTimestamp()
+    $report = if ($binding.phase -ceq 'OldRed') { Invoke-CapOldRed $binding $expectations }
+        else { Invoke-CapUnit20 $binding $expectations }
+    $limit = if ($binding.phase -ceq 'OldRed') { 5 } else { 30 }
+    Assert-CapCondition (([Diagnostics.Stopwatch]::GetTimestamp() - $phaseStart) /
+        [double][Diagnostics.Stopwatch]::Frequency -lt $limit) 'phase deadline' 'Deadline'
+    $afterPins = @(Test-CapPins $binding)
+    Assert-CapCondition ((Get-FileHash -LiteralPath $BindingPath -Algorithm SHA256).Hash -ceq $bindingBeforeSha256) `
+        'binding drift' 'AdapterFailure'
+    $report.phase = $binding.phase
+    $report.bindingSha256 = $bindingBeforeSha256
+    $report.beforePins = $beforePins
+    $report.afterPins = $afterPins
+    $report.argv = [Environment]::GetCommandLineArgs()
+    $report.preferences = @{ errorAction = [string]$ErrorActionPreference; verbose = [string]$VerbosePreference
+        debug = [string]$DebugPreference; warning = [string]$WarningPreference; information = [string]$InformationPreference }
+    $report.actualPS = $PSVersionTable.PSVersion.ToString()
+    $report.pssaVersion = $module.Version.ToString()
+    $requestedExit = $report.requestedExit
+}
+catch {
+    $report = @{ accepted = $false; classification = 'Unexpected'; error = $_.Exception.Message; requestedExit = 2 }
+    $requestedExit = 2
+}
+try {
+    if ($outputCreated) {
+        $bytes = [Text.UTF8Encoding]::new($false).GetBytes(($report | ConvertTo-Json -Depth 32))
+        $stream = [IO.File]::Open([IO.Path]::Combine($OutputRoot, 'unit-result.json'), [IO.FileMode]::CreateNew,
+            [IO.FileAccess]::Write, [IO.FileShare]::Read)
+        try { $stream.Write($bytes, 0, $bytes.Length) }
+        finally { $stream.Dispose() }
+    }
+}
+catch {
+    $report = @{ accepted = $false; classification = 'SaveFailure'; original = $report
+        secondaryError = $_.Exception.Message; requestedExit = 2 }
+    $requestedExit = 2
+}
+$report | ConvertTo-Json -Depth 32
+exit $requestedExit
