+﻿<#
+.SYNOPSIS
+    Classifies the one source-bound baseline deadline assertion
+.DESCRIPTION
+    Uses installed Pester 5.7.1 only. A single specific assertion failure returns 1.
+    Discovery, fixture, parser, extraction, timeout and any other failure return 2.
+    No target main, production port, native toolchain or real child operation is used.
+.EXAMPLE
+    ./Invoke-OldVersionRed.ps1
+.NOTES
+    Author: Codex U-M test author. Created: 2026-10-24.
+    Requires: PowerShell 7.6.7 (ps7), existing Pester 5.7.1, ordinary sandbox.
+    Exit 0 behavior matched; 1 BehaviorMismatch; 2 AdapterFailure. No retry.
+#>
+#Requires -Version 7.6
+[CmdletBinding()]
+param()
+Set-StrictMode -Version 3.0
+$ErrorActionPreference = 'Stop'
+$unitClock = [Diagnostics.Stopwatch]::StartNew()
+try {
+    if ($PSVersionTable.PSVersion.ToString() -cne '7.6.7') { throw 'AdapterFailure: runtime version' }
+    $modulePath = 'C:/Users/安井　一広/OneDrive/ドキュメント/WindowsPowerShell/Modules/Pester/5.7.1/Pester.psd1'
+    Import-Module -Name $modulePath -RequiredVersion 5.7.1 -ErrorAction Stop
+    $config = New-PesterConfiguration
+    $config.Run.Path = Join-Path $PSScriptRoot 'Old-VersionBoundary.Tests.ps1'
+    $config.Run.PassThru = $true
+    $config.Run.Exit = $false
+    $config.Run.Throw = $false
+    $config.Output.Verbosity = 'Detailed'
+    $config.TestResult.Enabled = $false
+    $config.CodeCoverage.Enabled = $false
+    $result = Invoke-Pester -Configuration $config
+    if ($unitClock.Elapsed.TotalSeconds -ge 5 -or $result.TotalCount -ne 1 -or
+        $result.FailedBlocksCount -ne 0 -or $result.FailedContainersCount -ne 0 -or
+        $result.SkippedCount -ne 0 -or $result.NotRunCount -ne 0 -or $result.InconclusiveCount -ne 0) {
+        throw 'AdapterFailure: result count, fixture failure or group deadline'
+    }
+    if ($result.PassedCount -eq 1 -and $result.FailedCount -eq 0) {
+        Write-Output 'BASELINE_RESULT:0;BehaviorMatched;input=G2-03;attempts=1;retry=0'
+        exit 0
+    }
+    if ($result.FailedCount -ne 1 -or @($result.Failed).Count -ne 1) { throw 'AdapterFailure: failed count' }
+    $failure = @($result.Failed[0].ErrorRecord)
+    $expectedAssertion = '$deadlineError | Should -Not -BeNullOrEmpty -Because ''deadline equality is expired under approved U-L contract'''
+    if ($failure.Count -ne 1 -or $failure[0].FullyQualifiedErrorId -cne 'PesterAssertionFailed' -or
+        $failure[0].TargetObject.LineText.Trim() -cne $expectedAssertion -or
+        [IO.Path]::GetFullPath($failure[0].TargetObject.File) -cne
+            [IO.Path]::GetFullPath((Join-Path $PSScriptRoot 'Old-VersionBoundary.Tests.ps1'))) {
+        throw 'AdapterFailure: failure is not the fixed deadline behavior assertion'
+    }
+    Write-Output 'BASELINE_RESULT:1;BehaviorMismatch;input=G2-03;attempts=1;retry=0'
+    exit 1
+}
+catch {
+    [Console]::Error.WriteLine(('BASELINE_RESULT:2;AdapterFailure;' + $_.Exception.Message))
+    exit 2
+}
