+}
+function Write-FirstFailureRecord {
+    param([string]$RunDirectory, [hashtable]$Record)
+    Test-Condition ([IO.Path]::IsPathFullyQualified($RunDirectory)) 'synthetic absolute writer context'
+    $script:WriterCalls++
+    $script:LastWriterRecord = $Record
+    throw [IO.IOException]::new('SYNTHETIC_WRITER_FAILURE')
+}
