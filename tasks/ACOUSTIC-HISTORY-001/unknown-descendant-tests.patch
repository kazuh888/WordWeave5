+                        'Category' { $observationValue.ToString() }
+                        'Int32' { [int]$observationValue }
+                        'String' { [string]$observationValue }
+                    }
+                    if ($null -eq $observationValue) { $observationMissing = 'Null' }
+                    elseif ($observationValue -is [string] -and $observationValue.Length -gt 8192) {
