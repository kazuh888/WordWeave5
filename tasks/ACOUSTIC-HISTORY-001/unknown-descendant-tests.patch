+    let mut bytes = vec![b'X'; 8193];
+    if bytes.len() > 8192 {
+        bytes = serialize("null", "TooLong");
+    }
+    bytes
+}
+  assert_sidecar(&encode_target_failure(7,TargetFailureStage::Observe,&literal),"Observe","Other",None,None,"TooLong")?;
+ }
+ println!("PASS:O4-8193");
+ for (id,fault,collision,expected_writes,expected_syncs,ok) in [
+  ("O4-writeok",WriteFault::None,false,1,1,true),
+  ("O4-collision",WriteFault::None,true,0,0,false),
+  ("O4-openfail",WriteFault::Open,false,0,0,false),
+  ("O4-writefail",WriteFault::Write,false,1,0,false),
+  ("O4-partial",WriteFault::Partial,false,1,0,false),
