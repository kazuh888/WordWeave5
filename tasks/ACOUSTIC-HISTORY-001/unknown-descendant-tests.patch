+        else {
+            try {
+                $writer.Flush()
+                $writer.BaseStream.Flush($true)
+            }
+            catch {
+                $streamFailures++
+                $taskProblems.Add('StreamSave: ' + $_.ToString())
+            }
+            finally {
+                try { $writer.Dispose() }
+                catch {
+                    $streamFailures++
+                    $taskProblems.Add('StreamClose: ' + $_.ToString())
+                }
+            }
+        }
+    }
+    $taskRecord.streamsSaved = $streamFailures -eq 0
+    $taskRecord.problems = @($taskProblems)
+}
