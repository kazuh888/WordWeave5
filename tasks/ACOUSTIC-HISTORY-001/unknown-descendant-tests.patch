+)
+$taskUtf8 = [Text.UTF8Encoding]::new($false, $true)
+$taskProblems = [Collections.Generic.List[string]]::new()
+$taskLines = [Collections.Generic.List[string]]::new()
+$taskClock = [Diagnostics.Stopwatch]::new()
