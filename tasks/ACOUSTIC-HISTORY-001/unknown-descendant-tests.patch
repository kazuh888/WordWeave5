+function Get-CapC16Adapter {
+    param([hashtable]$Spec, [ValidateSet('Collector', 'Caller')][string]$Kind)
+    Assert-CapCondition ($Spec.status -ceq 'Bound' -and $null -ne $Spec.sourceSha256 -and
+        $null -ne $Spec.parent -and $null -ne $Spec.span -and $null -ne $Spec.adapterSha256) `
+        ('C16 ' + $Kind + ' actual source/span pending') 'PendingBinding'
+    Assert-CapCondition ((Get-FileHash -LiteralPath $Spec.path -Algorithm SHA256).Hash -ceq
+        $Spec.sourceSha256) ('C16 ' + $Kind + ' source hash') 'AdapterFailure'
+    $text = [IO.File]::ReadAllText($Spec.path)
+    if ($Kind -ceq 'Caller') {
+        $receipt = ConvertFrom-Json -InputObject $text -AsHashtable
+        $text = $receipt.request.cmd
+        Assert-CapCondition ((Get-CapHash ([Text.Encoding]::UTF8.GetBytes($text))) -ceq
+            $Spec.commandSha256) 'C16 actual CAP-V request command hash' 'AdapterFailure'
+    }
+    $ast = Get-CapAst $text
+    $parents = @($ast.FindAll({
+        param($node)
+        $node -is [Management.Automation.Language.NamedBlockAst] -or
+        $node -is [Management.Automation.Language.StatementBlockAst]
+    }, $true) | Where-Object {
+        $_.GetType().FullName -ceq $Spec.parent.type -and
+        $_.Extent.StartOffset -eq $Spec.parent.charStart -and $_.Extent.EndOffset -eq $Spec.parent.charEnd
+    })
+    Assert-CapCondition ($parents.Count -eq 1) ('C16 unique actual parent ' + $Kind) 'AdapterFailure'
+    $statements = @($parents[0].Statements | Where-Object {
+        $_.Extent.StartOffset -ge $Spec.span.charStart -and $_.Extent.EndOffset -le $Spec.span.charEnd
+    })
+    $count = if ($Kind -ceq 'Collector') { 3 } else { 4 }
+    Assert-CapCondition ($statements.Count -eq $count -and
+        $statements[0].Extent.StartOffset -eq $Spec.span.charStart -and
+        $statements[-1].Extent.EndOffset -eq $Spec.span.charEnd) 'C16 exact consecutive statements' 'AdapterFailure'
+    $raw = $text.Substring($Spec.span.charStart, $Spec.span.charEnd - $Spec.span.charStart)
+    Assert-CapCondition ($raw -ceq $Spec.span.raw -and
+        (Get-CapHash ([Text.Encoding]::UTF8.GetBytes($raw))) -ceq $Spec.span.sha256) `
+        'C16 actual source span bytes' 'AdapterFailure'
+    $guard = $statements[1]
+    Assert-CapCondition ($guard -is [Management.Automation.Language.IfStatementAst] -and
+        $guard.Clauses.Count -eq 1 -and $null -eq $guard.ElseClause -and
+        $guard.Clauses[0].Item2.Statements.Count -eq 1 -and
+        $guard.Clauses[0].Item2.Statements[0] -is [Management.Automation.Language.ExitStatementAst] -and
+        $statements[-1] -is [Management.Automation.Language.ExitStatementAst]) `
+        'C16 original single exit guard' 'AdapterFailure'
+    $condition = if ($Kind -ceq 'Collector') { '$captureResult.gateStatus -ceq ''PASS''' }
+        else { '$LASTEXITCODE -ne 0' }
+    Assert-CapCondition ($guard.Clauses[0].Item1.Extent.Text -ceq $condition) `
+        'C16 original guard condition' 'AdapterFailure'
+    if ($Kind -ceq 'Collector') {
+        Assert-CapCondition ($statements[0].Extent.Text -ceq
+            '$captureResult = Complete-PssaCapture -State $state -Flags $state.flags -Now $now -Save $save') `
+            'C16 original Complete statement' 'AdapterFailure'
+    }
+    $spanAst = Get-CapAst $raw
+    $exits = @($spanAst.FindAll({
+        param($node)
+        $node -is [Management.Automation.Language.ExitStatementAst]
+    }, $true))
+    Assert-CapCondition ($exits.Count -eq 2 -and
+        $exits[0].Pipeline.Extent.Text -ceq $(if ($Kind -ceq 'Collector') { '0' } else { '2' }) -and
+        $exits[1].Pipeline.Extent.Text -ceq $(if ($Kind -ceq 'Collector') { '2' } else { '$LASTEXITCODE' })) `
+        'C16 exactly two original exit expressions' 'AdapterFailure'
+    $replacements = [Collections.Generic.List[hashtable]]::new()
+    foreach ($exitNode in $exits) {
+        $replacements.Add(@{ start = $exitNode.Extent.StartOffset
+            length = $exitNode.Extent.EndOffset - $exitNode.Extent.StartOffset
+            original = $exitNode.Extent.Text; replacement = ('& $exitProbe (' + $exitNode.Pipeline.Extent.Text + ')') })
+    }
+    if ($Kind -ceq 'Caller') {
+        foreach ($pair in @(@{ index = 0; role = 'Collector'; replacement = '$LASTEXITCODE = & $collectorCall' },
+            @{ index = 2; role = 'Assertions'; replacement = '& $assertionsCall' })) {
+            $commands = @($statements[$pair.index].FindAll({
+                param($node)
+                $node -is [Management.Automation.Language.CommandAst]
+            }, $true))
+            Assert-CapCondition ($commands.Count -eq 1) 'C16 one original target command' 'AdapterFailure'
+            $command = $commands[0]
+            $commandSpec = $Spec.commands[$pair.role]
+            Assert-CapCondition ($command.Extent.Text -ceq $commandSpec.raw -and
+                (Get-CapHash ([Text.Encoding]::UTF8.GetBytes($command.Extent.Text))) -ceq $commandSpec.sha256) `
+                ('C16 pinned full original argv ' + $pair.role) 'AdapterFailure'
+            $parameters = @($command.CommandElements)
+            $roleParameters = @($parameters | Where-Object {
+                $_ -is [Management.Automation.Language.CommandParameterAst] -and $_.ParameterName -ceq 'TargetRole'
+            })
+            Assert-CapCondition ($roleParameters.Count -eq 1) 'C16 one TargetRole' 'AdapterFailure'
+            $roleIndex = [Array]::IndexOf($parameters, $roleParameters[0])
+            Assert-CapCondition ($roleIndex + 1 -lt $parameters.Count -and
+                $parameters[$roleIndex + 1].Extent.Text -ceq $pair.role) 'C16 actual TargetRole argv' 'AdapterFailure'
+            $replacements.Add(@{ start = $command.Extent.StartOffset - $Spec.span.charStart
+                length = $command.Extent.EndOffset - $command.Extent.StartOffset
+                original = $command.Extent.Text; replacement = $pair.replacement })
+        }
+    }
+    $adapted = $raw
+    foreach ($replacement in @($replacements | Sort-Object start -Descending)) {
+        Assert-CapCondition ($raw.Substring($replacement.start, $replacement.length) -ceq
+            $replacement.original) 'C16 replacement source bytes' 'AdapterFailure'
+        $adapted = $adapted.Substring(0, $replacement.start) + $replacement.replacement +
+            $adapted.Substring($replacement.start + $replacement.length)
+    }
+    foreach ($replacement in $replacements) {
+        $delta = 0
+        foreach ($earlier in $replacements) {
+            if ($earlier.start -lt $replacement.start) { $delta += $earlier.replacement.Length - $earlier.length }
+        }
+        $replacement.adaptedStart = $replacement.start + $delta
+    }
+    $inverse = $adapted
+    foreach ($replacement in @($replacements | Sort-Object adaptedStart -Descending)) {
+        $inverse = $inverse.Substring(0, $replacement.adaptedStart) + $replacement.original +
+            $inverse.Substring($replacement.adaptedStart + $replacement.replacement.Length)
+    }
+    Assert-CapCondition ([Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($inverse)) -ceq
+        [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($raw))) 'C16 inverse full span bytes' 'AdapterFailure'
+    Assert-CapCondition ((Get-CapHash ([Text.Encoding]::UTF8.GetBytes($adapted))) -ceq
+        $Spec.adapterSha256) 'C16 generated adapter hash' 'AdapterFailure'
+    $null = Get-CapAst $adapted
+    return @{ script = [scriptblock]::Create($adapted); replacements = $replacements.ToArray()
+        sourceSpanSha256 = $Spec.span.sha256; adapterSha256 = $Spec.adapterSha256 }
+}
