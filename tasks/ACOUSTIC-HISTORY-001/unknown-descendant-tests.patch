+ match result {
+  Ok(count)=>{println!("CASE_PASS:{case}:inputs={count}");std::process::exit(0);},
+  Err(message)=>{
+   eprintln!("FAIL:{case}:{message}; firstUnexpected; remaining inputs NotRun");
