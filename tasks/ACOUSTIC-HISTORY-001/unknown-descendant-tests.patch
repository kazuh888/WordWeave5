+            throw 'Result ancestor missing or reparse'
+        }
+        $ancestor = $ancestor.Parent
+    }
+    $taskRecord.before = @(Get-PreparationPin)
+    $null = New-Item -ItemType Directory -Path $taskOutputRoot -ErrorAction Stop
+    $taskCreated = $true
+    $taskOut = [IO.StreamWriter]::new([IO.File]::Open((Join-Path $taskOutputRoot 'stdout.txt'), 'CreateNew'), $taskUtf8)
+    $taskErr = [IO.StreamWriter]::new([IO.File]::Open((Join-Path $taskOutputRoot 'stderr.txt'), 'CreateNew'), $taskUtf8)
