+    }
+    foreach ($pin in $taskFixed) {
+        $actual = (Get-FileHash -LiteralPath $pin.path).Hash
+        if ($actual -cne $pin.hash) { throw ('Input drift: ' + $pin.path) }
+        @{ path = [IO.Path]::GetFullPath($pin.path); sha256 = $actual }
+    }
+}
