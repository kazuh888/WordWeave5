--- /dev/null
+++ b/target/early-trial-build/et3/cargo-gate/verification/argv-path01/6201d237-1221-492b-8858-5c8f4c5f7d23/Old-VersionBoundary.Tests.ps1
@@ -0,0 +1,89 @@
+﻿<#
+.SYNOPSIS
+    Reproduces the old preparation version deadline behavior in memory
+.DESCRIPTION
+    Executes exactly two uniquely pinned baseline statements, not the source script.
+    The executable variable is a memory-only scriptblock. No native tool, probe main,
+    production port, OS ownership, compilation or real child process is reached.
+    This is one baseline subset of G2-03, not an additional candidate input.
+.EXAMPLE
+    Import-Module Pester -RequiredVersion 5.7.1
+    Invoke-Pester -Path ./Old-VersionBoundary.Tests.ps1 -Output Detailed
+.NOTES
+    Author: Codex U-M test author. Created: 2026-10-24.
+    Requires: PowerShell 7.6.7 (ps7), installed Pester 5.7.1 only; ordinary sandbox.
+    Not executed by author. The expected RED is a missing deadline error after a valid adapter.
+    Parser/extraction/fixture failure is AdapterFailure and must never count as RED.
+#>
+#Requires -Version 7.6
+[CmdletBinding()]
+param()
+
+BeforeAll {
+    Set-StrictMode -Version 3.0
+    $ErrorActionPreference = 'Stop'
+    $script:Binding = Get-Content -LiteralPath (Join-Path $PSScriptRoot 'baseline-binding.json') -Raw -Encoding utf8 |
+        ConvertFrom-Json -AsHashtable
+    $sourcePath = Join-Path $PSScriptRoot 'before/Invoke-FirstFailureEnv01.ps1'
+    if ((Get-FileHash -LiteralPath $sourcePath).Hash -cne $script:Binding.sha256) {
+        throw 'AdapterFailure: baseline hash'
+    }
+    $span = @($script:Binding.spans | Where-Object id -CEQ 'BaselineVersion')
+    if ($span.Count -ne 1 -or $span[0].allowedSubstitutions.Count -ne 0 -or -not $span[0].inverseFullBytes) {
+        throw 'AdapterFailure: baseline version span metadata'
+    }
+    $bytes = [IO.File]::ReadAllBytes($sourcePath)
+    $raw = $bytes[$span[0].byteOffset..($span[0].byteOffset + $span[0].byteLength - 1)]
+    if ([Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($raw)) -cne $span[0].sha256) {
+        throw 'AdapterFailure: baseline raw span'
+    }
+    $sourceText = [Text.UTF8Encoding]::new($false, $true).GetString($raw)
+    if ($sourceText -cne $span[0].original) { throw 'AdapterFailure: original text' }
+    $tokens = $null
+    $errors = $null
+    $ast = [Management.Automation.Language.Parser]::ParseInput($sourceText, [ref]$tokens, [ref]$errors)
+    if ($errors.Count -ne 0 -or $ast.EndBlock.Statements.Count -ne 2) {
+        throw 'AdapterFailure: extracted parser/statement count'
+    }
+    $commands = @($ast.FindAll({
+        param($node)
+        $node -is [Management.Automation.Language.CommandAst]
+    }, $true))
+    if ($commands.Count -ne 1 -or $commands[0].Extent.Text -cne '& $rustc --version' -or
+        $commands[0].InvocationOperator -cne 'Ampersand') {
+        throw 'AdapterFailure: extracted command boundary'
+    }
+    if (@($ast.FindAll({
+        param($node)
+        $node -is [Management.Automation.Language.InvokeMemberExpressionAst] -or
+        $node -is [Management.Automation.Language.FileRedirectionAst]
+    }, $true)).Count -ne 0) { throw 'AdapterFailure: external boundary in extracted source' }
+    $script:VersionStatements = [scriptblock]::Create($sourceText)
+}
+
+Describe 'G2-03 baseline version delayed return' {
+    It 'rejects success returned at the 2000ms version deadline' {
+        $memory = @{ now = 0L; phaseDeadline = 2000L; calls = 0; argv = @(); productionCalls = 0 }
+        # This is the entire unsafe boundary. It cannot reference any external executable.
+        $rustc = {
+            param([string]$VersionArgument)
+            $memory.calls++
+            $memory.argv = @($VersionArgument)
+            $memory.now = 2000L
+            return 'memory rustc version'
+        }.GetNewClosure()
+        if ($rustc -isnot [scriptblock]) { throw 'AdapterFailure: executable is not a memory scriptblock' }
+        $LASTEXITCODE = 0
+        $deadlineError = $null
+        $clock = [Diagnostics.Stopwatch]::StartNew()
+        try { . $script:VersionStatements }
+        catch { $deadlineError = $_ }
+        if ($memory.calls -ne 1 -or ($memory.argv -join ',') -cne '--version' -or
+            $memory.now -ne 2000 -or $memory.productionCalls -ne 0 -or $clock.Elapsed.TotalSeconds -ge 5) {
+            throw 'AdapterFailure: memory boundary or group budget'
+        }
+        # The source accepted the delayed exit0. This null is the expected behavior failure.
+        # No missing future helper is involved; the original two statements parsed and completed.
+        $deadlineError | Should -Not -BeNullOrEmpty -Because 'deadline equality is expired under approved U-L contract'
+    }
+}
