+$report.elapsedBeforeSave = ([Diagnostics.Stopwatch]::GetTimestamp() - $CollectionStartTick) /
+    [double][Diagnostics.Stopwatch]::Frequency
+try {
+    if ($outputCreated) {
+        Assert-BfClock
+        $bytes = [Text.UTF8Encoding]::new($false).GetBytes((ConvertTo-Json -InputObject $report -Depth 32))
+        $path = [IO.Path]::Combine($OutputRoot, 'focused-result.json')
+        $stream = [IO.File]::Open($path, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::Read)
+        try { $stream.Write($bytes, 0, $bytes.Length) }
+        finally { $stream.Dispose() }
+        $saved = @{ path = $path; length = $bytes.Length
+            sha256 = [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($bytes)) }
+        Assert-BfClock $lastInputStart
+    }
+}
+catch {
+    $saveFailure = $_
+    $originalFailure = if ($report.ContainsKey('failure')) { $report.failure } else { $null }
+    $report.saveOrFinalClockFailure = @{ error = $saveFailure.Exception.Message; originalFailure = $originalFailure }
+    $requestedExit = 2
+}
+@{ schemaVersion = 1; requestedExit = $requestedExit; saved = $saved; reportCandidate = $report
+    elapsedIncludingSave = ([Diagnostics.Stopwatch]::GetTimestamp() - $CollectionStartTick) /
+        [double][Diagnostics.Stopwatch]::Frequency; retry = 0
+    finalAcceptanceRequiresActualExitAndOuterClock = $true } | ConvertTo-Json -Depth 40
+exit $requestedExit
