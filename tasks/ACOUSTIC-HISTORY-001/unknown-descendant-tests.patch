+function Invoke-CapC16Adapter {
+    param([hashtable]$Fixture)
+    Assert-CapCondition ($Fixture.ContainsKey('c16Binding')) 'C16 actual binding pending' 'PendingBinding'
+    $binding = $Fixture.c16Binding
+    Assert-CapCondition ($binding.status -ceq 'Bound') 'C16 actual C/caller pending' 'PendingBinding'
+    $collector = Get-CapC16Adapter $binding.collector 'Collector'
+    $caller = Get-CapC16Adapter $binding.caller 'Caller'
+    $ledger = @{ CollectorCalls = 0; AssertionsCalls = 0
+        exits = [Collections.Generic.List[hashtable]]::new(); captureResult = $null }
+    $exitSentinel = [InvalidOperationException]::new('CAP.C16.PrivateExit')
+    $exitProbe = {
+        param([int]$Code)
+        $ledger.exits.Add(@{ stage = $probeStage; code = $Code })
+        if ($probeStage -ceq 'Collector') {
+            $ledger.captureResult = Get-Variable -Name captureResult -Scope 1 -ValueOnly -ErrorAction Stop
+            Assert-CapCondition ($ledger.captureResult -is [hashtable]) 'C16 real Complete reference' 'AdapterFailure'
+        }
+        throw $exitSentinel
+    }
+    $collectorCall = {
+        $ledger.CollectorCalls++
+        $state = $Fixture.state
+        $now = $state.now
+        $save = $Fixture.save
+        $probeStage = 'Collector'
+        try {
+            . $collector.script
+            throw 'AdapterFailure: C16 collector returned without exit'
+        }
+        catch {
+            $exception = $_.Exception
+            if (-not ([object]::ReferenceEquals($exception, $exitSentinel) -or
+                [object]::ReferenceEquals($exception.InnerException, $exitSentinel))) {
+                throw [InvalidOperationException]::new('AdapterFailure: C16 collector exception', $exception)
+            }
+            Assert-CapCondition ($ledger.exits.Count -eq 1 -and
+                $ledger.exits[0].stage -ceq 'Collector') 'C16 collector exit ledger' 'AdapterFailure'
+            return $ledger.exits[0].code
+        }
+    }
+    $assertionsCall = { $ledger.AssertionsCalls++ }
+    $callerScope = {
+        $previousLastExit = Get-Variable -Name LASTEXITCODE -Scope Local -ErrorAction SilentlyContinue
+        $probeStage = 'Caller'
+        try {
+            . $caller.script
+            throw 'AdapterFailure: C16 caller returned without exit'
+        }
+        finally {
+            if ($null -ne $previousLastExit) { $LASTEXITCODE = $previousLastExit.Value }
+            else { Remove-Variable -Name LASTEXITCODE -Scope Local -ErrorAction SilentlyContinue }
+        }
+    }
+    try { & $callerScope }
+    catch {
+        $exception = $_.Exception
+        if (-not ([object]::ReferenceEquals($exception, $exitSentinel) -or
+            [object]::ReferenceEquals($exception.InnerException, $exitSentinel))) {
+            throw [InvalidOperationException]::new('AdapterFailure: C16 caller exception', $exception)
+        }
+    }
+    Assert-CapCondition ($ledger.CollectorCalls -eq 1 -and $ledger.AssertionsCalls -eq 0 -and
+        $ledger.exits.Count -eq 2 -and $ledger.exits[0].stage -ceq 'Collector' -and
+        $ledger.exits[0].code -eq 2 -and $ledger.exits[1].stage -ceq 'Caller' -and
+        $ledger.exits[1].code -eq 2 -and $ledger.captureResult -is [hashtable] -and
+        $ledger.captureResult.gateStatus -ceq 'FAIL') 'C16 actual driver/caller stop ledger'
+    $Fixture.memory.c16Ledger = $ledger
+    $Fixture.memory.followup = 'NotRun'
+    return $ledger.captureResult
+}
