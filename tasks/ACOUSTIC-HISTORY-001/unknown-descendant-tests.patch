+﻿<#
+.SYNOPSIS
+    Runs six fixed CAP-BF reference cases before one separately counted OldRed.
+.DESCRIPTION
+    Extracts the exact predicate and foreach source spans. No duplicate predicate,
+    analyzer invocation, OS process fixture or Unit20 is executed.
+.PARAMETER BindingPath
+    Absolute independently frozen BF execution binding.
+.PARAMETER OutputRoot
+    New fixed focused-report leaf.
+.PARAMETER CollectionStartTick
+    Original same-shell Stopwatch start; never reset between focused cases and OldRed.
+.EXAMPLE
+    ./Test-PssaReferenceFocus.ps1 -BindingPath ./execution-binding.json -OutputRoot ./out/focus-UUID -CollectionStartTick 1
+.NOTES
+    Requires: PowerShell 7.6.7 (ps7). Fixed direct packet assertions, no framework/module.
+    Exit 1: six contracts passed and original specific RED accepted within clocks.
+    Exit 2: any fixture/adapter/behavior/pin/save/deadline failure; no retry.
+#>
+#Requires -Version 7.6
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$BindingPath,
+    [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$OutputRoot,
+    [Parameter(Mandatory)][ValidateRange(1, [long]::MaxValue)][long]$CollectionStartTick
+)
+Set-StrictMode -Version 3.0
+$ErrorActionPreference = 'Stop'
+
+function Assert-Bf {
+    param([bool]$Condition, [string]$Message, [string]$Category = 'BehaviorMismatch')
+    if (-not $Condition) { throw ($Category + ': ' + $Message) }
+}
+function Test-BfPins {
+    param([object[]]$Pins)
+    foreach ($pin in $Pins) {
+        $actual = (Get-FileHash -LiteralPath $pin.path -Algorithm SHA256).Hash
+        Assert-Bf ($actual -ceq $pin.sha256) ('pin drift ' + $pin.path) 'AdapterFailure'
+        @{ path = $pin.path; sha256 = $actual }
+    }
+}
+function Assert-BfClock {
+    param([long]$InputStart = 0)
+    $now = [Diagnostics.Stopwatch]::GetTimestamp()
+    $frequency = [double][Diagnostics.Stopwatch]::Frequency
+    Assert-Bf (($now - $CollectionStartTick) / $frequency -lt 30) 'common collection deadline' 'Deadline'
+    if ($InputStart -gt 0) {
+        Assert-Bf (($now - $InputStart) / $frequency -lt 5) 'input deadline' 'Deadline'
+    }
+}
+function New-BfError {
+    return [Management.Automation.ErrorRecord]::new([InvalidOperationException]::new('CAP-BF same message'),
+        'CAP-BF.SameId', [Management.Automation.ErrorCategory]::InvalidOperation, $null)
+}
+$rows = [Collections.Generic.List[hashtable]]::new()
+$report = @{ schemaVersion = 1; candidateOnly = $true; cases = @(); oldRed = @{ status = 'NotRun' }
+    retry = 0; actualPssaInvocations = 0; collectionStartTick = $CollectionStartTick
+    actualArgv = [Environment]::GetCommandLineArgs(); actualPS = $PSVersionTable.PSVersion.ToString() }
+$requestedExit = 2
+$outputCreated = $false
+$lastInputStart = [long]0
+$saved = $null
+try {
+    Assert-BfClock
+    $bindingBefore = (Get-FileHash -LiteralPath $BindingPath -Algorithm SHA256).Hash
+    $binding = Get-Content -LiteralPath $BindingPath -Raw -Encoding utf8 | ConvertFrom-Json -AsHashtable
+    Assert-Bf ($binding.phase -ceq 'CAP-BF-Focus6ThenOldRed') 'fixed phase' 'AdapterFailure'
+    Assert-Bf ($PSVersionTable.PSVersion.ToString() -ceq '7.6.7' -and
+        [IO.Path]::GetFullPath([Environment]::ProcessPath) -ieq
+        [IO.Path]::GetFullPath($binding.hostExecutable)) 'fixed host/runtime' 'AdapterFailure'
+    Assert-Bf ([IO.Path]::GetFullPath((Get-Location).Path) -ieq
+        [IO.Path]::GetFullPath($binding.cwd)) 'cwd' 'AdapterFailure'
+    $expectedParent = [IO.Path]::GetFullPath([IO.Path]::Combine($PSScriptRoot, 'out'))
+    Assert-Bf ([IO.Path]::IsPathFullyQualified($OutputRoot) -and
+        [IO.Path]::GetFullPath($OutputRoot) -ieq [IO.Path]::GetFullPath($binding.outputRoot) -and
+        [IO.Path]::GetDirectoryName([IO.Path]::GetFullPath($OutputRoot)) -ieq $expectedParent -and
+        -not [IO.Directory]::Exists($OutputRoot) -and -not [IO.File]::Exists($OutputRoot) -and
+        -not [IO.Directory]::Exists($binding.oldRedOutputRoot) -and
+        -not [IO.File]::Exists($binding.oldRedOutputRoot)) 'new fixed output leaves' 'AdapterFailure'
+    $ancestor = $expectedParent
+    while (-not [string]::IsNullOrEmpty($ancestor)) {
+        if ([IO.Directory]::Exists($ancestor)) {
+            Assert-Bf (([IO.File]::GetAttributes($ancestor) -band [IO.FileAttributes]::ReparsePoint) -eq 0) `
+                'output ancestor reparse point' 'AdapterFailure'
+        }
+        $ancestor = [IO.Path]::GetDirectoryName($ancestor)
+    }
+    $report.beforePins = @(Test-BfPins $binding.pins)
+    $expectations = Get-Content -LiteralPath $binding.expectationsPath -Raw -Encoding utf8 | ConvertFrom-Json -AsHashtable
+    Assert-Bf (($expectations.cases.id -join ',') -ceq 'F1,F2,F3,F4,F5,F6') 'fixed six cases' 'AdapterFailure'
+    $source = [IO.File]::ReadAllText($binding.sourcePath)
+    $tokens = $null
+    $parseErrors = $null
+    $ast = [Management.Automation.Language.Parser]::ParseInput($source, [ref]$tokens, [ref]$parseErrors)
+    Assert-Bf (@($parseErrors).Count -eq 0) 'source parser' 'AdapterFailure'
+    $functions = @($ast.FindAll({
+        param($node)
+        $node -is [Management.Automation.Language.FunctionDefinitionAst] -and $node.Name -ceq 'Invoke-CapOldRed'
+    }, $true))
+    Assert-Bf ($functions.Count -eq 1) 'one source function' 'AdapterFailure'
+    $statements = @($functions[0].Body.EndBlock.Statements)
+    $found = [Collections.Generic.List[object]]::new()
+    foreach ($slice in $binding.slices) {
+        $matches = @($statements | Where-Object {
+            $_ -is [Management.Automation.Language.AssignmentStatementAst] -and
+            $_.Left -is [Management.Automation.Language.VariableExpressionAst] -and
+            $_.Left.VariablePath.UserPath -ceq $slice.name
+        })
+        Assert-Bf ($matches.Count -eq 1) ('unique assignment ' + $slice.name) 'AdapterFailure'
+        $extent = $matches[0].Extent
+        $rawBytes = [Text.Encoding]::UTF8.GetBytes($extent.Text)
+        Assert-Bf ($extent.StartOffset -eq $slice.charStart -and $extent.EndOffset -eq $slice.charEnd -and
+            $extent.Text -ceq $slice.raw -and
+            [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($rawBytes)) -ceq $slice.sha256) `
+            ('raw original span ' + $slice.name) 'AdapterFailure'
+        $found.Add($matches[0])
+    }
+    Assert-Bf ($found.Count -eq 2 -and $binding.slices[0].name -ceq 'isRelatedEntry' -and
+        $binding.slices[1].name -ceq 'related') 'fixed two spans' 'AdapterFailure'
+    $firstIndex = [Array]::IndexOf($statements, $found[0])
+    Assert-Bf ($firstIndex -ge 0 -and [object]::ReferenceEquals($statements[$firstIndex + 1], $found[1])) `
+        'consecutive original statements' 'AdapterFailure'
+    $extractedText = $source.Substring($found[0].Extent.StartOffset,
+        $found[1].Extent.EndOffset - $found[0].Extent.StartOffset)
+    Assert-Bf ([Convert]::ToHexString([Security.Cryptography.SHA256]::HashData(
+        [Text.Encoding]::UTF8.GetBytes($extractedText))) -ceq $binding.combinedSpanSha256) `
+        'combined raw span' 'AdapterFailure'
+    $extracted = [scriptblock]::Create($extractedText)
+    Assert-BfClock
+    $null = [IO.Directory]::CreateDirectory($OutputRoot)
+    $outputCreated = $true
+    $failed = $false
+    foreach ($row in $expectations.cases) {
+        if ($failed) { $rows.Add(@{ id = $row.id; status = 'NotRun' }); continue }
+        $lastInputStart = if ($row.id -ceq 'F1') { $CollectionStartTick }
+            else { [Diagnostics.Stopwatch]::GetTimestamp() }
+        try {
+            Assert-BfClock $lastInputStart
+            $originalError = New-BfError
+            $originalException = $originalError.Exception
+            $inputEntry = $null
+            switch -CaseSensitive ($row.id) {
+                'F1' { $inputEntry = $originalError }
+                'F2' { $inputEntry = $originalException }
+                'F3' {
+                    try {
+                        $wrapper = [Management.Automation.ActionPreferenceStopException]::new('CAP-BF-F3')
+                        $originalError = $wrapper.ErrorRecord
+                        $originalException = $originalError.Exception
+                        Assert-Bf ($wrapper -is [Management.Automation.ActionPreferenceStopException] -and
+                            $originalError -is [Management.Automation.ErrorRecord] -and
+                            $originalException -is [Exception] -and
+                            -not [object]::ReferenceEquals($wrapper, $originalException) -and
+                            [object]::ReferenceEquals($wrapper.ErrorRecord, $originalError)) `
+                            'F3 public pair prerequisites' 'FixtureFailure'
+                        $inputEntry = $wrapper
+                    }
+                    catch { throw ('FixtureFailure: F3 public pair: ' + $_.Exception.Message) }
+                }
+                'F4' {
+                    $inputEntry = New-BfError
+                    Assert-Bf (-not [object]::ReferenceEquals($inputEntry, $originalError) -and
+                        -not [object]::ReferenceEquals($inputEntry.Exception, $originalException) -and
+                        $inputEntry.Exception.Message -ceq $originalException.Message -and
+                        $inputEntry.FullyQualifiedErrorId -ceq $originalError.FullyQualifiedErrorId) `
+                        'F4 equal text, distinct references' 'FixtureFailure'
+                }
+                'F5' { $inputEntry = $null }
+                'F6' {
+                    $inputEntry = [pscustomobject]@{ Exception = $originalException }
+                    Assert-Bf ($inputEntry -isnot [Management.Automation.ErrorRecord] -and
+                        $inputEntry -isnot [Exception]) 'F6 unknown CLR type' 'FixtureFailure'
+                }
+                default { throw 'AdapterFailure: unknown focused case' }
+            }
+            $entryExceptionBefore = if ($inputEntry -is [Management.Automation.ErrorRecord]) {
+                $inputEntry.Exception
+            } else { $null }
+            $engineErrors = [object[]]::new(1)
+            $engineErrors[0] = $inputEntry
+            $related = $null
+            $completed = $false
+            $caught = $null
+            try { . $extracted; $completed = $true }
+            catch { $caught = $_ }
+            if ($row.expected.normalCompletion) {
+                Assert-Bf ($completed -and $null -eq $caught) ($row.id + ' normal completion')
+                Assert-Bf ($related.Count -eq $row.expected.relatedCount) ($row.id + ' related count')
+                if ($row.expected.relatedCount -eq 1) {
+                    Assert-Bf ([object]::ReferenceEquals($related[0], $inputEntry)) ($row.id + ' input identity')
+                }
+            }
+            else {
+                Assert-Bf (-not $completed -and $null -ne $caught -and
+                    $caught.Exception.Message -ceq $row.expected.exactError) ($row.id + ' explicit AdapterFailure')
+            }
+            Assert-Bf ($engineErrors.Count -eq 1 -and
+                [object]::ReferenceEquals($engineErrors[0], $inputEntry) -and
+                [object]::ReferenceEquals($originalError.Exception, $originalException)) ($row.id + ' original references')
+            if ($inputEntry -is [Management.Automation.ErrorRecord]) {
+                Assert-Bf ([object]::ReferenceEquals($inputEntry.Exception, $entryExceptionBefore)) `
+                    ($row.id + ' entry exception unchanged')
+            }
+            if ($row.id -ceq 'F3') {
+                Assert-Bf ([object]::ReferenceEquals($wrapper.ErrorRecord, $originalError) -and
+                    [object]::ReferenceEquals($originalError.Exception, $originalException)) 'F3 pair unchanged'
+            }
+            if ($row.id -ceq 'F6') {
+                Assert-Bf ([object]::ReferenceEquals($inputEntry.Exception, $originalException)) 'F6 property unchanged'
+            }
+            $caseResult = @{ id = $row.id; status = 'PASS'; normalCompletion = $completed
+                expectedFailureObserved = (-not $row.expected.normalCompletion)
+                relatedCount = $(if ($completed) { $related.Count } else { $null })
+                originalReferencesUnchanged = $true; inputArrayLength = $engineErrors.Count
+                entryWasNull = ($null -eq $inputEntry); fixturePreconditionsPassed = $true }
+            $null = ConvertTo-Json -InputObject $caseResult -Depth 6
+            Assert-BfClock $lastInputStart
+            $caseResult.elapsedSeconds = ([Diagnostics.Stopwatch]::GetTimestamp() - $lastInputStart) /
+                [double][Diagnostics.Stopwatch]::Frequency
+            $rows.Add($caseResult)
+        }
+        catch {
+            $failed = $true
+            $rows.Add(@{ id = $row.id; status = 'Unexpected'; error = $_.Exception.Message
+                errorRecordType = $_.GetType().FullName; exceptionType = $_.Exception.GetType().FullName })
+        }
+    }
+    $report.cases = $rows.ToArray()
+    if (-not $failed) {
+        $lastInputStart = [Diagnostics.Stopwatch]::GetTimestamp()
+        Assert-BfClock $lastInputStart
+        $oldRedText = @(& $binding.sourcePath -BindingPath $binding.oldRedBindingPath -OutputRoot $binding.oldRedOutputRoot)
+        $oldRedExit = $LASTEXITCODE
+        $oldRedRaw = $oldRedText -join [Environment]::NewLine
+        $oldRed = ConvertFrom-Json -InputObject $oldRedRaw -AsHashtable
+        $report.oldRed = @{ status = 'Observed'; actualExit = $oldRedExit; rawJson = $oldRedRaw; result = $oldRed }
+        Assert-Bf ($oldRedExit -eq 1 -and $oldRed.accepted -eq $true -and
+            $oldRed.classification -ceq 'BehaviorRed-AssignmentLosesPrefix' -and
+            $oldRed.assertionFailure -ceq $expectations.oldRed.exactAssertion -and
+            $oldRed.actualPrefix -eq 0 -and $oldRed.expectedPrefix -eq 1 -and
+            ($oldRed.producerEvents -join ',') -ceq 'Diagnostic,Throw' -and $oldRed.originalErrorObserved) `
+            'original specific OldRed only'
+        Assert-BfClock $lastInputStart
+        $requestedExit = 1
+    }
+    $report.afterPins = @(Test-BfPins $binding.pins)
+    Assert-Bf ((Get-FileHash -LiteralPath $BindingPath -Algorithm SHA256).Hash -ceq $bindingBefore) `
+        'execution binding unchanged' 'AdapterFailure'
+    $report.bindingSha256 = $bindingBefore
+    $report.focusedAllPass = -not $failed
+    Assert-BfClock $lastInputStart
+}
+catch {
+    $report.cases = $rows.ToArray()
+    $report.failure = @{ classification = 'Unexpected'; error = $_.Exception.Message
+        errorRecordType = $_.GetType().FullName; exceptionType = $_.Exception.GetType().FullName }
+    $requestedExit = 2
+}
