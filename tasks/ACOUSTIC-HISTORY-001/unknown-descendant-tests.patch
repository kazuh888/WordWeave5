+    }
+    $taskActualExit = $LASTEXITCODE
+    $taskRecord.actualExit = $taskActualExit
+    Write-PreparationEvidence -Name 'exit.json' -Value @{ actualExit = $taskActualExit; attempts = 1; retry = 0 }
+    $taskRecord.exitSaved = $true
+    $taskClock.Stop()
+    $taskRecord.elapsedSeconds = $taskClock.Elapsed.TotalSeconds
+    if ($taskClock.Elapsed.TotalSeconds -ge 30) { throw 'Collection30 exceeded; no hard OS cancellation claim' }
+    if ($taskActualExit -eq 0) {
+        $suite = Get-Content -LiteralPath (Join-Path $taskOutputRoot 'suite-result.json') -Raw -Encoding utf8 |
+            ConvertFrom-Json -AsHashtable
