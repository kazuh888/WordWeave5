+}
+function Test-UnitTime {
+    if ($script:UnitClock.Elapsed.TotalSeconds -gt 5 -or $script:UnitClock.Elapsed.TotalSeconds -gt 30) {
+        throw 'AdapterFailure: O5/O6 case5/total30 deadline exceeded'
