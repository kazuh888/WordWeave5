@@ -0,0 +1,289 @@
+﻿<#
+.SYNOPSIS
+    Observe one unchanged C01 fixture and its original failing assertion.
+.DESCRIPTION
+    Uses exact AST-copied script-local Test helpers and original C slices. Never invokes PSSA or other cases.
+.PARAMETER BindingPath
+    Immutable original Unit20 binding.
+.PARAMETER DiagnosticBindingPath
+    Fixed diagnostic source/pin/argv metadata.
+.PARAMETER CollectionStartTick
+    Same outer Stopwatch tick, covering all preparation and both evidence saves.
+.PARAMETER OutputRoot
+    New isolated output leaf.
+.EXAMPLE
+    See the exact diagnostic receipt request; no independent command is authorized.
+.NOTES
+    Target: PowerShell7.6.7 ps7. Retry0. Exit0 means diagnostic observation accepted, not C01 behavior PASS.
+#>
+#Requires -Version 7.6
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$BindingPath,
+    [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$DiagnosticBindingPath,
+    [Parameter(Mandatory)][long]$CollectionStartTick,
+    [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$OutputRoot
+)
+Set-StrictMode -Version 3.0
+$ErrorActionPreference = 'Stop'
+$diagState = @{
+    stage = 'Prepare'; originalError = $null; fixtureError = $null; originalCheckInvoked = $false
+    observationErrors = [Collections.Generic.List[string]]::new()
+    missing = [Collections.Generic.List[string]]::new()
+    beforePins = @(); afterPins = @(); beforeCore = @(); afterCore = @()
+    observation = $null; classification = 'FixtureFailure'; created = $false
+    observedResultReference = $null; sameObservedResultReference = $false
+    diagnosticBindingBefore = $null; diagnosticBindingAfter = $null
+}
+$frequency = [double][Diagnostics.Stopwatch]::Frequency
+$budget = {
+    $elapsed = ([Diagnostics.Stopwatch]::GetTimestamp() - $CollectionStartTick) / $frequency
+    if ($CollectionStartTick -lt 0 -or $elapsed -lt 0 -or $elapsed -ge 5 -or $elapsed -ge 30) {
+        throw 'DiagnosticDeadline: preparation/observation/save included; no further invocation'
+    }
+}
+function Get-C01Text {
+    <#.SYNOPSIS Bounded scalar getter; records missing separately from original errors. #>
+    param([string]$Name, [scriptblock]$Getter, [int]$Limit = 4096)
+    try {
+        $value = & $Getter
+        if ($null -eq $value) { return $null }
+        if ($value -isnot [string]) { throw 'NonStringScalar' }
+        if ($value.Length -gt $Limit) {
+            $diagState.missing.Add($Name + ':Truncated')
+            return $value.Substring(0, $Limit)
+        }
+        return $value
+    }
+    catch {
+        $diagState.missing.Add($Name + ':GetterFailed')
+        $diagState.observationErrors.Add($Name + ':' + $_.Exception.GetType().FullName)
+        return $null
+    }
+}
+function Get-C01Error {
+    <#.SYNOPSIS Preserve bounded ErrorRecord diagnostics without serializing the live reference. #>
+    param([object]$Record, [string]$Label)
+    if ($null -eq $Record) { return @{ present = $false } }
+    if ($Record -isnot [Management.Automation.ErrorRecord]) {
+        $diagState.missing.Add($Label + ':NotErrorRecord')
+        return @{ present = $true; type = $Record.GetType().FullName }
+    }
+    return @{
+        present = $true
+        exceptionType = Get-C01Text ($Label + '.type') { $Record.Exception.GetType().FullName }
+        fullyQualifiedErrorId = Get-C01Text ($Label + '.fqid') { $Record.FullyQualifiedErrorId }
+        category = Get-C01Text ($Label + '.category') { $Record.CategoryInfo.ToString() }
+        message = Get-C01Text ($Label + '.message') { $Record.Exception.Message }
+        position = Get-C01Text ($Label + '.position') { $Record.InvocationInfo.PositionMessage }
+        scriptStack = Get-C01Text ($Label + '.scriptStack') { $Record.ScriptStackTrace }
+        exceptionStack = Get-C01Text ($Label + '.exceptionStack') { $Record.Exception.StackTrace }
+    }
+}
+function Save-C01Evidence {
+    <#.SYNOPSIS One CreateNew bounded evidence write; never calls the fixture Save. #>
+    param([string]$Name, [hashtable]$Document)
+    & $budget
+    $bytes = [Text.Encoding]::UTF8.GetBytes(($Document | ConvertTo-Json -Depth 12 -Compress))
+    if ($bytes.Length -gt 64KB) { throw 'ObservationFailure: JSON exceeds65536bytes' }
+    & $budget
+    $path = [IO.Path]::Combine($OutputRoot, $Name)
+    $stream = [IO.File]::Open($path, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
+    try { $stream.Write($bytes, 0, $bytes.Length) }
+    finally { $stream.Dispose() }
+    & $budget
+    return @{ path = $path; length = $bytes.Length
+        sha256 = [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($bytes)) }
+}
+function Invoke-C01Probe {
+    <#.SYNOPSIS Reuse the original local C definition scope and exactly one C01 input. #>
+    param([hashtable]$Binding, [hashtable]$Expectations)
+    & $budget
+    $slices = Get-CapCandidateSlices $Binding
+    . ([scriptblock]::Create($slices.functions))
+    $row = $Expectations.cases[0]
+    Assert-CapCondition ($row.id -ceq 'C01' -and $row.fixture -ceq 'EmptyReturn') 'fixed C01 only' 'FixtureFailure'
+    $diagState.stage = 'Fixture'
+    & $budget
+    $fixture = New-CapFixture $row $slices.seed
+    $actual = @(Invoke-CapFixture $fixture)
+    $diagState.stage = 'Observation'
+    try {
+        & $budget
+        $result = $actual[0]
+        $diagState.observedResultReference = $result
+        $missing = @($result.missing | Select-Object -First 16 | ForEach-Object {
+            $item = $_
+            Get-C01Text 'result.missing' { $item } 1024
+        })
+        if ($result.missing.Count -gt 16) { $diagState.missing.Add('result.missing:CountLimit') }
+        $artifacts = @($result.artifacts | Select-Object -First 2 | ForEach-Object {
+            $item = $_
+            @{ kind = Get-C01Text 'artifact.kind' { $item.kind }
+                path = Get-C01Text 'artifact.path' { $item.path } 2048
+                status = Get-C01Text 'artifact.status' { $item.status }
+                sha256 = Get-C01Text 'artifact.sha256' { $item.sha256 }; length = $item.length }
+        })
+        if ($result.artifacts.Count -gt 2) { $diagState.missing.Add('artifacts:CountLimit') }
+        $calls = @($fixture.memory.calls | Select-Object -First 2 | ForEach-Object {
+            $call = $_
+            @{ path = Get-C01Text 'save.path' { $call.path } 2048
+                byteLength = $call.bytes.LongLength; tick = $call.tick
+                sha256 = [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData([byte[]]$call.bytes)) }
+        })
+        $files = @($fixture.memory.files.Keys | Sort-Object | Select-Object -First 2 | ForEach-Object {
+            $name = $_
+            @{ path = Get-C01Text 'memory.path' { $name } 2048
+                byteLength = $fixture.memory.files[$name].LongLength
+                sha256 = [Convert]::ToHexString(
+                    [Security.Cryptography.SHA256]::HashData([byte[]]$fixture.memory.files[$name])) }
+        })
+        if ($fixture.memory.calls.Count -gt 2) { $diagState.missing.Add('save.calls:CountLimit') }
+        if ($fixture.memory.files.Count -gt 2) { $diagState.missing.Add('save.files:CountLimit') }
+        $snapshot = @{
+            id = 'C01'; actualResultCount = $actual.Count
+            sameResultReference = [object]::ReferenceEquals($actual[0], $result)
+            result = @{ captureStatus = Get-C01Text 'result.capture' { $result.captureStatus }
+                gateStatus = Get-C01Text 'result.gate' { $result.gateStatus }
+                flags = $result.flags.Clone(); counts = $result.counts.Clone()
+                missing = $missing; artifacts = $artifacts
+                primaryError = Get-C01Error $result.primaryError 'primaryError' }
+            memory = @{ tick = $fixture.memory.tick; saveCalls = $fixture.memory.calls.Count
+                filesCount = $fixture.memory.files.Count; calls = $calls; files = $files
+                outputRoot = $fixture.state.outputRoot }
+            observationMissing = $diagState.missing.ToArray()
+            observationErrors = $diagState.observationErrors.ToArray()
+        }
+        $diagState.observation = Save-C01Evidence 'actual-observation.json' $snapshot
+    }
+    catch {
+        $diagState.observationErrors.Add('snapshot:' + $_.Exception.GetType().FullName)
+        $diagState.missing.Add('actual-observation:Incomplete')
+    }
+    $diagState.stage = 'OriginalAssertion'
+    & $budget
