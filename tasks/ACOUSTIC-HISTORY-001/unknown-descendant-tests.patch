+            $suite.inputs.Count -ne 33 -or $suite.groups.Count -ne 6 -or $null -ne $suite.firstUnexpected -or
+            $suite.elapsedSeconds -ge 30 -or @($suite.inputs | Where-Object { $_.status -cne 'PASS' -or $_.attempts -ne 1 -or $_.retry -ne 0 }).Count -ne 0 -or
+            @($suite.groups | Where-Object { $_.status -cne 'PASS' -or $_.elapsedSeconds -ge 5 }).Count -ne 0 -or
+            $summary.Count -ne 1 -or $summary[0] -cne 'PREPARATION_RESULT:0;passed=33;firstUnexpected=;retry=0') {
+            throw 'All33 acceptance mismatch'
+        }
+        $taskRecord.classification = 'BehaviorMatched'
+    }
+    elseif ($taskActualExit -eq 1) { $taskRecord.classification = 'BehaviorMismatch' }
+    else { $taskRecord.classification = 'AdapterFailure' }
+}
