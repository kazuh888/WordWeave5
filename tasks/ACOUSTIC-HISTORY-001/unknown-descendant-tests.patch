+#[derive(Clone, Copy, Debug)]
+enum TargetFailureStage {
+    Observe, WaitRelease, StdoutWrite, StderrWrite, StdoutFlush, StderrFlush,
+    ExitSetting, CompletedWrite, TreeDelegated,
+}
+
+fn encode_target_failure(pid: u32, stage: TargetFailureStage, error: &io::Error) -> Vec<u8> {
+    let message = error.to_string();
+    let allowlisted = [
+        "invalid fixture integer", "invalid fixture environment", "fixture integer out of range",
+        "ET3_FAKE_ROOT required", "fixture root outside ignored boundary", "fixture owner marker mismatch",
+        "invalid fixture release name", "release must be one plain file name", "fixture release timeout",
+        "short argv fixture", "too many fixture args", "fixture arg too long", "argv length overflow",
+        "short UTF16 fixture", "NUL cannot be a Windows argv unit", "trailing argv fixture bytes",
+        "missing exact name", "runner missing", "unexpected runner path",
+        "fixture Cargo deadline; supervisor must audit descendants", "runner exit unavailable",
+        "fixture tree deadline", "fixture child wait incomplete", "unknown fixture mode",
+    ].contains(&message.as_str()) || error.raw_os_error()
+        .is_some_and(|code| io::Error::from_raw_os_error(code).to_string() == message);
+    let message_units: Vec<u16> = message.encode_utf16().collect();
+    let (message_utf16, message_status) = if !allowlisted {
+        ("null".to_owned(), "NotAllowlisted")
+    } else if message_units.len() > 2048 {
+        ("null".to_owned(), "TooLong")
+    } else {
+        (format!("[{}]", message_units.iter().map(|unit| unit.to_string()).collect::<Vec<_>>().join(",")), "Captured")
+    };
+    let raw_os_error = error.raw_os_error().map(|code| code.to_string()).unwrap_or_else(|| "null".into());
+    let serialize = |message_utf16: &str, message_status: &str| {
+        format!("{{\"schemaVersion\":1,\"pid\":{pid},\"stage\":\"{stage:?}\",\"errorKind\":\"{:?}\",\"rawOsError\":{raw_os_error},\"messageUtf16\":{message_utf16},\"messageStatus\":\"{message_status}\"}}", error.kind()).into_bytes()
+    };
+    let mut bytes = serialize(&message_utf16, message_status);
+    if bytes.len() > 8192 {
+        bytes = serialize("null", "TooLong");
+    }
+    bytes
+}
+
+fn try_write_target_failure(root: &Path, pid: u32, stage: TargetFailureStage, error: &io::Error,
+    write_once: impl FnOnce(&Path, &[u8]) -> io::Result<()>) -> io::Result<()> {
+    let bytes = encode_target_failure(pid, stage, error);
+    write_once(&root.join(format!("target-{pid}.failure.json")), &bytes)
+}
+
+fn write_new(path: &Path, bytes: &[u8]) -> io::Result<()> {
+    let mut file = OpenOptions::new().write(true).create_new(true).open(path)?;
+    file.write_all(bytes)?;
+    file.sync_all()
+}
+
+fn target(root: &Path) -> io::Result<i32> {
+    let mut stage = TargetFailureStage::Observe;
+    let result = (|| -> io::Result<i32> {
+    observe(root, "target")?;
+    let args: Vec<OsString> = fixture_args().skip(1).collect();
+    let is_list = args.iter().any(|arg| arg == "--list");
+    let is_exact = args.iter().any(|arg| arg == "--exact");
+    if !is_list && !is_exact && fixture_flag(&root.join("spawn-descendants.flag")) {
+        stage = TargetFailureStage::TreeDelegated;
+        return fixture_tree(root);
+    }
+    let hold_file = if is_list { "hold-list.flag" } else if is_exact { "hold-g0.flag" } else { "hold-full.flag" };
+    if fixture_flag(&root.join(hold_file)) {
+        let release = if is_list { "release-list" } else if is_exact { "release-g0" } else { "release-full" };
+        fixture_set_var("ET3_FAKE_RELEASE", release);
+    }
+    if is_exact && args.first().is_some_and(|name| name == "fixture::network") && fixture_flag(&root.join("hold-network.flag")) {
+        fixture_set_var("ET3_FAKE_RELEASE", "release-g0");
+    }
+    stage = TargetFailureStage::WaitRelease;
+    wait_release(root, "ET3_FAKE_RELEASE")?;
+    if is_list {
+        if fixture_flag(&root.join("integration-case.flag")) {
+            stage = TargetFailureStage::StdoutWrite;
+            fixture_stdout().write_all(b"fixture::recording: test\nfixture::network: test\nfixture::integration: test\n3 tests, 0 benchmarks\n")?;
+        } else {
+            stage = TargetFailureStage::StdoutWrite;
+            fixture_stdout().write_all(b"fixture::recording: test\nfixture::network: test\n2 tests, 0 benchmarks\n")?;
+        }
+    } else if is_exact {
+        let name = args.first().ok_or_else(|| io::Error::other("missing exact name"))?.to_string_lossy();
+        if fixture_flag(&root.join("g0-fail.flag")) {
+            stage = TargetFailureStage::StdoutWrite;
+            fixture_stdout().write_all(format!("running 1 test\ntest {name} ... FAILED\ntest result: FAILED. 0 passed; 1 failed\n").as_bytes())?;
+            return Ok(101);
+        }
+        stage = TargetFailureStage::StdoutWrite;
+        fixture_stdout().write_all(format!("running 1 test\ntest {name} ... ok\ntest result: ok. 1 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out\n").as_bytes())?;
+        if !fixture_flag(&root.join("g0-no-marker.flag")) {
+            stage = TargetFailureStage::StderrWrite;
+            fixture_stderr().write_all(format!("ET2_CASE_COMPLETE:{name}:Administrator=False\n").as_bytes())?;
+        }
+    } else {
+        stage = TargetFailureStage::StdoutWrite;
+        fixture_stdout().write_all(STDOUT)?;
+        stage = TargetFailureStage::StderrWrite;
+        fixture_stderr().write_all(STDERR)?;
+    }
+    stage = TargetFailureStage::StdoutFlush;
+    fixture_stdout().flush()?;
+    stage = TargetFailureStage::StderrFlush;
+    fixture_stderr().flush()?;
+    // Exit-bit stimuli apply to the full target only; safety remains a separate
+    // positive prerequisite unless an explicit safety-failure flag is present.
+    stage = TargetFailureStage::ExitSetting;
+    let code = if is_list || is_exact { 0 } else { number("ET3_FAKE_EXIT_U32", 0, u32::MAX as u64)? as u32 };
+    stage = TargetFailureStage::CompletedWrite;
+    write_new(&root.join(format!("target-{}.completed.json", 7u32)),
+        format!("{{\"exitU32\":{code}}}").as_bytes())?;
+    Ok(code as i32)
+    })();
+    match result {
+        Ok(code) => Ok(code),
+        Err(error) => {
+            let diagnostic_result = try_write_target_failure(root, 7u32, stage, &error, write_new);
+            let _ = diagnostic_result;
+            Err(error)
+        }
+    }
+}
