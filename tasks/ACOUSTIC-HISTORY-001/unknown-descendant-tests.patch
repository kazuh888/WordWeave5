+      "text": "fn target(root: &Path) -> io::Result<i32> {\n    let mut stage = TargetFailureStage::Observe;\n    let result = (|| -> io::Result<i32> {\n    observe(root, \"target\")?;\n    let args: Vec<OsString> = env::args_os().skip(1).collect();\n    let is_list = args.iter().any(|arg| arg == \"--list\");\n    let is_exact = args.iter().any(|arg| arg == \"--exact\");\n    if !is_list && !is_exact && root.join(\"spawn-descendants.flag\").is_file() {\n        stage = TargetFailureStage::TreeDelegated;\n        return tree(root);\n    }\n    let hold_file = if is_list { \"hold-list.flag\" } else if is_exact { \"hold-g0.flag\" } else { \"hold-full.flag\" };\n    if root.join(hold_file).is_file() {\n        let release = if is_list { \"release-list\" } else if is_exact { \"release-g0\" } else { \"release-full\" };\n        env::set_var(\"ET3_FAKE_RELEASE\", release);\n    }\n    if is_exact && args.first().is_some_and(|name| name == \"fixture::network\") && root.join(\"hold-network.flag\").is_file() {\n        env::set_var(\"ET3_FAKE_RELEASE\", \"release-g0\");\n    }\n    stage = TargetFailureStage::WaitRelease;\n    wait_release(root, \"ET3_FAKE_RELEASE\")?;\n    if is_list {\n        if root.join(\"integration-case.flag\").is_file() {\n            stage = TargetFailureStage::StdoutWrite;\n            io::stdout().write_all(b\"fixture::recording: test\\nfixture::network: test\\nfixture::integration: test\\n3 tests, 0 benchmarks\\n\")?;\n        } else {\n            stage = TargetFailureStage::StdoutWrite;\n            io::stdout().write_all(b\"fixture::recording: test\\nfixture::network: test\\n2 tests, 0 benchmarks\\n\")?;\n        }\n    } else if is_exact {\n        let name = args.first().ok_or_else(|| io::Error::other(\"missing exact name\"))?.to_string_lossy();\n        if root.join(\"g0-fail.flag\").is_file() {\n            stage = TargetFailureStage::StdoutWrite;\n            io::stdout().write_all(format!(\"running 1 test\\ntest {name} ... FAILED\\ntest result: FAILED. 0 passed; 1 failed\\n\").as_bytes())?;\n            return Ok(101);\n        }\n        stage = TargetFailureStage::StdoutWrite;\n        io::stdout().write_all(format!(\"running 1 test\\ntest {name} ... ok\\ntest result: ok. 1 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out\\n\").as_bytes())?;\n        if !root.join(\"g0-no-marker.flag\").is_file() {\n            stage = TargetFailureStage::StderrWrite;\n            io::stderr().write_all(format!(\"ET2_CASE_COMPLETE:{name}:Administrator=False\\n\").as_bytes())?;\n        }\n    } else {\n        stage = TargetFailureStage::StdoutWrite;\n        io::stdout().write_all(STDOUT)?;\n        stage = TargetFailureStage::StderrWrite;\n        io::stderr().write_all(STDERR)?;\n    }\n    stage = TargetFailureStage::StdoutFlush;\n    io::stdout().flush()?;\n    stage = TargetFailureStage::StderrFlush;\n    io::stderr().flush()?;\n    // Exit-bit stimuli apply to the full target only; safety remains a separate\n    // positive prerequisite unless an explicit safety-failure flag is present.\n    stage = TargetFailureStage::ExitSetting;\n    let code = if is_list || is_exact { 0 } else { number(\"ET3_FAKE_EXIT_U32\", 0, u32::MAX as u64)? as u32 };\n    stage = TargetFailureStage::CompletedWrite;\n    write_new(&root.join(format!(\"target-{}.completed.json\", process::id())),\n        format!(\"{{\\\"exitU32\\\":{code}}}\").as_bytes())?;\n    Ok(code as i32)\n    })();\n    match result {\n        Ok(code) => Ok(code),\n        Err(error) => {\n            let diagnostic_result = try_write_target_failure(root, process::id(), stage, &error, write_new);\n            let _ = diagnostic_result;\n            Err(error)\n        }\n    }\n}",
