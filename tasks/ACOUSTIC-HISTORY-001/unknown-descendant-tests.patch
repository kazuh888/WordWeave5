+        }
+        foreach ($path in $Inputs.fixed.Keys) {
+            & $canonical $path
+            if ($Inputs.fixed[$path] -isnot [string] -or $Inputs.fixed[$path] -cnotmatch '^[A-F0-9]{64}$' -or
+                ($dependencyHashes.ContainsKey($path) -and $dependencyHashes[$path] -cne $Inputs.fixed[$path])) {
+                throw 'Fixed dependency conflict'
+            }
+            if (-not $dependencyHashes.ContainsKey($path)) { $dependencyHashes.Add($path, $Inputs.fixed[$path]) }
+        }
+        foreach ($required in @($Inputs.sourcePath) + @($manifest.tools.Values)) {
+            if (-not $dependencyHashes.ContainsKey($required)) {
+                & $fail 'Dependency.Missing' 'Preparation required dependency absent from union'
+            }
+        }
+        $dependencyPaths = [string[]]@($dependencyHashes.Keys)
+        [Array]::Sort($dependencyPaths, [StringComparer]::Ordinal)
+        $null = & $pathState $Inputs.suiteRoot 'Directory' $workDeadline
+        $null = & $pathState $temp 'Missing' $workDeadline
+        foreach ($name in @('fake.exe', 'rustc-version.stdout', 'rustc-version.stderr', 'fake-build.stdout',
+                'fake-build.stderr', 'toolchain.json', 'frozen-inputs.json', 'preparation.json')) {
+            $null = & $pathState ([IO.Path]::Combine($Inputs.suiteRoot, $name)) 'Missing' $workDeadline
+        }
+        & $checkDependencies
+        $control.saveAllowed = $true
+        # Temp creation consumes work time, not the final evidence reserve.
+        $created = & $invoke 'Save' @('CreateTemp', @{ path = $temp }) $workDeadline
+        & $shape $created @('path', 'status', 'sha256', 'length')
+        $result.evidence += ,(@{ kind = 'Temp'; path = $created.path; status = $created.status
+            sha256 = $created.sha256; length = $created.length })
+        if ($created.path -cne $temp -or $created.status -cne 'Created' -or
+            $null -ne $created.sha256 -or $null -ne $created.length) { throw 'Temp creation shape' }
+        & $runPhase 'Version' 2 @('--version') 'rustc-version'
+        & $runPhase 'Compile' 25 @('--edition=2021', $Inputs.sourcePath, '-o', $Inputs.fakePath) 'fake-build'
+        & $checkDependencies
+        $null = & $pathState $Inputs.fakePath 'File' $workDeadline
+        $result.fakeSha256 = & $hash $Inputs.fakePath $null $workDeadline
+        $frozen = $Inputs.fixed.Clone()
+        $frozen.Add($Inputs.fakePath, $result.fakeSha256)
+        $toolchain = @{ rustc = $manifest.tools.rustc; version = $control.version
+            rustcSha256 = $dependencyHashes[$manifest.tools.rustc]; pwsh = $manifest.tools.pwsh
+            pwshSha256 = $dependencyHashes[$manifest.tools.pwsh]; pwshVersion = $PSVersionTable.PSVersion.ToString()
+            administrator = $false; v2 = $manifest.tools.v2; v2Sha256 = $dependencyHashes[$manifest.tools.v2]
+            fakeExeSha256 = $result.fakeSha256; fakeSourceSha256 = $dependencyHashes[$Inputs.sourcePath] }
+        & $record 'toolchain.json' 'Toolchain' $toolchain
+        & $record 'frozen-inputs.json' 'FrozenInputs' $frozen
+        $null = & $hash $Inputs.fakePath $result.fakeSha256 $workDeadline 'Generated.Drift'
+    }
+    catch {
+        if ($null -eq $result.primaryError) { & $remember $_ }
+        elseif (-not [object]::ReferenceEquals($result.primaryError, $_) -and
+            -not [object]::ReferenceEquals($result.primaryError.Exception, $_.Exception)) { & $remember $_ }
+    }
+    $control.inWork = $false
+    if ($null -ne $control.handle -and -not $control.released) {
+        try {
+            $recoveryDeadline = [Math]::Min((& $now) + 3 * $Inputs.frequency, $totalDeadline - 2 * $Inputs.frequency)
+            if (-not $control.exited) {
+                $null = & $invoke 'Stop' @($control.handle) $recoveryDeadline
+            }
+            while (-not $control.released) {
+                $null = & $poll $recoveryDeadline
+                if (-not $control.released) { & $pause $recoveryDeadline }
+            }
+            $control.recovered = $true
+            $result.directRecovery = 'Recovered'
+        }
+        catch {
+            & $remember $_
+            $control.unknown = $true
+            $result.directRecovery = 'Unknown'
+        }
+    }
+    if ($control.unknown) { $result.state = 'RecoveryUnknown' }
+    elseif ($control.evidenceFailed) { $result.state = 'EvidenceFailed' }
+    elseif ($null -eq $result.primaryError) { $result.state = 'AwaitingApproval' }
+    if ($control.saveAllowed) {
+        try {
+            $projectError = {
+                param($failure)
