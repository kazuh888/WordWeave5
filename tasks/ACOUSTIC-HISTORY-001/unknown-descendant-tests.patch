+      "text": "fn encode_target_failure(pid: u32, stage: TargetFailureStage, error: &io::Error) -> Vec<u8> {\n    let message = error.to_string();\n    let allowlisted = [\n        \"invalid fixture integer\", \"invalid fixture environment\", \"fixture integer out of range\",\n        \"ET3_FAKE_ROOT required\", \"fixture root outside ignored boundary\", \"fixture owner marker mismatch\",\n        \"invalid fixture release name\", \"release must be one plain file name\", \"fixture release timeout\",\n        \"short argv fixture\", \"too many fixture args\", \"fixture arg too long\", \"argv length overflow\",\n        \"short UTF16 fixture\", \"NUL cannot be a Windows argv unit\", \"trailing argv fixture bytes\",\n        \"missing exact name\", \"runner missing\", \"unexpected runner path\",\n        \"fixture Cargo deadline; supervisor must audit descendants\", \"runner exit unavailable\",\n        \"fixture tree deadline\", \"fixture child wait incomplete\", \"unknown fixture mode\",\n    ].contains(&message.as_str()) || error.raw_os_error()\n        .is_some_and(|code| io::Error::from_raw_os_error(code).to_string() == message);\n    let message_units: Vec<u16> = message.encode_utf16().collect();\n    let (message_utf16, message_status) = if !allowlisted {\n        (\"null\".to_owned(), \"NotAllowlisted\")\n    } else if message_units.len() > 2048 {\n        (\"null\".to_owned(), \"TooLong\")\n    } else {\n        (format!(\"[{}]\", message_units.iter().map(|unit| unit.to_string()).collect::<Vec<_>>().join(\",\")), \"Captured\")\n    };\n    let raw_os_error = error.raw_os_error().map(|code| code.to_string()).unwrap_or_else(|| \"null\".into());\n    let serialize = |message_utf16: &str, message_status: &str| {\n        format!(\"{{\\\"schemaVersion\\\":1,\\\"pid\\\":{pid},\\\"stage\\\":\\\"{stage:?}\\\",\\\"errorKind\\\":\\\"{:?}\\\",\\\"rawOsError\\\":{raw_os_error},\\\"messageUtf16\\\":{message_utf16},\\\"messageStatus\\\":\\\"{message_status}\\\"}}\", error.kind()).into_bytes()\n    };\n    let mut bytes = serialize(&message_utf16, message_status);\n    if bytes.len() > 8192 {\n        bytes = serialize(\"null\", \"TooLong\");\n    }\n    bytes\n}",
