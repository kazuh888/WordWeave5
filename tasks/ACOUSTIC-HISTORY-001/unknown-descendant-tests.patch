+function Test-PreparationResult {
+    <#
+    .SYNOPSIS
+        Checks the frozen independent input outcome and memory boundaries
+    .PARAMETER Fixture
+        Fresh memory fixture used for this single input.
+    .PARAMETER Result
+        Exactly one result from the original candidate function; no output filtering.
+    .PARAMETER Expectation
+        Unmodified row of CAA26281 independent expectations.
+    .EXAMPLE
+        Test-PreparationResult -Fixture $fixture -Result $actual -Expectation $row
+    .NOTES
+        PowerShell 7.6.7; pure assertions; no native/OS I/O.
+    #>
+    [CmdletBinding()]
+    [OutputType([hashtable])]
+    param([hashtable]$Fixture, [object[]]$Result, [hashtable]$Expectation)
+    $state = $Fixture.State
+    $expected = $Expectation.expect
+    $check = {
+        param([bool]$Condition, [string]$Message)
+        if (-not $Condition) { throw ('BehaviorMismatch: ' + $Expectation.id + ': ' + $Message) }
+    }.GetNewClosure()
+    & $check ($Result.Count -eq 1) 'one unfiltered result'
+    $actual = $Result[0]
+    $actualKeys = if ($actual -is [Collections.IDictionary]) { @($actual.Keys) }
+        elseif ($actual -is [pscustomobject]) { @($actual.PSObject.Properties.Name) } else { @() }
+    $keys = @('state', 'dispatchCount', 'retryCount', 'fakeSha256', 'primaryError', 'secondaryErrors',
+        'directRecovery', 'unknownDescendants', 'evidence')
+    & $check (($actualKeys | Sort-Object) -join ',' -ceq ($keys | Sort-Object) -join ',') 'exact result shape'
+    & $check ($actual.state -ceq $expected.state) ('state expected ' + $expected.state + ', actual ' + $actual.state)
+    & $check ($actual.dispatchCount -is [int] -and $actual.dispatchCount -eq 0) 'dispatch0'
+    & $check ($actual.retryCount -is [int] -and $actual.retryCount -eq 0) 'retry0'
+    & $check ($actual.unknownDescendants -ceq 'NotObserved') 'unknown descendants remain NotObserved'
+    & $check ($state.Violations.Count -eq 0) ('memory boundary: ' + ($state.Violations -join ';'))
+    $versionStarts = @($state.Starts | Where-Object phase -CEQ 'Version').Count
+    $compileStarts = @($state.Starts | Where-Object phase -CEQ 'Compile').Count
+    $records = @($state.Saves | Where-Object action -CEQ 'Record')
+    & $check ($versionStarts -le 1 -and $compileStarts -le 1) 'at most one start per phase'
+    foreach ($mapping in @(
+        @{ key = 'versionStarts'; value = $versionStarts }, @{ key = 'compileStarts'; value = $compileStarts },
+        @{ key = 'startCount'; value = $state.Starts.Count }, @{ key = 'stopCount'; value = $state.Stops.Count },
+        @{ key = 'generatedHashCount'; value = $state.GeneratedHashCalls }, @{ key = 'saveCount'; value = $records.Count }
+    )) {
+        if ($expected.ContainsKey($mapping.key)) { & $check ($expected[$mapping.key] -eq $mapping.value) ($mapping.key + ' exact count') }
+    }
+    if ($expected.ContainsKey('primaryError') -and $null -eq $expected.primaryError) {
+        & $check ($null -eq $actual.primaryError) 'successful primary error is null'
+    }
+    elseif ($actual.state -cne 'AwaitingApproval') {
+        & $check ($actual.primaryError -is [Management.Automation.ErrorRecord]) 'first error is an ErrorRecord'
+    }
+    if ($expected.ContainsKey('primaryIdentity')) {
+        & $check ([object]::ReferenceEquals($actual.primaryError, $state.Errors[$expected.primaryIdentity])) 'primary exact ErrorRecord identity'
+    }
+    if ($expected.ContainsKey('secondaryIdentity')) {
+        $identityMatches = @($actual.secondaryErrors | Where-Object {
+            [object]::ReferenceEquals($_, $state.Errors[$expected.secondaryIdentity])
+        })
+        & $check ($identityMatches.Count -eq 1) 'secondary error identity occurs exactly once'
+    }
+    foreach ($secondary in @($actual.secondaryErrors)) {
+        & $check ($secondary -is [Management.Automation.ErrorRecord]) 'secondary ErrorRecord shape'
+        & $check (-not [object]::ReferenceEquals($secondary, $actual.primaryError)) 'primary not replaced or duplicated'
+    }
+    foreach ($handle in $state.Stops) {
+        & $check (@($state.Handles | Where-Object { [object]::ReferenceEquals($_, $handle) }).Count -eq 1) 'Stop exact returned handle'
+        & $check (@($state.Stops | Where-Object { [object]::ReferenceEquals($_, $handle) }).Count -eq 1) 'Stop no retry'
+        & $check (-not [object]::ReferenceEquals($handle, $state.Unrelated)) 'same PID is not ownership'
+        & $check (-not [object]::ReferenceEquals($handle, $state.Unknown)) 'unknown not stopped'
+    }
+    if ($expected.ContainsKey('stopHandles') -or $expected.ContainsKey('stopHandle')) {
+        & $check ($state.Stops.Count -eq 1 -and $state.Handles.Count -ge 1 -and
+            [object]::ReferenceEquals($state.Stops[0], $state.Handles[0])) 'exact one H1 Stop'
+    }
+    if ($actual.state -ceq 'RecoveryUnknown') {
+        & $check ($actual.directRecovery -ceq 'Unknown') 'unrecovered direct handle stays Unknown'
+    }
+    if ($Expectation.id -ceq 'G3-01') { & $check ($actual.directRecovery -ceq 'Recovered') 'Stop alone is not recovery; Poll proved exit' }
+    if ($Expectation.id -ceq 'G3-04') { & $check ($actual.directRecovery -ceq 'Exited') 'already-ended handle not stopped' }
+    $savedPaths = [Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)
+    foreach ($saved in $state.Saves) { & $check ($savedPaths.Add($saved.path)) 'single CreateNew attempt per path' }
+    foreach ($portEvent in $state.Trace) {
+        if ($portEvent.port -ceq 'Start') { & $check ($portEvent.tick -lt 35000) 'no Start after work deadline' }
+        if ($portEvent.port -ceq 'Hash') { & $check ($portEvent.tick -lt 35000) 'no work Hash after work deadline' }
+    }
+    for ($index = 0; $index -lt $state.Trace.Count; $index++) {
+        if ($state.Trace[$index].port -ceq 'Now') { continue }
+        & $check ($index -gt 0 -and $index + 1 -lt $state.Trace.Count -and
+            $state.Trace[$index - 1].port -ceq 'Now' -and $state.Trace[$index + 1].port -ceq 'Now') 'Now before and after each port'
+    }
+    if ($Expectation.id -ceq 'G2-03') {
+        $startTrace = @($state.Trace | Where-Object port -CEQ 'Start')[0]
+        $laterWork = @($state.Trace | Where-Object {
+            $_.tick -ge 2001 -and $_ -ne $startTrace -and $_.port -cin @('Start', 'Hash')
+        })
+        & $check ($laterWork.Count -eq 0) 'late Start response starts no more work'
+    }
+    if ($Expectation.id -ceq 'G2-06') {
+        & $check (@($state.Saves | Where-Object tick -GE 40000).Count -eq 0) 'late Save response starts no more Save'
+    }
+    if ($Expectation.id -ceq 'G5-02') {
+        & $check (@($state.Trace | Where-Object {
+            $_.port -cin @('ReadState', 'Hash') -and ($_.detail | Out-String) -match 'approval\.token'
+        }).Count -eq 0) 'approval-like file is never read'
+    }
+    if ($state.Files.ContainsKey($state.Sentinel)) {
+        & $check ((& $state.Digest $state.Files[$state.Sentinel]) -ceq (& $state.Digest $state.SentinelBytes)) 'existing context bytes preserved'
+    }
+    else { & $check $false 'existing context missing' }
+    if ($null -ne $state.PartialPath) {
+        & $check ($state.Files.ContainsKey($state.PartialPath) -and
+            (& $state.Digest $state.Files[$state.PartialPath]) -ceq (& $state.Digest $state.PartialBytes)) 'partial prefix preserved'
+    }
+    if ($state.CompileFinished) {
+        & $check ($state.Files.ContainsKey($state.Fake) -and
+            (& $state.Digest $state.Files[$state.Fake]) -ceq (& $state.Digest $state.FakeBytes)) 'generated executable bytes preserved'
+    }
+    if ($state.GeneratedHashCalls -eq 0) { & $check ($null -eq $actual.fakeSha256) 'unavailable generated hash remains null' }
+    else { & $check ($actual.fakeSha256 -ceq (& $state.Digest $state.FakeBytes)) 'actual generated hash, never source hash' }
+    if ($expected.ContainsKey('finalSuccessMarkerCount')) {
+        $successMarkers = 0
+        foreach ($markerRecord in @($records | Where-Object { [IO.Path]::GetFileName($_.path) -ceq 'preparation.json' })) {
+            try {
+                $markerPayload = [Text.UTF8Encoding]::new($false, $true).GetString($markerRecord.bytes) |
+                    ConvertFrom-Json -AsHashtable -DateKind String -ErrorAction Stop
+            }
+            catch { throw 'BehaviorMismatch: invalid preparation marker JSON' }
+            & $check ($markerPayload -is [hashtable] -and $markerPayload.ContainsKey('result') -and
+                $markerPayload.result -is [hashtable] -and $markerPayload.result.ContainsKey('state') -and
+                $markerPayload.result.state -is [string]) 'preparation marker requires string result.state'
+            if ($markerPayload.result.state -ceq 'AwaitingApproval') { $successMarkers++ }
+        }
+        & $check ($successMarkers -eq 0) 'no final success marker after drift'
+    }
+    if ($actual.state -ceq 'AwaitingApproval') {
+        & $check ($versionStarts -eq 1 -and $compileStarts -eq 1) 'both preparation phases ran exactly once'
+        & $check (($records | ForEach-Object { [IO.Path]::GetFileName($_.path) }) -join ',' -ceq
+            'toolchain.json,frozen-inputs.json,preparation.json') 'successful evidence order'
+        & $check ($state.GeneratedHashCalls -eq 2) 'generation hash and separate rehash'
+        foreach ($record in $records) {
+            & $check ($record.bytes -is [byte[]] -and $record.bytes.Length -gt 0 -and
+                -not ($record.bytes.Length -ge 3 -and [Convert]::ToHexString($record.bytes[0..2]) -ceq 'EFBBBF')) 'UTF8 no BOM payload'
+            try {
+                $payload = [Text.UTF8Encoding]::new($false, $true).GetString($record.bytes) |
+                    ConvertFrom-Json -AsHashtable -DateKind String -ErrorAction Stop
+            }
+            catch { throw 'BehaviorMismatch: invalid candidate evidence JSON payload' }
+            $name = [IO.Path]::GetFileName($record.path)
+            if ($name -ceq 'frozen-inputs.json') { & $check ($payload[$state.Fake] -ceq $actual.fakeSha256) 'frozen generated hash' }
+            if ($name -ceq 'preparation.json') {
+                & $check ($payload.schemaVersion -eq 1 -and $payload.manifestSha256 -ceq $Fixture.Inputs.manifestSha256) 'marker binds original manifest'
+                & $check ($payload.limitsMs.total -eq 40000 -and $payload.limitsMs.work -eq 35000 -and
+                    $payload.limitsMs.version -eq 2000 -and $payload.limitsMs.compile -eq 25000 -and
+                    $payload.limitsMs.recovery -eq 3000 -and $payload.limitsMs.save -eq 2000) 'fixed preparation budgets'
+                & $check (@($payload.result.evidence | Where-Object kind -CEQ 'Preparation').Count -eq 0) 'no self hash cycle'
+            }
+        }
+    }
+    return @{ id = $Expectation.id; status = 'PASS'; starts = $state.Starts.Count; stops = $state.Stops.Count
+        records = $records.Count; portCalls = $state.OpCount; simulatedTick = $state.Tick }
+}
+
+Export-ModuleMember -Function Test-PreparationResult
