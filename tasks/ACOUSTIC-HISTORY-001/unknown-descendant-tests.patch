+ let case=std::env::args().nth(1).unwrap_or_default();
+ let result=match case.as_str() {
+  "O1"=>test_o1(),"O2"=>test_o2(),"O3"=>test_o3(),"O4"=>test_o4(),
+  _=>Err("AdapterFailure: expected exactly O1/O2/O3/O4 argument".into())
+ };
+ if started.elapsed().as_secs_f64()>5.0||started.elapsed().as_secs_f64()>30.0 {
+  eprintln!("UnexpectedFailure:{case}:case5/total30 exceeded; later inputs NotRun");
+  std::process::exit(2);
