+        if (-not $primarySuffixes.ContainsKey($expected.primary)) {
+            throw ('AdapterFailure: unmapped fixed primary label for ' + $Expectation.id)
+        }
+        & $check ($actual.primaryError -is [Management.Automation.ErrorRecord]) 'identified primary is an ErrorRecord'
+        & $check ($actual.primaryError.FullyQualifiedErrorId -ceq
+            ('WW5.ENV01.Preparation.' + $primarySuffixes[$expected.primary])) 'primary cause matches fixed private contract'
+    }
     if ($expected.ContainsKey('primaryIdentity')) {
         & $check ([object]::ReferenceEquals($actual.primaryError, $state.Errors[$expected.primaryIdentity])) 'primary exact ErrorRecord identity'
     }
@@ -113,6 +136,19 @@ function Test-PreparationResult {
