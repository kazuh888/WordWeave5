+            position = $null; scriptName = $null; line = $null; column = $null
+            targetObjectType = $null; failedEntryType = $null
+            failedEntryStatus = 'UnidentifiedFromOuterCatch'
+            missing = @(); truncated = @(); captureFailure = $null
+        }
+        $observationFields = @(
