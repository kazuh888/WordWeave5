+    Write-PacketJson -Name 'baseline-binding.json' -Value @{
+        sourcePath = [IO.Path]::GetFullPath($sourcePath); sha256 = $expectedHash; length = 19920; bom = 'EF-BB-BF'
+        spans = @($spans); sourceInvocationCount = 0; productionPortInvocationCount = 0
+        substitutions = @(); candidateFunction = 'Pending'; candidateSha256 = 'Pending'
+    }
