--- /dev/null
+++ b/target/early-trial-build/et3/cargo-gate/verification/argv-path01/ef551043-d22a-44a7-903b-1e9540efc910/old-o1.rs
@@ -0,0 +1,71 @@
+// ACOUSTIC-HISTORY-001 O1 baseline-only unit. Does not include fake main/run/extern.
+// Compile/run only after parent Pre/freeze. Expected exit 1: 3 BehaviorRED inputs.
+// Missing helper/compile errors are AdapterFailure; they are never BehaviorRED.
+#![cfg(windows)]
+use std::ffi::{OsStr, OsString};
+use std::os::windows::ffi::{OsStrExt, OsStringExt};
+
+fn units(value: &OsStr) -> String {
+    format!("[{}]", value.encode_wide().map(|v| v.to_string()).collect::<Vec<_>>().join(","))
+}
+
+fn actual(mut lookup: impl FnMut(&str) -> Option<OsString>) -> String {
+    let keys = ["LOCALAPPDATA", "TEMP", "TMP", "PATH", "CARGO_BUILD_JOBS", "CARGO_TARGET_DIR", "CARGO_LOG",
+        "CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_RUNNER", "WW5_CARGO_GATE_RUN_PATH", "WW5_CARGO_GATE_RUN_ID",
+        "WW5_ET2_CHILD", "WW5_ET2_BASE"];
+    let records = keys.iter().map(|key| {
+        let value = lookup(key).map(|v| units(&v)).unwrap_or_else(|| "null".into());
+        format!("\"{key}\":{value}")
+    }).collect::<Vec<_>>().join(",");
+    format!("{{{records}}}")
+}
+
+const EXPECTED_KEYS: [&str; 19] = ["LOCALAPPDATA", "TEMP", "TMP", "PATH", "CARGO_BUILD_JOBS", "CARGO_TARGET_DIR", "CARGO_LOG", "CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_RUNNER", "WW5_CARGO_GATE_RUN_PATH", "WW5_CARGO_GATE_RUN_ID", "WW5_ET2_CHILD", "WW5_ET2_BASE", "ET3_FAKE_ROOT", "ET3_FAKE_MODE", "ET3_FAKE_EXIT_U32", "ET3_FAKE_RELEASE", "ET3_FAKE_WAIT_MS", "ET3_FAKE_BUILD_RELEASE", "ET3_FAKE_INVOCATIONS"];
+
+fn main() {
+    let suite_started = std::time::Instant::now();
+    let mut expected_red = 0;
+    for (id, expected_value, fixture) in [
+        ("O1-null", "null", None),
+        ("O1-empty", "[]", Some(OsString::new())),
+        ("O1-wide", "[65,55357,56832,55296]", Some(OsString::from_wide(&[65,55357,56832,55296]))),
+    ] {
+        let case_started = std::time::Instant::now();
+        if suite_started.elapsed().as_secs_f64() >= 30.0 {
+            eprintln!("UnexpectedFailure:O1:suite deadline before input");
+            std::process::exit(2);
+        }
+        let mut looked_up = Vec::new();
+        let observed = actual(|key| {
+            looked_up.push(key.to_string());
+            fixture.clone()
+        });
+        let expected = format!("{{{}}}", EXPECTED_KEYS.iter()
+            .map(|key| format!("\"{key}\":{expected_value}"))
+            .collect::<Vec<_>>().join(","));
+        // Check the known baseline defect precisely; do not accept an arbitrary mismatch as RED.
+        let baseline_keys = &EXPECTED_KEYS[..12];
+        let expected_baseline = format!("{{{}}}", baseline_keys.iter()
+            .map(|key| format!("\"{key}\":{expected_value}"))
+            .collect::<Vec<_>>().join(","));
+        if observed != expected_baseline ||
+            looked_up.iter().map(String::as_str).collect::<Vec<_>>().as_slice() != baseline_keys {
+            eprintln!("AdapterFailure:{id}:baseline behavior differed from frozen twelve-key construction");
+            std::process::exit(2);
+        }
+        if observed == expected {
+            eprintln!("UnexpectedPASS:{id}:missing seven-key defect was not reproduced");
+            std::process::exit(2);
+        }
+        if case_started.elapsed().as_secs_f64() > 5.0 ||
+            suite_started.elapsed().as_secs_f64() > 30.0 {
+            eprintln!("UnexpectedFailure:{id}:deadline exceeded");
+            std::process::exit(2);
+        }
+        expected_red += 1;
+        println!("BehaviorRED:{id}:missing=ET3_FAKE_ROOT,ET3_FAKE_MODE,ET3_FAKE_EXIT_U32,ET3_FAKE_RELEASE,ET3_FAKE_WAIT_MS,ET3_FAKE_BUILD_RELEASE,ET3_FAKE_INVOCATIONS");
+    }
+    assert_eq!(expected_red, 3);
+    std::process::exit(1);
+}
