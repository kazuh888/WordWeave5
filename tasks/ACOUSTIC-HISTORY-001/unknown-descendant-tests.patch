+      "text": "function Invoke-GateFailure {\n    param([string]$Status, [string]$Message, [object]$Callsite = 'GateFailure.Other', [object]$FailureObservation = $null)\n    $script:Status = $Status\n    if ($null -eq $script:AbortTick) {\n        $script:AbortTick = $script:Clock.Elapsed.TotalSeconds\n        $script:AbortUtc = [DateTimeOffset]::UtcNow\n    }\n    $originalStatus = $script:Status\n    $originalTick = $script:AbortTick\n    $originalUtc = $script:AbortUtc\n    $diagnosticState = $null\n    $ownsAttempt = $false\n    try {\n        $stateVariable = Get-Variable -Name FirstFailureState -Scope Script -ErrorAction SilentlyContinue\n        if ($null -ne $stateVariable -and $stateVariable.Value -is [hashtable]) {\n            $diagnosticState = $stateVariable.Value\n            if ($diagnosticState.attempted -is [bool] -and -not $diagnosticState.attempted) {\n                $diagnosticState.attempted = $true\n                $ownsAttempt = $true\n                $diagnosticState.inProgress = $true\n                $diagnosticState.outcome = 'Skipped'\n                if ($diagnosticState.context -is [hashtable] -and $script:SourceMatched -is [bool] -and $script:SourceMatched) {\n                    $record = New-FirstFailureRecord -Context $diagnosticState.context -Callsite $Callsite `\n                        -FailureObservation $FailureObservation -Status $originalStatus -AbortUtc $originalUtc -AbortTick $originalTick\n                    if ($null -ne $record) {\n                        $diagnosticState.outcome = 'Attempting'\n                        Write-FirstFailureRecord -RunDirectory $diagnosticState.context.runDirectory -Record $record\n                        $diagnosticState.outcome = 'Published'\n                    }\n                }\n            }\n        }\n    }\n    catch {\n        # Diagnostic failure must never replace the original gate failure.\n        if ($ownsAttempt) { $diagnosticState.outcome = 'Failed' }\n    }\n    finally {\n        if ($ownsAttempt) { $diagnosticState.inProgress = $false }\n        $script:Status = $originalStatus\n        $script:AbortTick = $originalTick\n        $script:AbortUtc = $originalUtc\n    }\n    throw [InvalidOperationException]::new($Message)\n}",
