+            $observationJson = ConvertTo-Json -InputObject $failureObservation -Depth 6
+            if ([Text.Encoding]::UTF8.GetByteCount($observationJson) -le 65536) { break }
+            $failureObservation[$observationTrimField] = $null
+            $failureObservation.missing += ($observationTrimField + ':ByteLimit')
+        }
+        $observationJson = ConvertTo-Json -InputObject $failureObservation -Depth 6
+        if ([Text.Encoding]::UTF8.GetByteCount($observationJson) -gt 65536) {
+            foreach ($observationField in $observationFields) {
+                $failureObservation[$observationField.name] = $null
+            }
+            $failureObservation.missing = @()
+            foreach ($observationField in $observationFields) {
