+      "text": "function Write-FirstFailureRecord {\n    # Only a projector-created record reaches this single-attempt writer.\n    param([string]$RunDirectory, [hashtable]$Record)\n    $rootPath = Get-CanonicalPath -Path $script:Root\n    $runsPath = Get-CanonicalPath -Path (Join-Path $rootPath 'runs') -Boundary $rootPath\n    $runPath = Get-CanonicalPath -Path $RunDirectory -Boundary $runsPath\n    $expectedPath = Get-CanonicalPath -Path (Join-Path $runsPath $Record.runId) -Boundary $runsPath\n    if (-not [string]::Equals($runPath, $expectedPath, [StringComparison]::OrdinalIgnoreCase) -or\n        -not [IO.Directory]::Exists($runPath)) { throw 'Diagnostic run boundary mismatch' }\n    $actorNumber = $Record.actor.pid.ToString([Globalization.CultureInfo]::InvariantCulture)\n    $startTicks = (Get-Utc -Value $Record.actor.startTimeUtc).UtcTicks.ToString([Globalization.CultureInfo]::InvariantCulture)\n    $finalPath = Get-CanonicalPath -Path (Join-Path $runPath \"first-failure-$($Record.role)-$actorNumber-$startTicks.json\") `\n        -Boundary $runPath -AllowMissing\n    $temporaryPath = Get-CanonicalPath -Path ($finalPath + '.tmp') -Boundary $runPath -AllowMissing\n    foreach ($path in @($finalPath, $temporaryPath)) {\n        if (-not [string]::Equals([IO.Path]::GetDirectoryName($path), $runPath, [StringComparison]::OrdinalIgnoreCase)) {\n            throw 'Diagnostic parent mismatch'\n        }\n    }\n    $json = ConvertTo-Json -InputObject $Record -Depth 5 -Compress\n    $bytes = [Text.UTF8Encoding]::new($false).GetBytes($json)\n    if ($bytes.Length -gt 8192) { throw 'Diagnostic byte limit exceeded' }\n    $stream = [IO.File]::Open($temporaryPath, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)\n    try {\n        $stream.Write($bytes, 0, $bytes.Length)\n        $stream.Flush($true)\n    }\n    finally { $stream.Dispose() }\n    [IO.File]::Move($temporaryPath, $finalPath, $false)\n}",
