+      "characterLength": 2602,
+      "text": "function Get-IdentityFailureObservation {\n    param([object]$Row, [object[]]$Rows, [object[]]$KnownValues, [Management.Automation.ErrorRecord]$Caught)\n    $observation = @{ pid = $null; parentPid = $null; creationUtc = $null; pathPresent = $null; commandPresent = $null\n        snapshotMatchCount = $null; knownMatchCount = $null; exceptionType = $null; exceptionLine = $null\n        rowFilterMatchCount = $null; rowFilterPathPresent = $null; rowFilterCommandPresent = $null }\n    foreach ($mapping in @(@('ProcessId', 'pid', 1), @('ParentProcessId', 'parentPid', 0))) {\n        $property = $Row.PSObject.Properties[$mapping[0]]\n        if ($null -eq $property) { continue }\n        $value = $property.Value\n        if (($value -is [byte] -or $value -is [sbyte] -or $value -is [int16] -or $value -is [uint16] -or\n                $value -is [int] -or $value -is [uint32] -or $value -is [long] -or $value -is [uint64]) -and\n            $value -ge $mapping[2] -and $value -le [uint32]::MaxValue) { $observation[$mapping[1]] = $value }\n    }\n    $creation = $Row.PSObject.Properties['CreationDate']\n    if ($null -ne $creation -and $creation.Value -is [DateTime] -and $creation.Value.Kind -ne [DateTimeKind]::Unspecified) {\n        $observation.creationUtc = $creation.Value.ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ss.fffffffZ', [Globalization.CultureInfo]::InvariantCulture)\n    }\n    $observation.pathPresent = $null -ne $Row.PSObject.Properties['ExecutablePath'] -and $null -ne $Row.ExecutablePath\n    $observation.commandPresent = $null -ne $Row.PSObject.Properties['CommandLine'] -and $null -ne $Row.CommandLine\n    if ($null -ne $observation.pid) {\n        $observation.snapshotMatchCount = @($Rows | Where-Object { $_.ProcessId -eq $observation.pid }).Count\n        $observation.knownMatchCount = @($KnownValues | Where-Object { $_.identity.pid -eq $observation.pid }).Count\n    }\n    $observation.exceptionType = $Caught.Exception.GetType().FullName\n    if ($Caught.InvocationInfo.ScriptLineNumber -gt 0) { $observation.exceptionLine = $Caught.InvocationInfo.ScriptLineNumber }\n    $filter = $Caught.Exception.Data['ET3.IdentityRowFilterObservation']\n    if ($filter -is [Collections.IDictionary]) {\n        if ($filter['rowFilterMatchCount'] -is [int] -and $filter['rowFilterMatchCount'] -ge 0) {\n            $observation.rowFilterMatchCount = $filter['rowFilterMatchCount']\n        }\n        foreach ($name in @('rowFilterPathPresent', 'rowFilterCommandPresent')) {\n            if ($filter[$name] -is [bool]) { $observation[$name] = $filter[$name] }\n        }\n    }\n    return $observation\n}",
