+function Write-ReceiptEvidence {
+    <# .SYNOPSIS
+        Creates one fixed evidence file
+    .PARAMETER Name
+        Direct-child filename.
+    .PARAMETER Value
+        JSON evidence payload.
+    .EXAMPLE
+        Write-ReceiptEvidence -Name 'exit.json' -Value $exitRecord
+    .NOTES
+        Private receipt helper; PowerShell 7.6.7.
+    #>
+    [CmdletBinding()]
+    param([string]$Name, [object]$Value)
+    $bytes = $taskUtf8.GetBytes((ConvertTo-Json -InputObject $Value -Depth 15))
+    $stream = [IO.File]::Open((Join-Path $taskOutputRoot $Name), 'CreateNew', 'Write', 'None')
+    try {
+        $stream.Write($bytes, 0, $bytes.Length)
+        $stream.Flush($true)
+    }
+    finally { $stream.Dispose() }
