+            $entryKeys = if ($entry -is [Collections.IDictionary]) { @($entry.Keys) }
+                elseif ($entry -is [pscustomobject]) { @($entry.PSObject.Properties.Name) } else { @() }
+            if (@('kind', 'path', 'status', 'sha256', 'length' | Where-Object { $_ -cnotin $entryKeys }).Count -ne 0) { continue }
+            if ($entry.kind -ceq 'Preparation' -and $entry.path -ceq [IO.Path]::Combine($state.Suite, 'preparation.json') -and
+                $entry.status -ceq 'Missing' -and $null -eq $entry.sha256 -and $null -eq $entry.length) {
+                $missingPreparation++
