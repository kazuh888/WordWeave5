+      "characterLength": 7755,
+      "text": "function New-FirstFailureRecord {\n    # Pure fixed-field projection; no input enumeration or implicit scalar conversion.\n    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUseShouldProcessForStateChangingFunctions', '',\n        Justification = 'Pure in-memory diagnostic projection; no state changes or external operations.')]\n    param([hashtable]$Context, [object]$Callsite, [object]$FailureObservation,\n        [string]$Status, [object]$AbortUtc, [object]$AbortTick)\n    $integer = {\n        param([object]$Value, [long]$Minimum, [long]$Maximum)\n        return (($Value -is [byte] -or $Value -is [sbyte] -or $Value -is [int16] -or\n            $Value -is [uint16] -or $Value -is [int32] -or $Value -is [uint32] -or\n            $Value -is [int64] -or $Value -is [uint64]) -and $Value -ge $Minimum -and $Value -le $Maximum)\n    }\n    $utc = {\n        param([object]$Value)\n        try { $null = Get-Utc -Value $Value; return $true }\n        catch { return $false }\n    }\n    $exceptionType = {\n        param([object]$Value)\n        if ($Value -is [string] -and $Value.Length -ge 1 -and $Value.Length -le 256 -and\n            $Value -cmatch '^[A-Za-z0-9_.+\\x60]+$') { return $Value }\n        return $null\n    }\n    $runGuid = [guid]::Empty\n    if ($null -eq $Context -or $Context.runId -isnot [string] -or $Context.runId.Length -ne 36 -or\n        -not [guid]::TryParseExact($Context.runId, 'D', [ref]$runGuid) -or\n        $Context.runDirectory -isnot [string] -or -not [IO.Path]::IsPathFullyQualified($Context.runDirectory) -or\n        $Context.runSha256 -isnot [string] -or $Context.runSha256 -cnotmatch '^[A-F0-9]{64}$' -or\n        $Context.gateSourceSha256 -isnot [string] -or $Context.gateSourceSha256 -cnotmatch '^[A-F0-9]{64}$' -or\n        $Context.role -isnot [string] -or $Context.role -cnotin @('RunOwner', 'Supervisor', 'Runner', 'SafetyWorker') -or\n        -not (& $integer $Context.actorPid 1 ([int]::MaxValue)) -or $Context.actorPid -ne $PID -or\n        -not (& $utc $Context.actorStartTimeUtc) -or\n        -not (& $integer $Context.actorStartTicks 0 ([long]::MaxValue)) -or\n        $Context.actorStartTicks -ne (Get-Utc -Value $Context.actorStartTimeUtc).UtcTicks -or\n        $Callsite -isnot [string] -or\n        $Callsite -cnotin @('OwnedTree.IdentityCatch', 'OwnedTree.RunBoundParentEdge', 'GateFailure.Other') -or\n        $Status -cnotin @('Rejected', 'Cancelled', 'TimedOut', 'OwnerLost', 'CleanupIncomplete', 'Completed') -or\n        $AbortUtc -isnot [DateTimeOffset] -or $AbortUtc.Offset -ne [TimeSpan]::Zero -or\n        $AbortTick -isnot [double] -or -not [double]::IsFinite($AbortTick) -or $AbortTick -lt 0) { return $null }\n    $failure = $null\n    if ($FailureObservation -is [Collections.IDictionary]) {\n        $failure = @{ ownership = $null; killRequested = $null; waited = $null; hasExited = $null\n            candidate = $null; osObservation = $null }\n        if ($FailureObservation['ownership'] -is [string] -and $FailureObservation['ownership'] -ceq 'Unprovable') {\n            $failure.ownership = 'Unprovable'\n        }\n        foreach ($field in @('killRequested', 'waited')) {\n            if ($FailureObservation[$field] -is [bool] -and -not $FailureObservation[$field]) { $failure[$field] = $false }\n        }\n        $identity = $FailureObservation['identity']\n        if ($identity -is [Collections.IDictionary]) {\n            $failure.candidate = @{ pid = $null; startTimeUtc = $null }\n            if (& $integer $identity['pid'] 1 ([int]::MaxValue)) { $failure.candidate.pid = $identity['pid'] }\n            if (& $utc $identity['startTimeUtc']) { $failure.candidate.startTimeUtc = $identity['startTimeUtc'] }\n        }\n        $observation = $FailureObservation['osObservation']\n        if ($observation -is [Collections.IDictionary]) {\n            $projected = @{ pid = $null; parentPid = $null; creationUtc = $null; pathPresent = $null; commandPresent = $null\n                snapshotMatchCount = $null; knownMatchCount = $null; exceptionType = $null; exceptionLine = $null\n                rowFilterMatchCount = $null; rowFilterPathPresent = $null; rowFilterCommandPresent = $null }\n            foreach ($field in @('pid', 'parentPid', 'snapshotMatchCount', 'knownMatchCount', 'exceptionLine', 'rowFilterMatchCount')) {\n                $minimum = if ($field -cin @('pid', 'exceptionLine')) { 1 } else { 0 }\n                $maximum = if ($field -cin @('pid', 'parentPid')) { [long][uint32]::MaxValue } else { [long][int]::MaxValue }\n                if (& $integer $observation[$field] $minimum $maximum) { $projected[$field] = $observation[$field] }\n            }\n            foreach ($field in @('pathPresent', 'commandPresent', 'rowFilterPathPresent', 'rowFilterCommandPresent')) {\n                if ($observation[$field] -is [bool]) { $projected[$field] = $observation[$field] }\n            }\n            if (& $utc $observation['creationUtc']) { $projected.creationUtc = $observation['creationUtc'] }\n            $projected.exceptionType = & $exceptionType $observation['exceptionType']\n            if ($observation['producerFailure'] -is [Collections.IDictionary]) {\n                $producer = $observation['producerFailure']\n                $projected.producerFailure = @{ exceptionType = (& $exceptionType $producer['exceptionType']); exceptionLine = $null }\n                if (& $integer $producer['exceptionLine'] 1 ([int]::MaxValue)) {\n                    $projected.producerFailure.exceptionLine = $producer['exceptionLine']\n                }\n            }\n            if ($observation['acquisition'] -is [Collections.IDictionary]) {\n                # Optional diagnostic scalars never become ownership evidence.\n                try {\n                    $acquisition = $observation['acquisition']\n                    $acquired = @{ snapshotStartedUtc = $null; snapshotCompletedUtc = $null\n                        attemptUtc = $null; failedUtc = $null; stage = $null; exceptionHResult = $null\n                        innerType = $null; innerHResult = $null; nativeErrorCode = $null }\n                    foreach ($field in @('snapshotStartedUtc', 'snapshotCompletedUtc', 'attemptUtc', 'failedUtc')) {\n                        if (& $utc $acquisition[$field]) { $acquired[$field] = $acquisition[$field] }\n                    }\n                    if ($acquisition['stage'] -is [string] -and\n                        $acquisition['stage'] -cin @('LookupHandle', 'PinHandle', 'ReadIdentity')) {\n                        $acquired.stage = $acquisition['stage']\n                    }\n                    foreach ($field in @('exceptionHResult', 'innerHResult', 'nativeErrorCode')) {\n                        if (& $integer $acquisition[$field] ([int]::MinValue) ([int]::MaxValue)) {\n                            $acquired[$field] = $acquisition[$field]\n                        }\n                    }\n                    $acquired.innerType = & $exceptionType $acquisition['innerType']\n                    $projected.acquisition = $acquired\n                }\n                catch {\n                    # Preserve the original FF projection when optional diagnostics fail.\n                    $null = $projected.Remove('acquisition')\n                }\n            }\n            $failure.osObservation = $projected\n        }\n    }\n    return @{ diagnosticKind = 'FirstGateFailure'; schemaVersion = 1; runId = $Context.runId\n        runSha256 = $Context.runSha256; gateSourceSha256 = $Context.gateSourceSha256; role = $Context.role\n        actor = @{ pid = $Context.actorPid; startTimeUtc = $Context.actorStartTimeUtc }\n        callsite = $Callsite; status = $Status; firstAbortUtc = $AbortUtc.ToString('yyyy-MM-ddTHH:mm:ss.fffffffZ')\n        firstAbortTickSeconds = $AbortTick; failure = $failure }\n}",
