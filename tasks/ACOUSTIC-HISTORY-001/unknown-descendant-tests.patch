+﻿<#
+.SYNOPSIS
+    Runs the fixed 33 memory preparation inputs after parent freeze
+.DESCRIPTION
+    Imports only the original extracted private core and independent memory modules.
+    Original source main and production ports are never imported. Saves one new result.
+.EXAMPLE
+    ./Invoke-PreparationSuite.ps1
+.NOTES
+    PowerShell 7.6.7; no Pester or automatic registry/test drive initialization.
+    Author preparation only; execute once through the approved receipt after Pre/freeze.
+    Exit 0 all33 PASS; 1 BehaviorMismatch; 2 AdapterFailure. First unexpected stops, retry0.
+#>
+#Requires -Version 7.6
+[CmdletBinding()]
+param()
+Set-StrictMode -Version 3.0
+$ErrorActionPreference = 'Stop'
+try {
+    if ($PSVersionTable.PSVersion.ToString() -cne '7.6.7') { throw 'AdapterFailure: runtime version' }
+    $bindingPath = Join-Path $PSScriptRoot 'binding-final.json'
+    $binding = Get-Content -LiteralPath $bindingPath -Raw -Encoding utf8 | ConvertFrom-Json -AsHashtable
+    if ($binding.sourceSha256 -cne '4C1612F8731DA936F32B69455694AE5129527D7143F5BD52797B7F8BEFB978BC' -or
+        $binding.allowedSubstitutions.Count -ne 0 -or -not $binding.inverseWholeBytes -or
+        (Get-FileHash -LiteralPath $binding.sourcePath).Hash -cne $binding.sourceSha256) {
+        throw 'AdapterFailure: original binding/source drift'
+    }
+    $modulePath = Join-Path $PSScriptRoot 'BoundPreparation.psm1'
+    if ((Get-FileHash -LiteralPath $modulePath).Hash -cne $binding.moduleSha256) {
+        throw 'AdapterFailure: extracted original module drift'
+    }
+    $oraclePath = Join-Path $PSScriptRoot 'expectations.json'
+    if ((Get-FileHash -LiteralPath $oraclePath).Hash -cne 'CAA26281E5EF932156118720997491AE1E3EB55ED9DF0365F32197C6F8979353') {
+        throw 'AdapterFailure: independent oracle drift'
+    }
+    $oracle = Get-Content -LiteralPath $oraclePath -Raw -Encoding utf8 | ConvertFrom-Json -AsHashtable
+    Import-Module -Name (Join-Path $PSScriptRoot 'PreparationMemory.psm1') -Force
+    Import-Module -Name (Join-Path $PSScriptRoot 'PreparationAssertions.psm1') -Force
+    Import-Module -Name (Join-Path $PSScriptRoot 'PreparationController.psm1') -Force
+    Import-Module -Name $modulePath -Force
+    $core = Get-Command Invoke-Env01Preparation -CommandType Function -ErrorAction Stop
+    if ([IO.Path]::GetFullPath($core.ScriptBlock.File) -cne [IO.Path]::GetFullPath($modulePath)) {
+        throw 'AdapterFailure: private function origin'
+    }
+    $suiteResult = Invoke-PreparationInputSet -Preparation $core.ScriptBlock -Expectations $oracle
+    $resultPath = Join-Path $PSScriptRoot '57e30fae-cd20-4dcc-babf-a9e8521178c8/suite-result.json'
+    $bytes = [Text.UTF8Encoding]::new($false, $true).GetBytes(($suiteResult | ConvertTo-Json -Depth 20 -Compress))
+    $stream = [IO.File]::Open($resultPath, 'CreateNew', 'Write', 'None')
+    try {
+        $stream.Write($bytes, 0, $bytes.Length)
+        $stream.Flush($true)
+    }
+    finally { $stream.Dispose() }
+    if ($suiteResult.exitCode -eq 0 -and ($suiteResult.passedInputs -ne 33 -or
+        @($suiteResult.groups | Where-Object status -CNE 'PASS').Count -ne 0 -or
+        $null -ne $suiteResult.firstUnexpected)) { throw 'AdapterFailure: all33 acceptance count' }
+    Write-Output ('PREPARATION_RESULT:' + $suiteResult.exitCode + ';passed=' + $suiteResult.passedInputs +
+        ';firstUnexpected=' + $suiteResult.firstUnexpected + ';retry=0')
+    exit $suiteResult.exitCode
+}
+catch {
+    [Console]::Error.WriteLine(('PREPARATION_RESULT:2;AdapterFailure;' + $_.Exception.Message))
+    exit 2
+}
