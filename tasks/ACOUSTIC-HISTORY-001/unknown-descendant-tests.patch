+fn json_fields(bytes:&[u8])->Result<BTreeMap<String,String>,String> {
+ let text=std::str::from_utf8(bytes).map_err(|_|"sidecar invalid UTF8")?;
+ check(text.starts_with('{')&&text.ends_with('}'),"sidecar object required")?;
+ let body=&text[1..text.len()-1];
+ let mut pieces=Vec::new();
+ let (mut quoted,mut escaped,mut depth,mut start)=(false,false,0i32,0usize);
+ for (offset,c) in body.char_indices() {
+  if quoted {
+   if escaped { escaped=false; }
+   else if c=='\\' { escaped=true; }
+   else if c=='"' { quoted=false; }
+  } else {
+   match c {
+    '"'=>quoted=true, '['=>depth+=1, ']'=>depth-=1,
+    ',' if depth==0=>{pieces.push(&body[start..offset]);start=offset+1;}, _=>{}
+   }
+   check(depth>=0,"invalid array nesting")?;
+  }
+ }
+ check(!quoted&&depth==0,"unterminated sidecar JSON")?;
+ pieces.push(&body[start..]);
+ let mut map=BTreeMap::new();
+ for piece in pieces {
+  let (key,value)=piece.split_once(':').ok_or("sidecar key separator missing")?;
+  let key=key.trim();
+  check(key.starts_with('"')&&key.ends_with('"')&&key.len()>2,"invalid key")?;
+  check(map.insert(key[1..key.len()-1].to_string(),value.trim().to_string()).is_none(),"duplicate key")?;
+ }
+ Ok(map)
+}
+fn message_array(value:&str)->Result<Option<Vec<u16>>,String> {
+ if value=="null" { return Ok(None); }
+ check(value.starts_with('[')&&value.ends_with(']'),"messageUtf16 array or null")?;
+ let body=&value[1..value.len()-1];
+ if body.is_empty() { return Ok(Some(Vec::new())); }
+ let mut values=Vec::new();
+ for token in body.split(',') {
+  values.push(token.parse::<u16>().map_err(|_|"messageUtf16 u16 required")?);
+ }
+ Ok(Some(values))
+}
+fn assert_sidecar(bytes:&[u8],stage:&str,kind:&str,raw:Option<i32>,
+ expected_message:Option<&[u16]>,status:&str)->Result<(),String> {
+ check(bytes.len()<=8192,"sidecar byte budget")?;
+ let f=json_fields(bytes)?;
+ let expected=["schemaVersion","pid","stage","errorKind","rawOsError","messageUtf16","messageStatus"];
+ check(f.len()==7&&expected.iter().all(|k|f.contains_key(*k)),"sidecar strict7 keys")?;
+ check(f["schemaVersion"]=="1"&&f["pid"]=="7","schema and synthetic pid")?;
+ check(f["stage"]==format!("\"{stage}\""),"stage preserved")?;
+ check(f["errorKind"]==format!("\"{kind}\""),"kind preserved")?;
+ check(f["rawOsError"]==raw.map(|v|v.to_string()).unwrap_or_else(||"null".into()),"raw code preserved")?;
+ check(f["messageStatus"]==format!("\"{status}\""),"message status")?;
+ let values=message_array(&f["messageUtf16"])?;
+ check(values.as_deref()==expected_message,"message whitelist/boundary")?;
+ if let Some(values)=values { check(values.len()<=2048,"message unit limit")?; }
+ Ok(())
+}
+fn sidecar_bytes()->Result<Vec<u8>,String> {
+ MEMORY.lock().unwrap().files.get(&failure_path()).cloned().ok_or("sidecar missing".into())
