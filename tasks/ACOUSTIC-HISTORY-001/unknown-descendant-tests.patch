+﻿#Requires -Version 7.6
+Set-StrictMode -Version 3.0
+$ErrorActionPreference = 'Stop'
+
+function Invoke-PreparationInputSet {
+    <#
+    .SYNOPSIS
+        Runs exactly the frozen 33 inputs after an independently approved binding exists
+    .PARAMETER Preparation
+        Original private function, uniquely extracted and source-bound by the future approved adapter.
+        This module never reads or imports candidate source and cannot grant binding approval.
+    .PARAMETER Expectations
+        Unmodified CAA26281 JSON hashtable; checked by the outer frozen runner before invocation.
+    .EXAMPLE
+        Invoke-PreparationInputSet -Preparation $approvedFunction -Expectations $frozenOracle
+    .NOTES
+        PowerShell 7.6.7; import the two same-packet fixture/assertion modules first.
+        Every input has attempts1/retry0. First unexpected stops; later rows stay NotRun.
+        5s/group and 30s/collection are monotonic pre/post guards, not hard OS cancellation.
+        Memory ports additionally bound operation count. No process or filesystem operation occurs here.
+    #>
+    [CmdletBinding()]
+    [OutputType([hashtable])]
+    param([Parameter(Mandatory)][scriptblock]$Preparation, [Parameter(Mandatory)][hashtable]$Expectations)
+    $rows = @($Expectations.inputs)
+    if ($rows.Count -ne 33 -or ($Expectations.counts.perGroup -join ',') -cne '5,6,7,6,4,5') {
+        throw 'AdapterFailure: independent 33-input count differs'
+    }
+    $results = @($rows | ForEach-Object {
+        @{ id = $_.id; status = 'NotRun'; attempts = 0; retry = 0; classification = $null; detail = $null }
+    })
+    $groups = @(1..6 | ForEach-Object {
+        @{ id = ('G' + $_); expectedInputs = $Expectations.counts.perGroup[$_ - 1]; status = 'NotRun'; elapsedSeconds = 0.0 }
+    })
+    $collectionClock = [Diagnostics.Stopwatch]::StartNew()
+    $firstUnexpected = $null
+    $exitCode = 0
+    $index = 0
+    foreach ($group in $groups) {
+        if ($null -ne $firstUnexpected) { break }
+        $groupClock = [Diagnostics.Stopwatch]::StartNew()
+        $group.status = 'Running'
+        for ($inputIndex = 0; $inputIndex -lt $group.expectedInputs; $inputIndex++) {
+            $record = $results[$index]
+            $row = $rows[$index]
+            $index++
+            try {
+                if ($groupClock.Elapsed.TotalSeconds -ge 5 -or $collectionClock.Elapsed.TotalSeconds -ge 30) {
+                    throw 'AdapterFailure: group/collection deadline before input'
+                }
+                if (-not $row.id.StartsWith($group.id + '-', [StringComparison]::Ordinal)) {
+                    throw 'AdapterFailure: independent input ordering differs'
+                }
+                $fixture = Get-PreparationFixture -Id $row.id
+                $record.attempts = 1
+                $record.status = 'Running'
+                try { $actual = @(& $Preparation -Inputs $fixture.Inputs -Ports $fixture.Ports) }
+                catch {
+                    if ($_.Exception.Message.StartsWith('AdapterFailure:', [StringComparison]::Ordinal)) { throw }
+                    throw ('BehaviorMismatch: uncaught candidate exception for ' + $row.id + ': ' + $_.Exception.Message)
+                }
+                if ($groupClock.Elapsed.TotalSeconds -ge 5 -or $collectionClock.Elapsed.TotalSeconds -ge 30) {
+                    throw 'AdapterFailure: group/collection deadline after input'
+                }
+                $record.detail = Test-PreparationResult -Fixture $fixture -Result $actual -Expectation $row
+                $record.status = 'PASS'
+                $record.classification = 'BehaviorMatched'
+            }
+            catch {
+                $record.status = 'Failed'
+                $record.detail = $_.Exception.Message
+                if ($_.Exception.Message.StartsWith('BehaviorMismatch:', [StringComparison]::Ordinal)) {
+                    $record.classification = 'BehaviorMismatch'
+                    $exitCode = 1
+                }
+                else {
+                    $record.classification = 'AdapterFailure'
+                    $exitCode = 2
+                }
+                $firstUnexpected = $row.id
+                $group.status = 'Failed'
+                break
+            }
+        }
+        $groupClock.Stop()
+        $group.elapsedSeconds = $groupClock.Elapsed.TotalSeconds
+        if ($group.status -ceq 'Running') { $group.status = 'PASS' }
+    }
+    $collectionClock.Stop()
+    return @{ schemaVersion = 1; exitCode = $exitCode; firstUnexpected = $firstUnexpected; retry = 0
+        groupLimitSeconds = 5; collectionLimitSeconds = 30; elapsedSeconds = $collectionClock.Elapsed.TotalSeconds
+        groups = $groups; inputs = $results; passedInputs = @($results | Where-Object status -CEQ 'PASS').Count
+        executionBoundary = 'Private function and memory ports only; no source main/production ports/real process' }
+}
+
+Export-ModuleMember -Function Invoke-PreparationInputSet
