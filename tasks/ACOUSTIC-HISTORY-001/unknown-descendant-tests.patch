+      "text": "function Read-OwnedTree {\n    if ($Mode -ceq 'RunOwner' -and $null -eq $script:Manifest -and\n        [IO.File]::Exists((Join-Path $script:RunDirectory 'manifest.json'))) { Read-Manifest }\n    $snapshotStartedUtc = $null\n    $snapshotCompletedUtc = $null\n    try { $snapshotStartedUtc = [DateTimeOffset]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ss.fffffffZ') }\n    catch { $snapshotStartedUtc = $null }\n    $rows = Get-OsProcess\n    try { $snapshotCompletedUtc = [DateTimeOffset]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ss.fffffffZ') }\n    catch { $snapshotCompletedUtc = $null }\n    foreach ($known in @($script:Known.Values)) {\n        $known.handle.Refresh()\n        if ($known.handle.HasExited -and $null -eq $known.exitUtc) {\n            $known.exitUtc = $known.handle.ExitTime.ToUniversalTime()\n        }\n    }\n    $changed = $true\n    while ($changed) {\n        $changed = $false\n        foreach ($row in $rows) {\n            if ([int]$row.ProcessId -eq $PID) { continue }\n            $handle = $null\n            $acquisitionAttemptUtc = $null\n            $acquisitionStage = $null\n            try {\n                # Reuse only a unique generation proved against this original snapshot.\n                $samePid = @($script:Known.GetEnumerator() | Where-Object { $_.Value.identity.pid -eq [int]$row.ProcessId })\n                if ($samePid.Count -gt 0) {\n                    $sameRows = @($rows | Where-Object { [int]$_.ProcessId -eq [int]$row.ProcessId })\n                    if ($sameRows.Count -ne 1) { throw 'Known process snapshot row is not unique' }\n                    $creation = $row.CreationDate\n                    if ($creation -isnot [DateTime] -or $creation.Kind -eq [DateTimeKind]::Unspecified) {\n                        throw 'CIM process creation time is unavailable or has no time zone'\n                    }\n                    $precision = 'yyyy-MM-ddTHH:mm:ss.ffffffZ'\n                    $creationUtc = $creation.ToUniversalTime().ToString($precision, [Globalization.CultureInfo]::InvariantCulture)\n                    $sameGeneration = @(\n                        foreach ($entry in $samePid) {\n                            $knownKey = Get-IdentityKey $entry.Value.identity\n                            if (-not [string]::Equals($entry.Key, $knownKey, [StringComparison]::Ordinal)) {\n                                throw 'Known process ledger key does not match its identity'\n                            }\n                            $knownUtc = (Get-Utc $entry.Value.identity.startTimeUtc).UtcDateTime\n                            if ($knownUtc.ToString($precision, [Globalization.CultureInfo]::InvariantCulture) -ceq $creationUtc) {\n                                $entry\n                            }\n                        }\n                    )\n                    if ($sameGeneration.Count -gt 1) { throw 'Known process generation is ambiguous' }\n                    if ($sameGeneration.Count -eq 1) {\n                        $entry = $sameGeneration[0]\n                        $knownIdentity = $entry.Value.identity\n                        if ($knownIdentity.path -isnot [string] -or\n                            ($knownIdentity.parentPid -isnot [int] -and $knownIdentity.parentPid -isnot [long]) -or\n                            $knownIdentity.commandLineUtf16 -isnot [array]) {\n                            throw 'Known process identity is incomplete'\n                        }\n                        # Borrowed handles never enter the local new-handle disposal path.\n                        $borrowedPinned = $entry.Value.pinnedHandle\n                        if ($null -eq $borrowedPinned -or $borrowedPinned.IsClosed -or $borrowedPinned.IsInvalid) {\n                            throw 'Known process pinned handle is unavailable'\n                        }\n                        $borrowedProcess = $entry.Value.handle\n                        if ($borrowedProcess -isnot [Diagnostics.Process] -or $borrowedProcess.Id -ne [int]$row.ProcessId -or\n                            -not [object]::ReferenceEquals($borrowedProcess.SafeHandle, $borrowedPinned)) {\n                            throw 'Known process does not retain the registered handle'\n                        }\n                        if ($null -eq $row.PSObject.Properties['ExecutablePath'] -or\n                            $null -eq $row.PSObject.Properties['CommandLine']) {\n                            throw 'Known process snapshot identity properties are absent'\n                        }\n                        if (($null -ne $row.ExecutablePath -and $row.ExecutablePath -isnot [string]) -or\n                            ($null -ne $row.CommandLine -and $row.CommandLine -isnot [string])) {\n                            throw 'Known process snapshot path or command has an invalid type'\n                        }\n                        if ($null -eq $row.ExecutablePath -or $null -eq $row.CommandLine) {\n                            # Missing values are not observations; retain only a fully proved registration.\n                            Assert-Field $knownIdentity @('pid', 'startTimeUtc', 'path', 'parentPid', 'commandLineUtf16')\n                            if ($knownIdentity.Count -ne 5 -or\n                                ($knownIdentity.pid -isnot [int] -and $knownIdentity.pid -isnot [long]) -or\n                                $knownIdentity.pid -le 0 -or $knownIdentity.pid -gt [int]::MaxValue -or\n                                $knownIdentity.pid -ne $borrowedProcess.Id -or\n                                $knownIdentity.path -isnot [string] -or [string]::IsNullOrWhiteSpace($knownIdentity.path) -or\n                                -not [IO.Path]::IsPathFullyQualified($knownIdentity.path) -or\n                                ($knownIdentity.parentPid -isnot [int] -and $knownIdentity.parentPid -isnot [long]) -or\n                                $knownIdentity.parentPid -lt 0 -or $knownIdentity.parentPid -gt [int]::MaxValue -or\n                                $knownIdentity.commandLineUtf16 -isnot [array]) {\n                                throw 'Known process registration is incomplete'\n                            }\n                            $null = Get-Utc $knownIdentity.startTimeUtc\n                            foreach ($unit in $knownIdentity.commandLineUtf16) {\n                                if (($unit -isnot [int] -and $unit -isnot [long]) -or $unit -lt 0 -or $unit -gt 65535) {\n                                    throw 'Known process registered command has an invalid code unit'\n                                }\n                            }\n                            $knownEvidence = $entry.Value.ownershipEvidence\n                            Assert-Field $knownEvidence @('kind', 'osQueryStatus')\n                            if ($knownEvidence.kind -isnot [string] -or\n                                $knownEvidence.kind -cnotin @('OsQuery', 'DirectLaunchHandle') -or\n                                $knownEvidence.osQueryStatus -isnot [string] -or\n                                -not [string]::Equals($knownEvidence.osQueryStatus, 'Observed', [StringComparison]::Ordinal)) {\n                                throw 'Known process registration has no complete observation evidence'\n                            }\n                            foreach ($field in @('ProcessId', 'ParentProcessId', 'CreationDate')) {\n                                if ($null -eq $row.PSObject.Properties[$field]) {\n                                    throw 'Known process snapshot generation properties are absent'\n                                }\n                            }\n                            if (($row.ProcessId -isnot [uint32] -and $row.ProcessId -isnot [int] -and\n                                    $row.ProcessId -isnot [long]) -or\n                                $row.ProcessId -le 0 -or $row.ProcessId -gt [int]::MaxValue -or\n                                ($row.ParentProcessId -isnot [uint32] -and $row.ParentProcessId -isnot [int] -and\n                                    $row.ParentProcessId -isnot [long]) -or\n                                $row.ParentProcessId -lt 0 -or $row.ParentProcessId -gt [int]::MaxValue) {\n                                throw 'Known process snapshot PID or parent has an invalid type or range'\n                            }\n                            if ([int]$row.ProcessId -ne $knownIdentity.pid -or\n                                [int]$row.ParentProcessId -ne $knownIdentity.parentPid) {\n                                throw 'Known process snapshot PID or parent contradicts its registration'\n                            }\n                            $borrowedProcess.Refresh()\n                            $retainedStarted = $borrowedProcess.StartTime.ToUniversalTime()\n                            if (-not [string]::Equals(\n                                    $retainedStarted.ToString($precision, [Globalization.CultureInfo]::InvariantCulture),\n                                    $creationUtc, [StringComparison]::Ordinal) -or\n                                -not [string]::Equals(\n                                    $retainedStarted.ToString('yyyy-MM-ddTHH:mm:ss.fffffffZ', [Globalization.CultureInfo]::InvariantCulture),\n                                    $knownIdentity.startTimeUtc, [StringComparison]::Ordinal)) {\n                                throw 'Known process retained start time does not match its snapshot and registration'\n                            }\n                            if ($null -ne $row.ExecutablePath) {\n                                $observedPath = Get-CanonicalPath -Path ([string]$row.ExecutablePath)\n                                if (-not (Test-EqualData $observedPath $knownIdentity.path)) {\n                                    throw 'Known process snapshot path contradicts its registration'\n                                }\n                            }\n                            if ($null -ne $row.CommandLine) {\n                                $observedCommand = ConvertTo-CodeUnit -Text ([string]$row.CommandLine)\n                                if (-not (Test-EqualData $observedCommand $knownIdentity.commandLineUtf16)) {\n                                    throw 'Known process snapshot command contradicts its registration'\n                                }\n                            }\n                        }\n                        else {\n                            $knownActual = Get-Identity $borrowedProcess $rows\n                            if (-not (Test-EqualData $knownActual $knownIdentity) -or\n                                -not [string]::Equals((Get-IdentityKey $knownActual), $entry.Key, [StringComparison]::Ordinal)) {\n                                throw 'Known process snapshot and retained identity do not match'\n                            }\n                        }\n                        if ($borrowedPinned.IsClosed -or $borrowedPinned.IsInvalid -or\n                            -not [object]::ReferenceEquals($borrowedProcess.SafeHandle, $borrowedPinned)) {\n                            throw 'Known process pinned handle changed during identity observation'\n                        }\n                        continue\n                    }\n                }\n                $parents = @($script:Known.Values | Where-Object { $_.identity.pid -eq [int]$row.ParentProcessId })\n                if ($parents.Count -eq 0) { continue }\n                $acquisitionStage = 'LookupHandle'\n                try { $acquisitionAttemptUtc = [DateTimeOffset]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ss.fffffffZ') }\n                catch { $acquisitionAttemptUtc = $null }\n                $handle = [Diagnostics.Process]::GetProcessById([int]$row.ProcessId)\n                $acquisitionStage = 'PinHandle'\n                $null = $handle.SafeHandle\n                $acquisitionStage = 'ReadIdentity'\n                $identity = Get-Identity $handle $rows\n                $key = Get-IdentityKey $identity\n                if ($script:Known.ContainsKey($key)) { throw 'New process identity unexpectedly matches an existing ledger key' }\n                $started = Get-Utc $identity.startTimeUtc\n                $validParents = @($parents | Where-Object {\n                        $started -ge (Get-Utc $_.identity.startTimeUtc) -and\n                        ($null -eq $_.exitUtc -or $started.UtcDateTime -le $_.exitUtc)\n                    })\n                if ($validParents.Count -ne 1) { throw 'Process edge cannot be proved inside parent lifetime' }\n                Add-KnownProcess -Handle $handle -Identity $identity -Role 'Target'\n                $handle = $null\n                $changed = $true\n            }\n            catch {\n                # Never promote PID-only metadata or a mismatching generation into Owned.\n                $caught = $_\n                try { $observation = Get-IdentityFailureObservation -Row $row -Rows $rows -KnownValues @($script:Known.Values) -Caught $caught }\n                catch {\n                    $observation = @{ pid = $null; parentPid = $null; creationUtc = $null; pathPresent = $null; commandPresent = $null\n                        snapshotMatchCount = $null; knownMatchCount = $null; exceptionType = $null; exceptionLine = $null\n                        rowFilterMatchCount = $null; rowFilterPathPresent = $null; rowFilterCommandPresent = $null\n                        producerFailure = @{ exceptionType = $_.Exception.GetType().FullName; exceptionLine = $_.InvocationInfo.ScriptLineNumber } }\n                }\n                if ($null -ne $acquisitionStage) {\n                    try {\n                        $acquisition = @{ snapshotStartedUtc = $snapshotStartedUtc; snapshotCompletedUtc = $snapshotCompletedUtc\n                            attemptUtc = $acquisitionAttemptUtc; failedUtc = $null; stage = $acquisitionStage\n                            exceptionHResult = $null; innerType = $null; innerHResult = $null; nativeErrorCode = $null }\n                        try { $acquisition.failedUtc = [DateTimeOffset]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ss.fffffffZ') }\n                        catch { $acquisition.failedUtc = $null }\n                        try { $acquisition.exceptionHResult = $caught.Exception.HResult }\n                        catch { $acquisition.exceptionHResult = $null }\n                        $innerException = $null\n                        try { $innerException = $caught.Exception.InnerException }\n                        catch { $innerException = $null }\n                        if ($null -ne $innerException) {\n                            try { $acquisition.innerType = $innerException.GetType().FullName }\n                            catch { $acquisition.innerType = $null }\n                            try { $acquisition.innerHResult = $innerException.HResult }\n                            catch { $acquisition.innerHResult = $null }\n                            if ($innerException -is [ComponentModel.Win32Exception]) {\n                                try { $acquisition.nativeErrorCode = $innerException.NativeErrorCode }\n                                catch { $acquisition.nativeErrorCode = $null }\n                            }\n                        }\n                        $observation.acquisition = $acquisition\n                    }\n                    catch {\n                        # The retained original error still drives Unprovable and FF.\n                        $null = $observation.Remove('acquisition')\n                    }\n                }\n                $script:Unprovable.Add(@{ identity = $null; killRequested = $false; waited = $false\n                    hasExited = $null; ownership = 'Unprovable'\n                    error = \"Unproved descendant identity; PID=$($row.ProcessId): $($caught.Exception.Message)\"\n  