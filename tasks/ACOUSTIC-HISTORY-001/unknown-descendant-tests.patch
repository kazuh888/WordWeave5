+$ErrorActionPreference = 'Stop'
+$PSNativeCommandUseErrorActionPreference = $false
+$taskOutputRoot = Join-Path $PSScriptRoot '57e30fae-cd20-4dcc-babf-a9e8521178c8'
+$taskFixed = @(
