+﻿<#
+.SYNOPSIS
+    Tests the approved PSSA capture contract with fixed memory inputs
+.DESCRIPTION
+    OldRed extracts the saved assignment and catch without running PSSA.
+    Unit20 extracts only the collector's three private functions and state seed.
+    Candidate top-level code, real analyzer invocation and real learning data are never used.
+    Each phase requires an independently reviewed binding and parent freeze before execution.
+.PARAMETER BindingPath
+    Absolute path of the frozen phase-specific binding.
+.PARAMETER OutputRoot
+    New, isolated leaf below this packet's pssa-capture/out directory.
+.EXAMPLE
+    ./Test-PssaCapture.ps1 -BindingPath ./old-red-binding.json -OutputRoot ./out/old-red-UUID
+.NOTES
+    Author: CAP-T independent test author; Created: 2026-10-24
+    Requires: PowerShell 7.6.7 (ps7), PSScriptAnalyzer 1.25.0 types only
+    Exit: 0 = Unit20 accepted; 1 = specific OldRed accepted; 2 = any unexpected result
+    Fixed direct assertions follow the approved packet CLI; no Pester discovery or TestDrive is used.+#>
+#Requires -Version 7.6
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$BindingPath,
+    [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$OutputRoot
+)
+
+Set-StrictMode -Version 3.0
+$ErrorActionPreference = 'Stop'
+
+function Assert-CapCondition {
+    param([bool]$Condition, [string]$Message, [string]$Category = 'BehaviorMismatch')
+    if (-not $Condition) { throw ($Category + ': ' + $Message) }
+}
+
+function Get-CapHash {
+    param([byte[]]$Bytes)
+    return [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($Bytes))
+}
+
+function Test-CapKeys {
+    param([object]$Value, [object[]]$Keys, [string]$Label)
+    Assert-CapCondition ($Value -is [Collections.IDictionary]) ($Label + ' dictionary')
+    Assert-CapCondition ((@($Value.Keys | Sort-Object) -join ',') -ceq
+        (@($Keys | Sort-Object) -join ',')) ($Label + ' exact keys')
+}
+
+function Test-CapPins {
+    param([hashtable]$Binding)
+    foreach ($pin in $Binding.pins) {
+        $actual = (Get-FileHash -LiteralPath $pin.path -Algorithm SHA256).Hash
+        Assert-CapCondition ($actual -ceq $pin.sha256) ('pin drift: ' + $pin.path) 'AdapterFailure'
+        @{ path = $pin.path; sha256 = $actual }
+    }
+}
+
+function Get-CapAst {
+    param([string]$Text)
+    $tokens = $null
+    $parseErrors = $null
+    $ast = [Management.Automation.Language.Parser]::ParseInput($Text, [ref]$tokens, [ref]$parseErrors)
+    Assert-CapCondition (@($parseErrors).Count -eq 0) 'extract parser errors' 'AdapterFailure'
+    return $ast
+}
+
+function Get-CapOldAdapter {
+    param([hashtable]$Binding)
+    $saved = Get-Content -LiteralPath $Binding.oldSource.path -Raw -Encoding utf8 | ConvertFrom-Json -AsHashtable
+    $command = $saved.staticRequests.pssa.cmd
+    $utf8 = [Text.UTF8Encoding]::new($false)
+    Assert-CapCondition ((Get-CapHash $utf8.GetBytes($command)) -ceq $Binding.oldSource.commandSha256) `
+        'saved request command hash' 'AdapterFailure'
+    $ast = Get-CapAst $command
+    $tries = @($ast.FindAll({ param($node) $node -is [Management.Automation.Language.TryStatementAst] }, $true))
+    Assert-CapCondition ($tries.Count -eq 1) 'unique saved try/catch' 'AdapterFailure'
+    $tryText = $tries[0].Extent.Text
+    Assert-CapCondition ($tryText -ceq $Binding.oldSource.tryText) 'old try exact raw text' 'AdapterFailure'
+    $commands = @($tries[0].FindAll({
+        param($node)
+        $node -is [Management.Automation.Language.CommandAst] -and $node.GetCommandName() -ceq 'Invoke-ScriptAnalyzer'
+    }, $true))
+    Assert-CapCondition ($commands.Count -eq 1) 'one old analyzer producer' 'AdapterFailure'
+    $start = $commands[0].Extent.StartOffset - $tries[0].Extent.StartOffset
+    $length = $commands[0].Extent.EndOffset - $commands[0].Extent.StartOffset
+    $replacement = '& $producer -Context $context -ErrorAction Stop -ErrorVariable +engineErrors'
+    Assert-CapCondition ($replacement -ceq $Binding.oldSource.replacement) 'fixed sole replacement' 'AdapterFailure'
+    $adapted = $tryText.Substring(0, $start) + $replacement + $tryText.Substring($start + $length)
+    $reversed = $adapted.Substring(0, $start) + $commands[0].Extent.Text +
+        $adapted.Substring($start + $replacement.Length)
+    Assert-CapCondition ([Convert]::ToBase64String($utf8.GetBytes($reversed)) -ceq
+        [Convert]::ToBase64String($utf8.GetBytes($tryText))) 'old adapter reverse bytes' 'AdapterFailure'
+    Assert-CapCondition ((Get-CapHash $utf8.GetBytes($adapted)) -ceq $Binding.oldSource.adaptedSha256) `
+        'adapted statement hash' 'AdapterFailure'
+    $null = Get-CapAst $adapted
+    return [scriptblock]::Create($adapted)
+}
+
+function Get-CapCandidateSlices {
+    param([hashtable]$Binding)
+    $bytes = [IO.File]::ReadAllBytes($Binding.collector.path)
+    Assert-CapCondition ((Get-CapHash $bytes) -ceq $Binding.collector.sha256) 'collector full bytes' 'AdapterFailure'
+    $utf8 = [Text.UTF8Encoding]::new($false, $true)
+    $bomLength = if ($bytes.Length -ge 3 -and $bytes[0] -eq 239 -and $bytes[1] -eq 187 -and $bytes[2] -eq 191) { 3 } else { 0 }
+    $text = $utf8.GetString($bytes, $bomLength, $bytes.Length - $bomLength)
+    $ast = Get-CapAst $text
+    Assert-CapCondition ((@($Binding.collector.slices | Where-Object kind -CEQ Function |
+        ForEach-Object name | Sort-Object) -join ',') -ceq
+        'Add-PssaCaptureRecord,Complete-PssaCapture,Invoke-PssaCapturePipeline') 'fixed private function set' 'AdapterFailure'
+    $functionTexts = [Collections.Generic.List[string]]::new()
+    $seed = $null
+    foreach ($slice in $Binding.collector.slices) {
+        if ($slice.kind -ceq 'Function') {
+            $matches = @($ast.FindAll({
+                param($node)
+                $node -is [Management.Automation.Language.FunctionDefinitionAst] -and $node.Name -ceq $slice.name
+            }, $true))
+        }
+        elseif ($slice.kind -ceq 'State') {
+            $matches = @($ast.FindAll({
+                param($node)
+                $node -is [Management.Automation.Language.AssignmentStatementAst] -and
+                $node.Left -is [Management.Automation.Language.VariableExpressionAst] -and
+                $node.Left.VariablePath.UserPath -ceq 'state'
+            }, $true))
+        }
+        else { throw 'AdapterFailure: unknown slice kind' }
+        Assert-CapCondition ($matches.Count -eq 1) ('unique original slice ' + $slice.name) 'AdapterFailure'
+        $extent = $matches[0].Extent
+        Assert-CapCondition ($extent.StartOffset -eq $slice.startOffset -and $extent.EndOffset -eq $slice.endOffset) `
+            ('raw span ' + $slice.name) 'AdapterFailure'
+        $raw = $utf8.GetBytes($extent.Text)
+        Assert-CapCondition ((Get-CapHash $raw) -ceq $slice.sha256) ('raw hash ' + $slice.name) 'AdapterFailure'
+        Assert-CapCondition ([Convert]::ToBase64String($raw) -ceq $slice.rawBase64) `
+            ('raw bytes ' + $slice.name) 'AdapterFailure'
+        $reverseText = $text.Substring(0, $extent.StartOffset) + $utf8.GetString($raw) + $text.Substring($extent.EndOffset)
+        $reverseBytes = [byte[]](@($bytes | Select-Object -First $bomLength) + $utf8.GetBytes($reverseText))
+        Assert-CapCondition ([Convert]::ToBase64String($reverseBytes) -ceq [Convert]::ToBase64String($bytes)) `
+            ('full reverse bytes ' + $slice.name) 'AdapterFailure'
+        $forbidden = @($matches[0].FindAll({
+            param($node)
+            $node -is [Management.Automation.Language.CommandAst] -and $node.GetCommandName() -in @(
+                'Invoke-ScriptAnalyzer', 'Import-Module', 'Start-Process', 'Get-Process', 'Stop-Process',
+                'Get-CimInstance', 'Add-Type', 'Invoke-Expression', 'Invoke-WebRequest', 'Invoke-RestMethod',
+                'Set-Content', 'Add-Content', 'Out-File', 'Remove-Item', 'New-Item', 'Invoke-Command'
+            )
+        }, $true))
+        Assert-CapCondition ($forbidden.Count -eq 0) ('unsafe command in slice ' + $slice.name) 'AdapterFailure'
+        if ($slice.kind -ceq 'State') { $seed = $extent.Text }
+        else { $functionTexts.Add($extent.Text) }
+    }
+    Assert-CapCondition ($functionTexts.Count -eq 3 -and $null -ne $seed) 'three functions and state seed' 'AdapterFailure'
+    return @{ functions = ($functionTexts -join "`n"); seed = [scriptblock]::Create($seed) }
+}
