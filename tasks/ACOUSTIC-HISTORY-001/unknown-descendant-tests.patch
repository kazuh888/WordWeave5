+   memory.files.get_mut(&self.0).unwrap().extend_from_slice(&bytes[..bytes.len().min(3)]);
+   return Err(io::Error::other("synthetic partial failure"));
+  }
+  memory.files.get_mut(&self.0).unwrap().extend_from_slice(bytes);
+  Ok(())
+ }
+ fn sync_all(&self)->io::Result<()> {
+  let mut memory=MEMORY.lock().unwrap();
+  memory.syncs+=1;
+  if matches!(memory.write_fault,WriteFault::Sync) { Err(io::Error::other("synthetic sync failure")) } else { Ok(()) }
+ }
+}
+fn memory_root()->PathBuf { PathBuf::from("SYNTHETIC_MEMORY_ONLY") }
+fn failure_path()->PathBuf { memory_root().join("target-7.failure.json") }
